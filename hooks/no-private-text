#!/usr/bin/env bash
# PreToolUse hook: GitHub text an agent is about to publish in a public repository
# gets a permission prompt when it holds a local path or a private name
# (lib/publish.sh). It looks at gh pr create, pr edit, pr comment, pr review, issue
# create, issue edit, issue comment and gh api writes: the command text, heredoc bodies
# included, and files named by --body-file, -F, --field or --notes-file, through a
# leading $NAME/ too. A cd it follows and the name of a file it reads are not published,
# so they are not looked at, except a name past a stop ($( or a heredoc it cannot read).
# Outside a gh command and before any $(, backtick or <<, a temp path that only locates
# a file is not looked at either: a redirect target, a sed -i file, a file flag's value,
# or an assignment whose variable is used only there.
# Each gh command's target is the repository it names, else the checkout of the folder
# it runs in. A word that is exactly cd, first in a chain (at the start, or after ; or a
# newline) with one operand that is an existing folder, sets that folder; a relative
# operand joins onto the known one. Any other folder change leaves the folder unknown
# until such a cd to an absolute path, and a write in an unknown folder asks on a hit
# with no lookup. With several gh commands, it asks if any target is public.
# The prompt gives the category, never the match, and approving it clears a false
# alarm. This is a net for mistakes, not a security boundary: other routes exist. When
# it cannot read its input or its tools are missing, it stays out of the way.
# shellcheck disable=SC2016,SC2088 # ~/ and $HOME below are literal command text.
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
command -v gh >/dev/null 2>&1 || exit 0
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
[ "$tool" = Bash ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
case "$cmd" in *gh*) ;; *) exit 0 ;; esac

# gh api with a write method, or with fields, which gh sends as a POST unless the walk
# below finds a real GET.
gh_api='(^|[^[:alnum:]_.-])gh[[:space:]]+api([[:space:]]|$)'
api_write() {
  grep -Eq "$gh_api" <<<"$cmd" || return 1
  grep -Eiq '(^|[[:space:]])(-X|--method)[=[:space:]]*["'"'"']?(POST|PUT|PATCH|DELETE)' <<<"$cmd"
}
api_fields() {
  grep -Eq "$gh_api" <<<"$cmd" || return 1
  grep -Eq '(^|[[:space:]])(-f|-F|--field|--raw-field|--input)([=[:space:]]|$)' <<<"$cmd"
}
# Flags (and an unquoted value each) may sit around "pr": gh -R o/r pr comment.
flags='([[:space:]]+-[^[:space:]]+([[:space:]]+[^-[:space:]"'"'"'][^[:space:]"'"'"']*)?)*'
forms="(^|[^[:alnum:]_.-])gh${flags}[[:space:]]+(pr${flags}[[:space:]]+(create|edit|comment|review)|issue${flags}[[:space:]]+(create|edit|comment))([[:space:]]|\$)"
fields_only=""
if ! grep -Eq "$forms" <<<"$cmd" && ! api_write; then
  api_fields || exit 0
  fields_only=1
fi

# shellcheck source=/dev/null
. "$(dirname "$0")/../lib/publish.sh" || exit 0

cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
[ -z "$cwd" ] || cd "$cwd" 2>/dev/null || exit 0
# The folder the command is in at this point of the walk; empty when unknown.
dir=$PWD

# A word of the command with its quotes off, and ~/ or $HOME/ at its start expanded.
word='("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:];&|)]+)'
plain() {
  v=${1#[\"\']}; v=${v%[\"\']}
  case "$v" in '~/'*) v=$HOME/${v#\~/} ;; '$HOME/'*) v=$HOME/${v#\$HOME/} ;; esac
}

# cd_dir <operand>: sets $v, the folder a cd operand names, or returns 1 when it cannot
# tell: an option, a quote other than "...", a backslash, $( or a backtick, a variable
# other than a leading $HOME/, a glob, a relative path in an unknown folder, or no
# folder there. Only a leading ~/ (unquoted) or $HOME/ is expanded.
cd_dir() {
  local s=$1 q="" p=""
  case "$s" in "" | -* | *\'* | *'`'* | *\\*) return 1 ;; esac
  case "$s" in \"*\") s=${s:1:${#s}-2} q=1 ;; esac
  case "$s" in *\"*) return 1 ;; esac
  if [ -z "$q" ] && [ "${s#\~/}" != "$s" ]; then
    p=$HOME/ s=${s#\~/}
  elif [ "${s#\$HOME/}" != "$s" ]; then
    # Unquoted, a home folder with a space splits into two words.
    [ -n "$q" ] || case "$HOME" in *[[:space:]]*) return 1 ;; esac
    p=$HOME/ s=${s#\$HOME/}
  fi
  case "$s" in *'$'*) return 1 ;; esac
  [ -n "$q" ] || case "$s" in *[*?[\{]*) return 1 ;; esac
  s=$p$s
  case "$s" in /*) ;; *) [ -n "$dir" ] || return 1; s=$dir/$s ;; esac
  v=$(cd "$s" 2>/dev/null && pwd) && [ -n "$v" ]
}

# unquote <word>: sets $v, the word with its quotes and backslashes off.
unquote() {
  local s=$1 run c
  v=""
  while [ -n "$s" ]; do
    run=${s%%[\'\"\\]*}; v+=$run; s=${s:${#run}}
    [ -n "$s" ] || break
    c=${s:0:1}; s=${s:1}
    case "$c" in
      \') run=${s%%\'*}; v+=$run; s=${s:${#run}}; s=${s:1} ;;
      \")
        while [ -n "$s" ]; do
          run=${s%%[\"\\]*}; v+=$run; s=${s:${#run}}
          [ -n "$s" ] || break
          c=${s:0:1}; s=${s:1}
          [ "$c" != \" ] || break
          case "${s:0:1}" in [\$\`\"\\]) ;; *) v+=\\ ;; esac
          v+=${s:0:1}; s=${s:1}
        done
        ;;
      *) v+=${s:0:1}; s=${s:1} ;;
    esac
  done
}

# Assignments outside a gh command, in order: a_name, a_val, a_word (as written),
# a_plain (no $ or backtick in the value), a_block (a $( or backtick, so the walk
# cannot tell where the assignment ends), a_alone (the command only assigns, or is
# export) and a_temp (the value is a temp path).
a_name=() a_val=() a_word=() a_plain=() a_block=() a_alone=() a_temp=()
# lookup <name>: sets $val, the value $name has here: the latest plain value assigned
# alone, else TMPDIR or HOME from the environment. An assignment in front of another
# command lasts only for it. A value it cannot know returns 1.
lookup() {
  local k=${#a_name[@]}
  while [ "$k" -gt 0 ]; do
    k=$((k - 1))
    [ "${a_name[k]}" = "$1" ] || continue
    [ -z "${a_block[k]}" ] || return 1
    [ -n "${a_alone[k]}" ] || continue
    [ -n "${a_plain[k]}" ] || return 1
    val=${a_val[k]}
    return 0
  done
  case "$1" in TMPDIR) val=${TMPDIR:-} ;; HOME) val=${HOME:-} ;; *) return 1 ;; esac
  [ -n "$val" ]
}
# expand <path>: sets $v, the path with a leading ~/, $NAME/ or ${NAME}/ expanded.
expand() {
  local name rest
  v=$1
  case "$v" in
    '~/'*) v=$HOME/${v#\~/}; return ;;
    '${'*'}/'*) name=${v#??}; name=${name%%\}*}; rest=${v#*\}/} ;;
    '$'*/*) name=${v#?}; name=${name%%/*}; rest=${v#*/} ;;
    *) return ;;
  esac
  case "$name" in "" | [0-9]* | *[!A-Za-z0-9_]*) return ;; esac
  if [ -n "$late" ] && ! assigned_once "$name"; then return; fi
  if lookup "$name"; then v=$val/$rest; fi
}
# assigned_once <name>: the command text holds no NAME= for the name, or one that
# the walk saw.
assigned_once() {
  local k=0 seen=0 written
  written=$(awk -v n="$1" '{ s = $0; while (match(s, "(^|[^A-Za-z0-9_])" n "=")) { c++; s = substr(s, RSTART + RLENGTH) } }
    END { print c + 0 }' <<<"$cmd")
  while [ "$k" -lt "${#a_name[@]}" ]; do
    [ "${a_name[k]}" != "$1" ] || seen=$((seen + 1))
    k=$((k + 1))
  done
  [ "$written" -eq 0 ] || { [ "$written" -eq 1 ] && [ "$seen" -eq 1 ]; }
}

# is_temp <path>: the path is under /tmp, /private/tmp, /var/folders,
# /private/var/folders or TMPDIR, written out or as $TMPDIR/, with no .. segment.
is_temp() {
  local t=${TMPDIR:-}
  t=${t%/}
  case "/$1/" in */../*) return 1 ;; esac
  case "$1" in
    /tmp | /tmp/* | /private/tmp | /private/tmp/* | /var/folders | /var/folders/* | \
      /private/var/folders | /private/var/folders/* | '$TMPDIR/'* | '${TMPDIR}/'*) return 0 ;;
  esac
  [ -n "$t" ] && case "$1" in "$t" | "$t"/*) true ;; *) false ;; esac
}

# Reads the file a word names, if it is one, a relative name from the known folder, else
# the session's. gh api's -F or --field names it as field=@file.
files=""
read_file() {
  unquote "$1"
  expand "${v##*=@}"
  f=$v
  case "$f" in /* | "") ;; *) [ -z "$dir" ] || f=$dir/$f ;; esac
  { [ -f "$f" ] && [ -r "$f" ]; } || return 1
  files+=$'\n'$(cat "$f")
}
set_repo() { plain "$1"; [ -n "$repo" ] || repo=$v; }
set_method() { plain "$1"; case "$v" in [Gg][Ee][Tt]) is_get=1 ;; esac; }
keep() { kept+=$held$m; held=""; }
# Targets, one a line: r:<owner/name>, d:<folder> for that folder's checkout, or u: for
# an unknown folder.
add_target() { case "$targets" in *$'\n'"$1"$'\n'*) ;; *) targets+=$1$'\n' ;; esac; }
here() { if [ -n "$dir" ]; then add_target "d:$dir"; else add_target u:; fi; }
end_command() {
  local k=$o_first
  [ -z "$in_api" ] || [ -n "$is_get" ] || unread_api=1
  if [ -n "$in_gh" ]; then
    if [ -n "$repo" ]; then add_target "r:$repo"; else here; fi
  fi
  if [ -z "$o_cmd" ] || [ "$o_cmd" = export ]; then
    while [ "$k" -lt "${#a_name[@]}" ]; do a_alone[k]=1; k=$((k + 1)); done
  fi
  prev="" in_gh="" in_api="" api="" is_get="" next="" repo="" c_any=""
  o_cmd="" o_next="" o_first=${#a_name[@]} sed_i="" sed_script="" sed_amb="" sed_unk=""
}
# A cd first in a chain is held in cd_text with its operands until its command ends with
# $1: a separator, nl (a newline), end or stop. Followed, it sets the folder and leaves
# the text; otherwise the folder is unknown and the text stays.
cd_end() {
  [ -n "$cd_on" ] || return 0
  cd_on=""
  case "$1" in ';' | ';;' | '&&' | '||' | nl | end) ;; *) cd_n=0 ;; esac
  if [ "$cd_n" = 1 ] && cd_dir "$cd_arg"; then dir=$v; else kept+=$cd_text; dir=""; fi
  # A chain that goes on after the cd runs in the background if a & ends it.
  case "$1" in '&&' | '||') chain_cd=1 ;; esac
}
new_line() {
  kept+=$hd_text; hd_text=""
  cd_end nl
  end_command
  [ -n "$cont" ] || c_start=1
  # A newline inside a group does not end the outer chain.
  [ -n "$cont" ] || [ "$grp" -ne 0 ] || chain_cd=""
}
# parens <word>: sets n, the number of ( in the word outside quotes.
parens() {
  local s=$1 q='^([^"'"'"']*)("([^"\\]|\\.)*"|'"'"'[^'"'"']*'"'"')(.*)$'
  while [[ $s =~ $q ]]; do s=${BASH_REMATCH[1]}${BASH_REMATCH[4]}; done
  s=${s//[!(]/}; n=${#s}
}
# heredoc <word>: for an operator word starting with <<, takes the delimiter (from the
# word or the next one), holds the body up to the delimiter line in hd_text, and leaves
# the rest of the opening line, then the text after the delimiter line, in rest. Returns
# 1 for a form it cannot read: <<<, a concatenated delimiter, another << on the line, a
# line continuation, or no delimiter line.
heredoc() {
  local op=${1#"${1%%<*}"} d t="" line s k body
  op=${op#<<}
  case "$op" in '<'*) return 1 ;; -*) t=1 op=${op#-} ;; esac
  if [ -z "$op" ]; then
    [[ $rest =~ $next_re ]] || return 1
    m+=${BASH_REMATCH[0]}; rest=${rest:${#BASH_REMATCH[0]}}; op=${BASH_REMATCH[1]}
  fi
  case "$op" in
    \'*\') d=${op:1:${#op}-2}; case "$d" in *\'*) return 1 ;; esac ;;
    \"*\") d=${op:1:${#op}-2}; case "$d" in *[\"\\\$\`]*) return 1 ;; esac ;;
    *[!A-Za-z0-9_.-]*) return 1 ;;
    *) d=$op ;;
  esac
  [ -n "$d" ] || return 1
  line=${rest%%$'\n'*}
  [ "$line" != "$rest" ] || return 1
  case "$line" in *'<<'* | *\\) return 1 ;; esac
  s=${rest#*$'\n'}
  k=$(D=$d T=$t awk '{ l = $0; if (ENVIRON["T"] != "") sub(/^\t+/, "", l); if (l == ENVIRON["D"]) { print NR; exit } }' <<<"$s")
  [ -n "$k" ] || return 1
  body=$(head -n "$((k - 1))" <<<"$s")
  s=$(tail -n "+$((k + 1))" <<<"$s")
  kept+=$held$m; held=""
  hd_text+=$'\n'$body
  rest=$line$'\n'$s
  # As with $(, the walk cannot tell what the body runs, so no later word locates a file.
  subst=1
}

# located holds each word that locates a file, so an assignment's uses can be matched
# against it. A word with $( or a backtick runs something, so it locates nothing, and
# from the first such word outside gh on ($subst) no word locates a file.
located=""
note_located() {
  [ -z "$subst" ] || return 0
  case "$1" in *'$('* | *'`'*) ;; *) located+=$'\n'$1 ;; esac
}
# locate <word> <path part>: keeps the word, unless it is outside a gh command and
# its path is a temp path.
locate() {
  note_located "$2"
  unquote "$2"
  if [ -z "$in_gh" ] && [ -z "$subst" ] && is_temp "$v"; then
    kept+="$held "; held=""
  else
    keep
  fi
}
# An assignment whose value is a temp path is held at a mark in kept until the end.
mark=$'\037'
assign_re='^[A-Za-z_][A-Za-z0-9_]*='
assign() {
  local k=${#a_name[@]}
  unquote "${1#*=}"
  a_name[k]=${1%%=*} a_val[k]=$v a_word[k]=$1 a_alone[k]="" a_temp[k]=""
  case "$v" in *'$'* | *'`'*) a_plain[k]="" ;; *) a_plain[k]=1 ;; esac
  case "$v" in *'$('* | *'`'*) a_block[k]=1 ;; *) a_block[k]="" ;; esac
  if [ -z "$subst" ] && is_temp "$v"; then
    a_temp[k]=1
    kept+=$held${m%"$1"}$mark$k$mark; held=""
  else
    keep
  fi
}
# sed_word <word>: a word of a sed command. After -i, an empty word or one starting
# with . is the suffix; the first word that is no option is the script, unless -e or -f
# gave it, and the words after it are files. After -i and another word ($sed_amb), the
# next one may be the script, so it locates nothing. After an option it does not know
# ($sed_unk), no word of the command locates a file.
sed_word() {
  unquote "$1"
  case "$v" in
    -i) sed_i=1 o_next=sedi ;;
    -i* | --in-place | --in-place=*) sed_i=1 ;;
    -e | -f | --expression | --file) o_next=sedarg ;;
    -e* | -f* | --expression=* | --file=*) sed_script=1 ;;
    -[Ernsuz] | --regexp-extended | --quiet | --silent | --null-data | --separate | --unbuffered) ;;
    -*) sed_unk=1 ;;
    *)
      if [ -z "$sed_script" ]; then
        sed_script=1
      elif [ -n "$sed_amb" ]; then
        sed_amb=""
      elif [ -n "$sed_i" ] && [ -z "$sed_unk" ]; then
        locate "$1" "$1"
        return
      fi
      ;;
  esac
  keep
}
# outside <word>: a word outside a gh command. It is checked unless it only locates a
# temp file; an assignment with a temp value waits for the end.
outside() {
  local w=$1 p
  case "$w" in *'$('* | *'`'*) subst=1 ;; esac
  case "$o_next" in
    redir) o_next=""; locate "$w" "$w"; return ;;
    file) o_next=""; read_file "$w"; locate "$w" "$w"; return ;;
    field) o_next=""; read_file "$w"; case "$w" in *=@*) locate "$w" "${w#*=@}" ;; *) keep ;; esac; return ;;
    sedarg) o_next="" sed_script=1; keep; return ;;
    sedi)
      o_next=""
      unquote "$w"
      case "$v" in
        "" | .*) keep; return ;;
        -*) ;;
        *) [ -n "$sed_script" ] || sed_amb=1 ;;
      esac
      ;;
  esac
  case "$w" in
    '>' | '>>' | [0-9]'>' | [0-9]'>>') o_next=redir; keep; return ;;
    '>'* | [0-9]'>'*) p=${w#[0-9]}; p=${p#>}; p=${p#>}; locate "$w" "$p"; return ;;
  esac
  if [ -z "$o_cmd" ] || [ "$o_cmd" = export ]; then
    # A ( or { opening a group comes before the command's first word.
    p=$w
    while :; do case "$p" in "("* | "{"*) p=${p#?} ;; *) break ;; esac; done
    [ -n "$p" ] || { keep; return; }
    if [[ $p =~ $assign_re ]]; then assign "$p"; return; fi
    [ -n "$o_cmd" ] || { o_cmd=$w; keep; return; }
  fi
  case "$o_cmd" in sed | */sed | gsed) sed_word "$w"; return ;; esac
  case "$w" in
    --body-file | --notes-file) o_next="file" ;;
    -F | --field) o_next=field ;;
    --body-file=* | --notes-file=*) read_file "${w#*=}"; locate "$w" "${w#*=}"; return ;;
    -F=*=@* | --field=*=@*) p=${w#*=}; read_file "$p"; locate "$w" "${p#*=@}"; return ;;
    -F=* | --field=*) read_file "${w#*=}" ;;
  esac
  keep
}

# A walk over gh's real arguments, never a body: each command's target (the first it
# names, else the folder it runs in), a GET for each gh api command, and the files it
# reads, which replace their names in the checked text. It follows each cd, and steps
# over heredoc bodies and # comments without walking them. Words cannot be told apart
# past a stop ($( in gh, or a << it cannot read); that text goes to past, with any word
# outside a gh command. grp counts open ( and { groups; c_start marks the start of a
# chain, c_any a word already in the command, cont a line that goes on after && || |,
# chain_cd a cd followed earlier in the chain.
repo="" targets=$'\n' unread_api="" kept="" past="" held="" hd_text=""
o_cmd="" o_next="" o_first=0 sed_i="" sed_script="" sed_amb="" sed_unk="" subst="" late=""
cd_on="" cd_text="" cd_n=0 cd_arg="" chain_cd="" grp=0 c_start=1 c_any="" cont="" lastw=""
arg='([^[:space:]"'"'"'\\;&|)]|\\.|"([^"\\]|\\.)*"|'"'"'[^'"'"']*'"'"')+'
re="^[[:space:]]*($arg|[;&|)]+)"
next_re="^[[:blank:]]*($arg)"
api_re='^/?repos/([[:alnum:]._-]+/[[:alnum:]._-]+)'
rest=$cmd prev="" in_gh="" in_api="" api="" is_get="" next=""
while [[ $rest =~ $re ]]; do
  m=${BASH_REMATCH[0]} w=${BASH_REMATCH[1]}
  rest=${rest:${#m}}
  pw=$lastw lastw=$w
  # A newline before any token ends the command first.
  case "${m%"$w"}" in *$'\n'*) new_line ;; esac
  [ "$w" != $'\\\n' ] || { held+=$m; continue; }
  # A & in a redirect (2>&1, >&2, <&3, &>file, &>>file) belongs to that redirect.
  if [ "$w" = '&' ]; then
    case "$m$pw" in '&'*'>' | '&'*'<') keep; continue ;; esac
    case "$rest" in '>'*) keep; continue ;; esac
  fi
  case "$w" in
    '#'*) v=${rest%%$'\n'*}; kept+=$held$m$v; held=""; rest=${rest:${#v}}; continue ;;
    '<<'* | [0-9]'<<'*) if heredoc "$w"; then continue; fi; rest=$m$rest; break ;;
    *'<<'*) rest=$m$rest; break ;;
    [\;\&\|\)]*)
      # A token may join closing parens to operators, as in )&, ); or ;)&. The operator
      # after the last ) acts at the depth left; only one at the outer depth ends or
      # backgrounds the outer chain.
      v=${w//[!)]/}; grp=$((grp - ${#v})); [ "$grp" -ge 0 ] || grp=0
      op=${w##*)}
      cd_end "$op"; end_command; keep
      if [ "$grp" -eq 0 ]; then
        case "$op" in '&') [ -z "$chain_cd" ] || dir="" ;; esac
        case "$op" in *';' | '&') chain_cd="" ;; esac
      fi
      case "$op" in *';') c_start=1 ;; *) c_start="" ;; esac
      case "$op" in '&&' | '||' | '|' | '|&') cont=1 ;; *) cont="" ;; esac
      continue
      ;;
  esac
  case "$w" in *'('*) parens "$w"; grp=$((grp + n)) ;; esac
  prior=$c_any c_any=1 cont=""
  if [ -z "$in_gh" ]; then
    if [ -n "$cd_on" ]; then cd_text+=$m; past+=$m; cd_n=$((cd_n + 1)); cd_arg=$w; continue; fi
    if [ "$w" = cd ] && [ -z "$prior" ] && [ -n "$c_start" ] && [ "$grp" -eq 0 ]; then
      cd_on=1 cd_text=$held$m cd_n=0 cd_arg="" o_cmd=cd held=""; past+=$m; continue
    fi
    if [ -z "$o_cmd" ]; then
      case "$w" in
        '}') grp=$((grp - 1)); [ "$grp" -ge 0 ] || grp=0 ;;
        '{'* | '('*) v=${w%%[!({]*}; v=${v//[!\{]/}; grp=$((grp + ${#v})) ;;
      esac
    fi
    # Any other folder change leaves the folder unknown.
    v=$w
    while :; do case "$v" in "("* | "{"*) v=${v#?} ;; *) break ;; esac; done
    case "$v" in cd | pushd | popd) dir="" ;; esac
    if [ "$w" != gh ]; then past+=$m; outside "$w"; continue; fi
  fi
  case "$w" in *'$('*) rest=$m$rest; break ;; esac
  in_gh=1 o_cmd=${o_cmd:-gh}
  value=$next next=""
  case "$value" in
    repo) set_repo "$w"; keep; continue ;;
    method) set_method "$w"; keep; continue ;;
    file | field)
      if [ "$value" = file ]; then note_located "$w"; else case "$w" in *=@*) note_located "${w#*=@}" ;; esac; fi
      if read_file "$w"; then held=""; else keep; fi
      continue
      ;;
    redir) note_located "$w"; keep; continue ;;
  esac
  case "$w" in
    -R | --repo) next=repo ;;
    --repo=* | -R=*) set_repo "${w#*=}" ;;
    -X | --method) next=method ;;
    -X* | --method=*) v=${w#--method=}; v=${v#-X}; set_method "${v#=}" ;;
    --body-file | --notes-file) next="file"; held+=$m; continue ;;
    --field | -F) next=field; held+=$m; continue ;;
    '>' | '>>' | [0-9]'>' | [0-9]'>>') next=redir ;;
    '>'* | [0-9]'>'*) v=${w#[0-9]}; v=${v#>}; note_located "${v#>}" ;;
    --body-file=* | --notes-file=*) note_located "${w#*=}"; if read_file "${w#*=}"; then continue; fi ;;
    --field=* | -F=*)
      v=${w#*=}
      case "$v" in *=@*) note_located "${v#*=@}" ;; esac
      if read_file "${w#*=}"; then continue; fi
      ;;
  esac
  keep
  if [ "$prev" = gh ] && [ "$w" = api ]; then in_api=1 api=1; fi
  prev=$w
  [ -n "$api" ] || continue
  # gh api's path, up to the end of that command. A path with placeholders is the checkout's.
  plain "$w"
  case "$v" in
    repos/* | /repos/*)
      api=""
      if [ -z "$repo" ] && [[ $v =~ $api_re ]]; then repo=${BASH_REMATCH[1]}; fi
      ;;
  esac
done
# Past a stop, a write runs in the folder known there, unknown if a cd or a background &
# (not && or a redirect such as 2>&1 or &>) may come first; files past it are still read
# from the folder known there. A ) there cannot change it: a cd in a group already
# leaves the folder unknown.
stopped=""
case "$rest" in *[![:space:]]*) stopped=1 ;; esac
if [ -n "$stopped" ]; then cd_end stop; else cd_end end; fi
end_command
kept+=$held$hd_text$rest past+=$rest
stop_dir=$dir
if [ -n "$stopped" ]; then
  if grep -Eq '(^|[^[:alnum:]_.-])(cd|pushd|popd)([[:space:]]|$)' <<<"$rest" ||
    grep -Eq '(^|[^&<>|])&([^&>]|$)' <<<"$rest"; then
    dir=""
  fi
  ! grep -Eq -e "$forms" -e "$gh_api" <<<"$rest" || here
fi
[ "$targets" != $'\n' ] || here
dir=$stop_dir

# uses <name> <text>: prints how often $name or ${name...} appears in the text.
uses() {
  awk -v n="$1" 'BEGIN { re = "[$]([{][#!]?)?" n }
    { s = $0; while (match(s, re)) { s = substr(s, RSTART + RLENGTH); if (substr(s, 1, 1) !~ /[A-Za-z0-9_]/) k++ } }
    END { print k + 0 }' <<<"$2"
}
# A temp value assigned alone leaves the text when every use of its name, and at
# least one, locates a file; otherwise the assignment goes back where it was.
k=0
while [ "$k" -lt "${#a_name[@]}" ]; do
  if [ -n "${a_temp[k]}" ]; then
    put=${a_word[k]}
    if [ -n "${a_alone[k]}" ]; then
      n=$(uses "${a_name[k]}" "$cmd")
      [ "$n" -eq 0 ] || [ "$n" != "$(uses "${a_name[k]}" "$located")" ] || put=" "
    fi
    kept=${kept%%"$mark$k$mark"*}$put${kept#*"$mark$k$mark"}
  fi
  k=$((k + 1))
done

# Fields go out as a POST unless each gh api command has a real GET.
if [ -n "$fields_only" ] && [ -z "$unread_api" ] && ! grep -Eq "$gh_api" <<<"$past"; then exit 0; fi

# A real flag may sit in past: its file is read too, and nothing leaves the text. A
# flag outside gh was read where it stood; read here, a name assigned more than once,
# or where the walk did not reach, could name another file, so it is not expanded.
late=1
re="(--body-file|--notes-file|--field|-F)(=|[[:space:]]+)$word"
while IFS= read -r flag; do
  if [[ $flag =~ $re ]]; then read_file "${BASH_REMATCH[3]}"; fi
done <<<"$(grep -Eo -- "(^|[[:space:]])$re" <<<"$past")"

# A hit asks if any target is public. A folder's checkout is looked up from that folder,
# and one the lookup cannot enter counts as public; an unknown folder asks before any
# lookup.
text=$kept$files
hit=$(private_text "$text") || exit 0
public=""
case "$targets" in *$'\n'u:$'\n'*) public=1 ;; esac
targets=${targets#$'\n'}
[ -n "$public" ] || while IFS= read -r t; do
  case "$t" in
    r:*) publish_hit "$text" "${t#r:}" >/dev/null && public=1 ;;
    d:*) (cd "${t#d:}" 2>/dev/null || exit 0; publish_hit "$text" "" >/dev/null) && public=1 ;;
  esac
  [ -z "$public" ] || break
done <<<"${targets%$'\n'}"
[ -n "$public" ] || exit 0
jq -n --arg r "Mentat: this text for a public repository holds $hit. Approve only if it is meant to be public." \
  '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
exit 0

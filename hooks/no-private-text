#!/usr/bin/env bash
# PreToolUse hook: GitHub text an agent is about to publish in a public repository
# gets a permission prompt when it holds a local path or a private name
# (lib/publish.sh). It looks at gh pr create, pr edit, pr comment, pr review, issue
# create, issue edit, issue comment and gh api writes: the command text, and files
# named by --body-file, -F, --field or --notes-file, through a leading $NAME/ too. A
# leading cd and the name of a file it reads are not published, so they are not looked
# at, except a name past $( or <<. Outside a gh command and before any $(, backtick or
# <<, a temp path that only locates a file is not looked at either: a redirect target, a
# sed -i file, a file flag's value, or an assignment whose variable is used only there.
# With several gh commands, it asks if any target is public.
# The prompt gives the category, never the match, and approving it clears a false
# alarm. This is a net for mistakes, not a security boundary: other routes exist. When
# it cannot read its input or its tools are missing, it stays out of the way.
# shellcheck disable=SC2016,SC2088 # ~/ and $HOME below are literal command text.
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
command -v gh >/dev/null 2>&1 || exit 0
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
[ "$tool" = Bash ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
case "$cmd" in *gh*) ;; *) exit 0 ;; esac

# gh api with a write method, or with fields, which gh sends as a POST unless the walk
# below finds a real GET.
gh_api='(^|[^[:alnum:]_.-])gh[[:space:]]+api([[:space:]]|$)'
api_write() {
  grep -Eq "$gh_api" <<<"$cmd" || return 1
  grep -Eiq '(^|[[:space:]])(-X|--method)[=[:space:]]*["'"'"']?(POST|PUT|PATCH|DELETE)' <<<"$cmd"
}
api_fields() {
  grep -Eq "$gh_api" <<<"$cmd" || return 1
  grep -Eq '(^|[[:space:]])(-f|-F|--field|--raw-field|--input)([=[:space:]]|$)' <<<"$cmd"
}
# Flags (and an unquoted value each) may sit around "pr": gh -R o/r pr comment.
flags='([[:space:]]+-[^[:space:]]+([[:space:]]+[^-[:space:]"'"'"'][^[:space:]"'"'"']*)?)*'
forms="(^|[^[:alnum:]_.-])gh${flags}[[:space:]]+(pr${flags}[[:space:]]+(create|edit|comment|review)|issue${flags}[[:space:]]+(create|edit|comment))([[:space:]]|\$)"
fields_only=""
if ! grep -Eq "$forms" <<<"$cmd" && ! api_write; then
  api_fields || exit 0
  fields_only=1
fi

# shellcheck source=/dev/null
. "$(dirname "$0")/../lib/publish.sh" || exit 0

cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
[ -z "$cwd" ] || cd "$cwd" 2>/dev/null || exit 0

# A word of the command with its quotes off, and ~/ or $HOME/ at its start expanded.
word='("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:];&|)]+)'
plain() {
  v=${1#[\"\']}; v=${v%[\"\']}
  case "$v" in '~/'*) v=$HOME/${v#\~/} ;; '$HOME/'*) v=$HOME/${v#\$HOME/} ;; esac
}

text=$cmd
re="^[[:space:]]*cd[[:space:]]+${word}[[:space:]]*(&&|;)"
if [[ $text =~ $re ]]; then
  text=${text#"${BASH_REMATCH[0]}"}
  plain "${BASH_REMATCH[1]}"
  cd "$v" 2>/dev/null || true
fi

# unquote <word>: sets $v, the word with its quotes and backslashes off.
unquote() {
  local s=$1 run c
  v=""
  while [ -n "$s" ]; do
    run=${s%%[\'\"\\]*}; v+=$run; s=${s:${#run}}
    [ -n "$s" ] || break
    c=${s:0:1}; s=${s:1}
    case "$c" in
      \') run=${s%%\'*}; v+=$run; s=${s:${#run}}; s=${s:1} ;;
      \")
        while [ -n "$s" ]; do
          run=${s%%[\"\\]*}; v+=$run; s=${s:${#run}}
          [ -n "$s" ] || break
          c=${s:0:1}; s=${s:1}
          [ "$c" != \" ] || break
          case "${s:0:1}" in [\$\`\"\\]) ;; *) v+=\\ ;; esac
          v+=${s:0:1}; s=${s:1}
        done
        ;;
      *) v+=${s:0:1}; s=${s:1} ;;
    esac
  done
}

# Assignments outside a gh command, in order: a_name, a_val, a_word (as written),
# a_plain (no $ or backtick in the value), a_alone (the command only assigns, or is
# export) and a_temp (the value is a temp path).
a_name=() a_val=() a_word=() a_plain=() a_alone=() a_temp=()
# lookup <name>: sets $val, the value $name has here: the latest plain value assigned
# alone, else TMPDIR or HOME from the environment. A value it cannot know returns 1.
lookup() {
  local k=${#a_name[@]}
  while [ "$k" -gt 0 ]; do
    k=$((k - 1))
    [ "${a_name[k]}" = "$1" ] || continue
    [ -n "${a_plain[k]}" ] || return 1
    [ -n "${a_alone[k]}" ] || continue
    val=${a_val[k]}
    return 0
  done
  case "$1" in TMPDIR) val=${TMPDIR:-} ;; HOME) val=${HOME:-} ;; *) return 1 ;; esac
  [ -n "$val" ]
}
# expand <path>: sets $v, the path with a leading ~/, $NAME/ or ${NAME}/ expanded.
expand() {
  local name rest
  v=$1
  case "$v" in
    '~/'*) v=$HOME/${v#\~/}; return ;;
    '${'*'}/'*) name=${v#??}; name=${name%%\}*}; rest=${v#*\}/} ;;
    '$'*/*) name=${v#?}; name=${name%%/*}; rest=${v#*/} ;;
    *) return ;;
  esac
  case "$name" in "" | [0-9]* | *[!A-Za-z0-9_]*) return ;; esac
  if [ -n "$late" ] && ! assigned_once "$name"; then return; fi
  if lookup "$name"; then v=$val/$rest; fi
}
# assigned_once <name>: the command text holds no NAME= for the name, or one that
# the walk saw.
assigned_once() {
  local k=0 seen=0 written
  written=$(awk -v n="$1" '{ s = $0; while (match(s, "(^|[^A-Za-z0-9_])" n "=")) { c++; s = substr(s, RSTART + RLENGTH) } }
    END { print c + 0 }' <<<"$cmd")
  while [ "$k" -lt "${#a_name[@]}" ]; do
    [ "${a_name[k]}" != "$1" ] || seen=$((seen + 1))
    k=$((k + 1))
  done
  [ "$written" -eq 0 ] || { [ "$written" -eq 1 ] && [ "$seen" -eq 1 ]; }
}

# is_temp <path>: the path is under /tmp, /private/tmp, /var/folders,
# /private/var/folders or TMPDIR, written out or as $TMPDIR/, with no .. segment.
is_temp() {
  local t=${TMPDIR:-}
  t=${t%/}
  case "/$1/" in */../*) return 1 ;; esac
  case "$1" in
    /tmp | /tmp/* | /private/tmp | /private/tmp/* | /var/folders | /var/folders/* | \
      /private/var/folders | /private/var/folders/* | '$TMPDIR/'* | '${TMPDIR}/'*) return 0 ;;
  esac
  [ -n "$t" ] && case "$1" in "$t" | "$t"/*) true ;; *) false ;; esac
}

# Reads the file a word names, if it is one. gh api's -F or --field names it as field=@file.
files=""
read_file() {
  unquote "$1"
  expand "${v##*=@}"
  f=$v
  { [ -f "$f" ] && [ -r "$f" ]; } || return 1
  files+=$'\n'$(cat "$f")
}
set_repo() { plain "$1"; [ -n "$repo" ] || repo=$v; }
set_method() { plain "$1"; case "$v" in [Gg][Ee][Tt]) is_get=1 ;; esac; }
keep() { kept+=$held$m; held=""; }
end_command() {
  local k=$o_first
  [ -z "$in_api" ] || [ -n "$is_get" ] || unread_api=1
  if [ -n "$in_gh" ]; then
    case "$targets" in *$'\n'"$repo"$'\n'*) ;; *) targets+=$repo$'\n' ;; esac
  fi
  if [ -z "$o_cmd" ] || [ "$o_cmd" = export ]; then
    while [ "$k" -lt "${#a_name[@]}" ]; do a_alone[k]=1; k=$((k + 1)); done
  fi
  prev="" in_gh="" in_api="" api="" is_get="" next="" repo=""
  o_cmd="" o_next="" o_first=${#a_name[@]} sed_i="" sed_script="" sed_amb="" sed_unk=""
}

# located holds each word that locates a file, so an assignment's uses can be matched
# against it. A word with $( or a backtick runs something, so it locates nothing, and
# from the first such word outside gh on ($subst) no word locates a file.
located=""
note_located() {
  [ -z "$subst" ] || return 0
  case "$1" in *'$('* | *'`'*) ;; *) located+=$'\n'$1 ;; esac
}
# locate <word> <path part>: keeps the word, unless it is outside a gh command and
# its path is a temp path.
locate() {
  note_located "$2"
  unquote "$2"
  if [ -z "$in_gh" ] && [ -z "$subst" ] && is_temp "$v"; then
    kept+="$held "; held=""
  else
    keep
  fi
}
# An assignment whose value is a temp path is held at a mark in kept until the end.
mark=$'\037'
assign_re='^[A-Za-z_][A-Za-z0-9_]*='
assign() {
  local k=${#a_name[@]}
  unquote "${1#*=}"
  a_name[k]=${1%%=*} a_val[k]=$v a_word[k]=$1 a_alone[k]="" a_temp[k]=""
  case "$v" in *'$'* | *'`'*) a_plain[k]="" ;; *) a_plain[k]=1 ;; esac
  if [ -z "$subst" ] && is_temp "$v"; then
    a_temp[k]=1
    kept+=$held${m%"$1"}$mark$k$mark; held=""
  else
    keep
  fi
}
# sed_word <word>: a word of a sed command. After -i, an empty word or one starting
# with . is the suffix; the first word that is no option is the script, unless -e or -f
# gave it, and the words after it are files. After -i and another word ($sed_amb), the
# next one may be the script, so it locates nothing. After an option it does not know
# ($sed_unk), no word of the command locates a file.
sed_word() {
  unquote "$1"
  case "$v" in
    -i) sed_i=1 o_next=sedi ;;
    -i* | --in-place | --in-place=*) sed_i=1 ;;
    -e | -f | --expression | --file) o_next=sedarg ;;
    -e* | -f* | --expression=* | --file=*) sed_script=1 ;;
    -[Ernsuz] | --regexp-extended | --quiet | --silent | --null-data | --separate | --unbuffered) ;;
    -*) sed_unk=1 ;;
    *)
      if [ -z "$sed_script" ]; then
        sed_script=1
      elif [ -n "$sed_amb" ]; then
        sed_amb=""
      elif [ -n "$sed_i" ] && [ -z "$sed_unk" ]; then
        locate "$1" "$1"
        return
      fi
      ;;
  esac
  keep
}
# outside <word>: a word outside a gh command. It is checked unless it only locates a
# temp file; an assignment with a temp value waits for the end.
outside() {
  local w=$1 p
  case "$w" in *'$('* | *'`'*) subst=1 ;; esac
  case "$o_next" in
    redir) o_next=""; locate "$w" "$w"; return ;;
    file) o_next=""; read_file "$w"; locate "$w" "$w"; return ;;
    field) o_next=""; read_file "$w"; case "$w" in *=@*) locate "$w" "${w#*=@}" ;; *) keep ;; esac; return ;;
    sedarg) o_next="" sed_script=1; keep; return ;;
    sedi)
      o_next=""
      unquote "$w"
      case "$v" in
        "" | .*) keep; return ;;
        -*) ;;
        *) [ -n "$sed_script" ] || sed_amb=1 ;;
      esac
      ;;
  esac
  case "$w" in
    '>' | '>>' | [0-9]'>' | [0-9]'>>') o_next=redir; keep; return ;;
    '>'* | [0-9]'>'*) p=${w#[0-9]}; p=${p#>}; p=${p#>}; locate "$w" "$p"; return ;;
  esac
  if [ -z "$o_cmd" ] || [ "$o_cmd" = export ]; then
    if [[ $w =~ $assign_re ]]; then assign "$w"; return; fi
    [ -n "$o_cmd" ] || { o_cmd=$w; keep; return; }
  fi
  case "$o_cmd" in sed | */sed | gsed) sed_word "$w"; return ;; esac
  case "$w" in
    --body-file | --notes-file) o_next="file" ;;
    -F | --field) o_next=field ;;
    --body-file=* | --notes-file=*) read_file "${w#*=}"; locate "$w" "${w#*=}"; return ;;
    -F=*=@* | --field=*=@*) p=${w#*=}; read_file "$p"; locate "$w" "${p#*=@}"; return ;;
    -F=* | --field=*) read_file "${w#*=}" ;;
  esac
  keep
}

# A walk over gh's real arguments, never a body: each command's target (the first it
# names; empty is the checkout's), a GET for each gh api command, and the files it
# reads, which replace their names in the checked text. Words cannot be told apart past
# $( or <<, or a << before gh; that text goes to past, with any word outside a gh command.
repo="" targets=$'\n' unread_api="" kept="" past="" held=""
o_cmd="" o_next="" o_first=0 sed_i="" sed_script="" sed_amb="" sed_unk="" subst="" late=""
arg='([^[:space:]"'"'"'\\;&|)]|\\.|"([^"\\]|\\.)*"|'"'"'[^'"'"']*'"'"')+'
re="^[[:space:]]*($arg|[;&|)]+)"
api_re='^/?repos/([[:alnum:]._-]+/[[:alnum:]._-]+)'
rest=$text prev="" in_gh="" in_api="" api="" is_get="" next=""
while [[ $rest =~ $re ]]; do
  m=${BASH_REMATCH[0]} w=${BASH_REMATCH[1]}
  rest=${rest:${#m}}
  case "$w" in
    $'\\\n') held+=$m; continue ;;
    *'<<'*) rest=$m$rest; break ;;
  esac
  case "${m%"$w"}" in *$'\n'*) end_command ;; esac
  case "$w" in [\;\&\|\)]*) end_command; keep; continue ;; esac
  if [ -z "$in_gh" ] && [ "$w" != gh ]; then past+=$m; outside "$w"; continue; fi
  case "$w" in *'$('*) rest=$m$rest; break ;; esac
  in_gh=1 o_cmd=${o_cmd:-gh}
  value=$next next=""
  case "$value" in
    repo) set_repo "$w"; keep; continue ;;
    method) set_method "$w"; keep; continue ;;
    file | field)
      if [ "$value" = file ]; then note_located "$w"; else case "$w" in *=@*) note_located "${w#*=@}" ;; esac; fi
      if read_file "$w"; then held=""; else keep; fi
      continue
      ;;
    redir) note_located "$w"; keep; continue ;;
  esac
  case "$w" in
    -R | --repo) next=repo ;;
    --repo=* | -R=*) set_repo "${w#*=}" ;;
    -X | --method) next=method ;;
    -X* | --method=*) v=${w#--method=}; v=${v#-X}; set_method "${v#=}" ;;
    --body-file | --notes-file) next="file"; held+=$m; continue ;;
    --field | -F) next=field; held+=$m; continue ;;
    '>' | '>>' | [0-9]'>' | [0-9]'>>') next=redir ;;
    '>'* | [0-9]'>'*) v=${w#[0-9]}; v=${v#>}; note_located "${v#>}" ;;
    --body-file=* | --notes-file=*) note_located "${w#*=}"; if read_file "${w#*=}"; then continue; fi ;;
    --field=* | -F=*)
      v=${w#*=}
      case "$v" in *=@*) note_located "${v#*=@}" ;; esac
      if read_file "${w#*=}"; then continue; fi
      ;;
  esac
  keep
  if [ "$prev" = gh ] && [ "$w" = api ]; then in_api=1 api=1; fi
  prev=$w
  [ -n "$api" ] || continue
  # gh api's path, up to the end of that command. A path with placeholders is the checkout's.
  plain "$w"
  case "$v" in
    repos/* | /repos/*)
      api=""
      if [ -z "$repo" ] && [[ $v =~ $api_re ]]; then repo=${BASH_REMATCH[1]}; fi
      ;;
  esac
done
end_command
kept+=$held$rest past+=$rest

# uses <name> <text>: prints how often $name or ${name...} appears in the text.
uses() {
  awk -v n="$1" 'BEGIN { re = "[$]([{][#!]?)?" n }
    { s = $0; while (match(s, re)) { s = substr(s, RSTART + RLENGTH); if (substr(s, 1, 1) !~ /[A-Za-z0-9_]/) k++ } }
    END { print k + 0 }' <<<"$2"
}
# A temp value assigned alone leaves the text when every use of its name, and at
# least one, locates a file; otherwise the assignment goes back where it was.
k=0
while [ "$k" -lt "${#a_name[@]}" ]; do
  if [ -n "${a_temp[k]}" ]; then
    put=${a_word[k]}
    if [ -n "${a_alone[k]}" ]; then
      n=$(uses "${a_name[k]}" "$cmd")
      [ "$n" -eq 0 ] || [ "$n" != "$(uses "${a_name[k]}" "$located")" ] || put=" "
    fi
    kept=${kept%%"$mark$k$mark"*}$put${kept#*"$mark$k$mark"}
  fi
  k=$((k + 1))
done

# Fields go out as a POST unless each gh api command has a real GET.
if [ -n "$fields_only" ] && [ -z "$unread_api" ] && ! grep -Eq "$gh_api" <<<"$past"; then exit 0; fi

# A real flag may sit in past: its file is read too, and nothing leaves the text. A
# flag outside gh was read where it stood; read here, a name assigned more than once,
# or where the walk did not reach, could name another file, so it is not expanded.
late=1
re="(--body-file|--notes-file|--field|-F)(=|[[:space:]]+)$word"
while IFS= read -r flag; do
  if [[ $flag =~ $re ]]; then read_file "${BASH_REMATCH[3]}"; fi
done <<<"$(grep -Eo -- "(^|[[:space:]])$re" <<<"$past")"

# A hit asks if any target is public. With no gh command walked, the target is the checkout.
[ "$targets" != $'\n' ] || targets+=$'\n'
targets=${targets#$'\n'}
hit=""
while IFS= read -r t; do
  hit=$(publish_hit "$kept$files" "$t") && break
done <<<"${targets%$'\n'}"
[ -n "$hit" ] || exit 0
jq -n --arg r "Mentat: this text for a public repository holds $hit. Approve only if it is meant to be public." \
  '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
exit 0

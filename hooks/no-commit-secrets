#!/usr/bin/env bash
# PreToolUse hook: a git commit whose staged changes hold a likely secret gets a
# permission prompt. It pipes git diff --cached into gitleaks' stdin scan, with
# redaction, and reads only the rule and line of each finding from its JSON report;
# gitleaks' own output goes nowhere. A finding counts on an added line only, named
# by rule and file, never the match. A gitleaks error asks too, as a failed scan.
# Approving the prompt clears a false alarm; there is no ignore file. It scans the
# repository of a leading cd and of git -C, else the session's directory. A command
# that stages in the same call (git add before the commit, git commit -a, a commit
# naming paths) is scanned for what it would commit, built by replaying those steps
# in a scratch index and object store; one it cannot work out asks. Other staging
# forms (git add -p, git rm, git mv) keep the staged-only scan. This is a net for
# mistakes, not a security boundary: other routes exist. When it cannot read its
# input or gitleaks is missing, it stays out of the way.
# shellcheck disable=SC2016,SC2088 # ~/ and $HOME below are literal command text.
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0
command -v gitleaks >/dev/null 2>&1 || exit 0
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
[ "$tool" = Bash ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
case "$cmd" in *commit*) ;; *) exit 0 ;; esac
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
[ -n "$cwd" ] || cwd=$PWD

# A word of the command, and git with its flags (each with an optional value) before commit.
word='("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:];&|)"'"'"'-][^[:space:];&|)]*)'
re="(^|[^[:alnum:]_.-])git(([[:space:]]+-[^[:space:]]+([[:space:]]+$word)?)*)[[:space:]]+commit([[:space:]]|\$)"
[[ $cmd =~ $re ]] || exit 0
flags=${BASH_REMATCH[2]}
# The text before the commit's git, and from it on.
pre=${cmd%%"${BASH_REMATCH[0]}"*}${BASH_REMATCH[1]}
from=${cmd:${#pre}}

ask() {
  jq -n --arg r "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask",
    permissionDecisionReason: $r}}'
  exit 0
}
what="the staged changes"
failed() { ask "Mentat: the gitleaks scan of $what failed, so they were not checked for secrets. Approve only if you want to commit without the scan."; }
unsure() { ask "Mentat: the changes this command stages could not be worked out, so they were not checked for secrets. Approve only if you want to commit without the scan."; }

# lex <text> [1]: the shell words of <text> in T, quotes and escapes removed, and in
# K w for a word read for certain, u for one holding an expansion, s for a step
# separator. Redirections are dropped. With 1, a heredoc's body is skipped, at the
# top level and in $(...); without it a heredoc or here-string is lost. It stops
# with lost=1 where the text stops being plain words: a subshell, backtick, $'...'
# or unclosed quote. A ) that closes text before it ends the step first.
lex() {
  local s=$1 n=${#1} i=0 c d q w='' have=0 sure=1 drop=0 hok=${2:-0}
  T=() K=() HD=() HT=() lost=0
  while [ "$i" -lt "$n" ]; do
    c=${s:i:1}
    case "$c" in
      ' ' | $'\t') put ;;
      $'\n' | ';' | '|' | '&')
        put
        d=${s:i+1:1}
        if [ "$c" = '&' ] && [ "$d" = '>' ]; then
          drop=1 i=$((i + 1))
          [ "${s:i+1:1}" != '>' ] || i=$((i + 1))
        else
          drop=0 T+=("$c") K+=(s)
          case "$c$d" in '&&' | '||' | ';;' | '|&') i=$((i + 1)) ;; esac
        fi
        if [ "$c" = $'\n' ] && [ "${#HD[@]}" -gt 0 ]; then body $((i + 1)) || return; i=$hp; fi ;;
      '>' | '<')
        d=${s:i+1:1}
        case "$c$d" in '<(' | '>(') lost=1; return ;; '<<') [ "$hok" = 1 ] || { lost=1; return; } ;; esac
        if [ "$have" = 1 ] && [ -n "$w" ] && [ -z "${w//[0-9]/}" ]; then w='' have=0; else put; fi
        if [ "$c$d" = '<<' ] && [ "${s:i+2:1}" != '<' ]; then
          heredoc $((i + 2)) || return
          i=$((hp - 1))
        else
          case "$c$d" in '<<') i=$((i + 2)) ;; '>>' | '>&' | '>|' | '<&' | '<>') i=$((i + 1)) ;; esac
          drop=1
        fi ;;
      "'")
        q=${s:i+1}
        case "$q" in *"'"*) ;; *) lost=1; return ;; esac
        q=${q%%"'"*}
        w=$w$q have=1 i=$((i + ${#q} + 1)) ;;
      '"')
        have=1 i=$((i + 1))
        while :; do
          [ "$i" -lt "$n" ] || { lost=1; return; }
          c=${s:i:1}
          case "$c" in
            '"') break ;;
            \\)
              d=${s:i+1:1}
              case "$d" in
                '$' | '`' | '"' | \\) w=$w$d i=$((i + 1)) ;;
                $'\n') i=$((i + 1)) ;;
                *) w=$w$c ;;
              esac ;;
            '`') lost=1; return ;;
            '$') dollar || return ;;
            *) w=$w$c ;;
          esac
          i=$((i + 1))
        done ;;
      \\)
        d=${s:i+1:1} i=$((i + 1))
        case "$d" in '') lost=1; return ;; $'\n') ;; *) w=$w$d have=1 ;; esac ;;
      '$') have=1; dollar || return ;;
      '`' | '(') lost=1; return ;;
      ')') put; T+=("$c") K+=(s) lost=1; return ;;
      '#')
        if [ "$have" = 1 ]; then w=$w$c; else q=${s:i}; q=${q%%$'\n'*}; i=$((i + ${#q} - 1)); fi ;;
      '~')
        if [ "$have" = 0 ]; then
          case "${s:i+1:1}" in '/' | '' | ' ' | $'\t' | $'\n' | ';' | '&' | '|') w=$HOME have=1 ;; *) w=$w$c have=1 ;; esac
        else w=$w$c; fi ;;
      *) w=$w$c have=1 ;;
    esac
    i=$((i + 1))
  done
  put
}
# put: ends lex's word in progress.
put() {
  if [ "$have" = 1 ]; then
    if [ "$drop" = 1 ]; then drop=0; elif [ "$sure" = 1 ]; then T+=("$w") K+=(w); else T+=("$w") K+=(u); fi
  fi
  w='' have=0 sure=1
}
# dollar: reads lex's expansion at $i. $HOME is known; any other leaves the word
# unsure, and a $(...) is skipped whole. Returns 1 when lost.
dollar() {
  local r=${s:i+1} depth=0 j ch hn=${#HD[@]}
  case "$r" in
    '{HOME}'*) w=$w$HOME i=$((i + 6)); return 0 ;;
    HOME*) if [[ ${r:4:1} != [A-Za-z0-9_] ]]; then w=$w$HOME i=$((i + 4)); return 0; fi ;;
  esac
  sure=0 w=$w\$
  case "$r" in
    "'"*) lost=1; return 1 ;;
    '{'*)
      case "$r" in *'}'*) ;; *) lost=1; return 1 ;; esac
      r=${r%%'}'*}
      i=$((i + ${#r} + 1)) ;;
    '('*)
      j=$((i + 1))
      while :; do
        [ "$j" -lt "$n" ] || { lost=1; return 1; }
        ch=${s:j:1}
        case "$ch" in
          '(') depth=$((depth + 1)) ;;
          ')')
            depth=$((depth - 1))
            if [ "$depth" = 0 ]; then
              [ "${#HD[@]}" = "$hn" ] || { lost=1; return 1; }
              break
            fi ;;
          \\) j=$((j + 1)) ;;
          '`') lost=1; return 1 ;;
          '<')
            if [ "${s:j+1:1}" = '<' ]; then
              [ "$hok" = 1 ] || { lost=1; return 1; }
              if [ "${s:j+2:1}" = '<' ]; then j=$((j + 2))
              else heredoc $((j + 2)) || return 1; j=$((hp - 1)); fi
            fi ;;
          $'\n') [ "${#HD[@]}" = 0 ] || { body $((j + 1)) || return 1; j=$hp; } ;;
          "'")
            r=${s:j+1}
            case "$r" in *"'"*) ;; *) lost=1; return 1 ;; esac
            r=${r%%"'"*}
            j=$((j + ${#r} + 1)) ;;
          '"')
            j=$((j + 1))
            while [ "$j" -lt "$n" ] && [ "${s:j:1}" != '"' ]; do
              [ "${s:j:1}" != "\\" ] || j=$((j + 1))
              j=$((j + 1))
            done ;;
        esac
        j=$((j + 1))
      done
      i=$j ;;
  esac
  return 0
}
# heredoc <at>: reads the delimiter of lex's heredoc, its << just before <at>, into
# HD (with HT=1 for <<-) and sets hp past it. Returns 1 when lost.
heredoc() {
  local j=$1 t=0 dl='' ch r
  if [ "${s:j:1}" = - ]; then t=1 j=$((j + 1)); fi
  while [ "${s:j:1}" = ' ' ] || [ "${s:j:1}" = $'\t' ]; do j=$((j + 1)); done
  while [ "$j" -lt "$n" ]; do
    ch=${s:j:1}
    case "$ch" in
      ' ' | $'\t' | $'\n' | ';' | '&' | '|' | '<' | '>' | '(' | ')') break ;;
      "'")
        r=${s:j+1}
        case "$r" in *"'"*) ;; *) lost=1; return 1 ;; esac
        r=${r%%"'"*}
        dl=$dl$r j=$((j + ${#r} + 1)) ;;
      '"')
        j=$((j + 1))
        while [ "${s:j:1}" != '"' ]; do
          [ "$j" -lt "$n" ] || { lost=1; return 1; }
          ch=${s:j:1}
          if [ "$ch" = \\ ]; then
            case "${s:j+1:1}" in '$' | '`' | '"' | \\) j=$((j + 1)) ch=${s:j:1} ;; esac
          fi
          dl=$dl$ch j=$((j + 1))
        done ;;
      \\) j=$((j + 1)) dl=$dl${s:j:1} ;;
      *) dl=$dl$ch ;;
    esac
    j=$((j + 1))
  done
  [ -n "$dl" ] || { lost=1; return 1; }
  HD+=("$dl") HT+=("$t") hp=$j
}
# body <at>: skips the bodies of the pending heredocs, the first starting at <at>,
# each to the first line equal to its delimiter, and sets hp to the end of the last
# delimiter line. Returns 1 when lost.
body() {
  local j=$1 x=0 l e
  while [ "$x" -lt "${#HD[@]}" ]; do
    while :; do
      [ "$j" -lt "$n" ] || { lost=1; return 1; }
      l=${s:j}
      l=${l%%$'\n'*}
      e=$l
      [ "${HT[x]}" = 0 ] || while [ "${e:0:1}" = $'\t' ]; do e=${e:1}; done
      j=$((j + ${#l} + 1))
      [ "$e" != "${HD[x]}" ] || break
    done
    x=$((x + 1))
  done
  HD=() HT=() hp=$((j - 1))
}

# gitcmd <index>: reads git's own options after the git at T[index]. Sets sub to
# the subcommand's index (-1 if none), gfold to its folder, gopt to the options to
# pass on and gbad=1 for an option or folder it cannot follow.
gitcmd() {
  local i=$(($1 + 1))
  gfold=$fold gopt=() gbad=0 sub=-1
  while [ "$i" -lt "${#T[@]}" ] && [ "${K[i]}" != s ]; do
    case "${T[i]}" in
      -C)
        i=$((i + 1))
        if [ "${K[i]:-}" = w ]; then
          case "${T[i]}" in /*) gfold=${T[i]} ;; *) gfold=$gfold/${T[i]} ;; esac
        else gbad=1; fi ;;
      -c) i=$((i + 1)); [ "${K[i]:-}" = w ] || gbad=1; gopt+=(-c "${T[i]:-}") ;;
      --git-dir | --work-tree | --namespace) i=$((i + 1)); gbad=1 ;;
      --git-dir=* | --work-tree=* | --namespace=*) gbad=1 ;;
      -*) gopt+=("${T[i]}") ;;
      *) sub=$i; return ;;
    esac
    i=$((i + 1))
  done
}

# lead <from> <to>: sets ld to the first word in T[from..to) that is neither a
# variable assignment nor a word that runs the command after it (then, env, ...),
# and lbad=1 if an assignment sets a GIT_ variable.
lead() {
  ld=$1 lbad=0
  while [ "$ld" -lt "$2" ]; do
    case "${T[ld]}" in
      if | then | elif | else | while | until | do | '{' | '!' | command | exec | env | time) ;;
      GIT_*=*) lbad=1 ;;
      *) [[ ${T[ld]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || return 0 ;;
    esac
    ld=$((ld + 1))
  done
}

# Whether the command stages in the same call: git add steps before the commit (each
# kept as its folder, git options and arguments), and the commit's -a or paths. The
# commit's git starts a step, after any words lead skips; else it is not run as a
# command here.
fold=$cwd foldok=1 stage=0 sfail=0 nosim=0
AF=() AS=() AN=() OS=() ON=() ARGS=() OPTS=()
lex "$pre"
[ "$lost" = 0 ] || sfail=1
if [ "$lost" = 0 ]; then
  i=${#K[@]}
  while [ "$i" -gt 0 ] && [ "${K[i - 1]}" != s ]; do i=$((i - 1)); done
  lead "$i" "${#K[@]}"
  [ "$ld" = "${#K[@]}" ] || nosim=1
  [ "$lbad" = 0 ] || sfail=1
fi
i=0
while [ "$i" -lt "${#T[@]}" ]; do
  j=$i
  while [ "$j" -lt "${#T[@]}" ] && [ "${K[j]}" != s ]; do j=$((j + 1)); done
  lead "$i" "$j"
  i=$ld
  case "${T[i]:-}" in
    cd)
      k=$((i + 1))
      if [ "$k" = "$j" ]; then fold=$HOME
      elif [ "$((k + 1))" = "$j" ] && [ "${K[k]}" = w ] && [ "${T[k]}" != - ]; then
        case "${T[k]}" in /*) fold=${T[k]} ;; *) fold=$fold/${T[k]} ;; esac
      else foldok=0; fi ;;
    git)
      gitcmd "$i"
      if [ "$sub" -ge 0 ] && [ "${T[sub]}" = add ]; then
        oos=0 bad=$gbad dd=0 k=$((sub + 1))
        [ "$foldok" = 1 ] && [ "$lbad" = 0 ] || bad=1
        while [ "$k" -lt "$j" ]; do
          [ "${K[k]}" = w ] || bad=1
          if [ "$dd" = 0 ]; then
            case "${T[k]}" in --) dd=1 ;; --patch | --interactive | --edit) oos=1 ;; --*) ;; -*[pie]*) oos=1 ;; esac
          fi
          k=$((k + 1))
        done
        if [ "$oos" = 0 ]; then
          stage=1
          [ "$bad" = 0 ] || sfail=1
          AF+=("$gfold") AS+=("${#ARGS[@]}") AN+=($((j - sub - 1))) OS+=("${#OPTS[@]}") ON+=("${#gopt[@]}")
          ARGS+=("${T[@]:sub+1:j-sub-1}") OPTS+=(${gopt[@]+"${gopt[@]}"})
        fi
      fi ;;
  esac
  i=$((j + 1))
done
if [ "$lost" = 1 ] && [[ $pre =~ (^|[^[:alnum:]_.-])add([[:space:]]|$) ]]; then stage=1; fi

# The commit's own arguments, to the end of its step. A word that is not certain is
# read only as a flag whose value starts within it, from its text before the
# expansion; anywhere else it asks, as does text that cannot be read within the step.
all=0 incl=0 P=()
lex "$from" 1
gitcmd 0
cfold=$gfold copt=(${gopt[@]+"${gopt[@]}"})
[ "$gbad" = 0 ] || sfail=1
[ "$foldok" = 1 ] || sfail=1
if [ "$sub" -lt 0 ] || [ "${T[sub]}" != commit ]; then nosim=1; fi
k=$((sub + 1)) dd=0
while [ "$nosim" = 0 ] && [ "$k" -lt "${#T[@]}" ]; do
  a=${T[k]} u=0
  case "${K[k]}" in
    s) break ;;
    u)
      u=1 a=${a%%\$*}
      case "$dd$a" in 0--?*=* | 0-[!-]*) ;; *) stage=1 sfail=1; break ;; esac ;;
  esac
  if [ "$dd" = 1 ]; then P+=("$a")
  else
    case "$a" in
      --) dd=1 ;;
      --all) all=1 ;;
      --include) incl=1 ;;
      --only) incl=0 ;;
      --interactive | --patch | --pathspec-from-file | --pathspec-from-file=*) nosim=1 ;;
      --message | --file | --reuse-message | --reedit-message | --template | --author | --date | --cleanup | --fixup | --squash | --trailer) k=$((k + 1)) ;;
      --*) ;;
      -?*)
        b=${a#-} v=0
        while [ -n "$b" ]; do
          l=${b:0:1} b=${b:1}
          case "$l" in
            a) all=1 ;;
            i) incl=1 ;;
            o) incl=0 ;;
            p) nosim=1 ;;
            [mFCct]) [ -n "$b" ] || [ "$u" = 1 ] || k=$((k + 1)); b='' v=1 ;;
            [Su]) b='' v=1 ;;
          esac
        done
        [ "$u$v" != 10 ] || { stage=1 sfail=1; break; } ;;
      *) P+=("$a") ;;
    esac
  fi
  k=$((k + 1))
done
[ "$all" = 0 ] && [ "${#P[@]}" = 0 ] || stage=1
if [ "$nosim" = 0 ] && [ "$lost" = 1 ]; then
  case " ${K[*]-} " in *" s "*) ;; *) stage=1 sfail=1 ;; esac
fi
[ "$nosim" = 0 ] || stage=0

if [ "$stage" = 1 ]; then
  what="the changes this commit would include"
  [ "$sfail" = 0 ] || unsure
  top=$(git -C "$cfold" rev-parse --show-toplevel 2>/dev/null) || unsure
  [ -n "$top" ] || unsure
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/mentat-secret.XXXXXX") || unsure
  trap 'rm -rf "$tmp"' EXIT
  # A copy of the index and a new object store reading the repository's objects, so
  # the replayed steps change neither.
  idx=$(git -C "$top" rev-parse --git-path index 2>/dev/null) || unsure
  obj=$(git -C "$top" rev-parse --git-path objects 2>/dev/null) || unsure
  case "$idx" in /*) ;; *) idx=$top/$idx ;; esac
  case "$obj" in /*) ;; *) obj=$top/$obj ;; esac
  if [ -f "$idx" ]; then cp "$idx" "$tmp/index" || unsure; fi
  mkdir "$tmp/objects" || unsure
  alt=${obj//\\/\\\\}
  alt=\"${alt//\"/\\\"}\"
  sg() {
    GIT_INDEX_FILE=$tmp/index GIT_OBJECT_DIRECTORY=$tmp/objects GIT_ALTERNATE_OBJECT_DIRECTORIES=$alt \
      GIT_NO_LAZY_FETCH=1 git -c core.fsmonitor=false -c core.splitIndex=false -c core.untrackedCache=false \
      -c gc.auto=0 -c maintenance.auto=false "$@" </dev/null 2>/dev/null
  }
  # Each add runs from its folder; one in another repository stages nothing here.
  k=0
  while [ "$k" -lt "${#AF[@]}" ]; do
    atop=$(git -C "${AF[k]}" rev-parse --show-toplevel 2>/dev/null) || unsure
    if [ "$atop" = "$top" ]; then
      args=("${ARGS[@]:${AS[k]}:${AN[k]}}") opts=()
      [ "${ON[k]}" = 0 ] || opts=("${OPTS[@]:${OS[k]}:${ON[k]}}")
      sg ${opts[@]+"${opts[@]}"} -C "${AF[k]}" add ${args[@]+"${args[@]}"} >/dev/null || unsure
    fi
    k=$((k + 1))
  done
  # A commit naming paths takes the files they match in the index, over HEAD unless
  # it has --include; without it, files they match in HEAD too.
  if [ "${#P[@]}" -gt 0 ]; then
    sg ${copt[@]+"${copt[@]}"} -C "$cfold" ls-files -z --full-name -- "${P[@]}" >"$tmp/paths" || unsure
    if [ "$incl" = 0 ]; then
      if git -C "$top" rev-parse -q --verify HEAD >/dev/null 2>&1; then
        sg -C "$top" read-tree HEAD || unsure
      else
        sg -C "$top" read-tree --empty || unsure
      fi
      sg ${copt[@]+"${copt[@]}"} -C "$cfold" ls-files -z --full-name -- "${P[@]}" >>"$tmp/paths" || unsure
    fi
    if [ -s "$tmp/paths" ]; then
      sg ${copt[@]+"${copt[@]}"} --literal-pathspecs -C "$top" add --pathspec-from-file="$tmp/paths" \
        --pathspec-file-nul >/dev/null || unsure
    fi
  fi
  if [ "$all" = 1 ]; then sg ${copt[@]+"${copt[@]}"} -C "$top" add -u -- :/ >/dev/null || unsure; fi
  sg -C "$top" -c core.quotePath=false diff --cached --no-relative --no-ext-diff --no-textconv \
    --no-color -U0 --src-prefix=a/ --dst-prefix=b/ >"$tmp/diff" || unsure
else
  # go <word>: moves $dir to the directory a cd or git -C names, with quotes off and
  # ~/ or $HOME/ at its start expanded.
  go() {
    local v=${1#[\"\']}
    v=${v%[\"\']}
    case "$v" in '~' | '$HOME') v=$HOME ;; '~/'*) v=$HOME/${v#\~/} ;; '$HOME/'*) v=$HOME/${v#\$HOME/} ;; esac
    case "$v" in /*) dir=$v ;; *) dir=$dir/$v ;; esac
  }
  dir=$cwd
  re="^[[:space:]]*cd[[:space:]]+${word}[[:space:]]*(&&|;)"
  if [[ $cmd =~ $re ]]; then go "${BASH_REMATCH[1]}"; fi
  re="^[[:space:]]+(-[^[:space:]]+)([[:space:]]+$word)?"
  while [[ $flags =~ $re ]]; do
    flags=${flags:${#BASH_REMATCH[0]}}
    if [ "${BASH_REMATCH[1]}" = -C ] && [ -n "${BASH_REMATCH[3]}" ]; then go "${BASH_REMATCH[3]}"; fi
  done
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
  [ -n "$top" ] || exit 0

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/mentat-secret.XXXXXX") || exit 0
  trap 'rm -rf "$tmp"' EXIT
  # The staged changes, with fixed prefixes, plain file names and no added context lines.
  git -C "$top" -c core.quotePath=false diff --cached --no-relative --no-ext-diff --no-textconv \
    --no-color -U0 --src-prefix=a/ --dst-prefix=b/ >"$tmp/diff" 2>/dev/null || exit 0
fi
[ -s "$tmp/diff" ] || exit 0

# Exit 3 is a finding; any other failure is a gitleaks error.
(cd "$top" && gitleaks stdin --no-banner --redact --log-level fatal --exit-code 3 \
  --report-format json --report-path "$tmp/report.json") <"$tmp/diff" >/dev/null 2>&1
rc=$?
[ "$rc" != 0 ] || exit 0
[ "$rc" = 3 ] || failed
jq -r '.[] | "\(.StartLine | tonumber | floor)\t\(.RuleID | tostring)"' "$tmp/report.json" >"$tmp/found" 2>/dev/null || failed
[ -s "$tmp/found" ] || failed

# Each finding's line in the diff, if it is an added line, gives its file from the
# +++ header above it. A file name with spaces ends with a tab there.
LC_ALL=C awk -F '\t' '
  NR == FNR { want[$1] = (($1 in want) ? want[$1] SUBSEP : "") $2; next }
  /^diff --git / { head = 1; next }
  head && /^\+\+\+ / { f = substr($0, 5); sub(/\t$/, "", f); if (!sub(/^b\//, "", f)) sub(/^"b\//, "\"", f); next }
  /^@@/ { head = 0; next }
  !head && /^\+/ && (FNR in want) { n = split(want[FNR], r, SUBSEP); for (i = 1; i <= n; i++) print r[i] " in " f }
' "$tmp/found" "$tmp/diff" | sort -u >"$tmp/hits" || failed
[ -s "$tmp/hits" ] || exit 0

count=$(wc -l <"$tmp/hits" | tr -d ' ')
list=$(head -n 5 "$tmp/hits" | awk 'NR > 1 { printf "; " } { printf "%s", $0 }')
[ "$count" -le 5 ] || list="$list; and $((count - 5)) more"
ask "Mentat: gitleaks flags a likely secret in $what ($list). Approve only if none is a real secret."

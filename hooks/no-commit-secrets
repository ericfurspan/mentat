#!/usr/bin/env bash
# PreToolUse hook: a git commit whose staged changes hold a likely secret gets a
# permission prompt. It pipes git diff --cached into gitleaks' stdin scan, with
# redaction, and reads only the rule and line of each finding from its JSON report;
# gitleaks' own output goes nowhere. A finding counts on an added line only, named
# by rule and file, never the match. A gitleaks error asks too, as a failed scan.
# Approving the prompt clears a false alarm; there is no ignore file. It scans the
# repository of a leading cd and of git -C, else the session's directory. This is a
# net for mistakes, not a security boundary: other routes exist, and a commit whose
# own command stages the changes (git add ... && git commit, git commit -a) is
# scanned before they are staged. When it cannot read its input or gitleaks is
# missing, it stays out of the way.
# shellcheck disable=SC2016,SC2088 # ~/ and $HOME below are literal command text.
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0
command -v gitleaks >/dev/null 2>&1 || exit 0
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
[ "$tool" = Bash ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
case "$cmd" in *commit*) ;; *) exit 0 ;; esac
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
[ -n "$cwd" ] || cwd=$PWD

# A word of the command, and git with its flags (each with an optional value) before commit.
word='("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:];&|)"'"'"'-][^[:space:];&|)]*)'
re="(^|[^[:alnum:]_.-])git(([[:space:]]+-[^[:space:]]+([[:space:]]+$word)?)*)[[:space:]]+commit([[:space:]]|\$)"
[[ $cmd =~ $re ]] || exit 0
flags=${BASH_REMATCH[2]}

# go <word>: moves $dir to the directory a cd or git -C names, with quotes off and
# ~/ or $HOME/ at its start expanded.
go() {
  local v=${1#[\"\']}
  v=${v%[\"\']}
  case "$v" in '~' | '$HOME') v=$HOME ;; '~/'*) v=$HOME/${v#\~/} ;; '$HOME/'*) v=$HOME/${v#\$HOME/} ;; esac
  case "$v" in /*) dir=$v ;; *) dir=$dir/$v ;; esac
}
dir=$cwd
re="^[[:space:]]*cd[[:space:]]+${word}[[:space:]]*(&&|;)"
if [[ $cmd =~ $re ]]; then go "${BASH_REMATCH[1]}"; fi
re="^[[:space:]]+(-[^[:space:]]+)([[:space:]]+$word)?"
while [[ $flags =~ $re ]]; do
  flags=${flags:${#BASH_REMATCH[0]}}
  if [ "${BASH_REMATCH[1]}" = -C ] && [ -n "${BASH_REMATCH[3]}" ]; then go "${BASH_REMATCH[3]}"; fi
done
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$top" ] || exit 0

tmp=$(mktemp -d "${TMPDIR:-/tmp}/mentat-secret.XXXXXX") || exit 0
trap 'rm -rf "$tmp"' EXIT
# The staged changes, with fixed prefixes, plain file names and no added context lines.
git -C "$top" -c core.quotePath=false diff --cached --no-relative --no-ext-diff --no-textconv \
  --no-color -U0 --src-prefix=a/ --dst-prefix=b/ >"$tmp/diff" 2>/dev/null || exit 0
[ -s "$tmp/diff" ] || exit 0

ask() {
  jq -n --arg r "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask",
    permissionDecisionReason: $r}}'
  exit 0
}
failed() { ask "Mentat: the gitleaks scan of the staged changes failed, so they were not checked for secrets. Approve only if you want to commit without the scan."; }

# Exit 3 is a finding; any other failure is a gitleaks error.
(cd "$top" && gitleaks stdin --no-banner --redact --log-level fatal --exit-code 3 \
  --report-format json --report-path "$tmp/report.json") <"$tmp/diff" >/dev/null 2>&1
rc=$?
[ "$rc" != 0 ] || exit 0
[ "$rc" = 3 ] || failed
jq -r '.[] | "\(.StartLine | tonumber | floor)\t\(.RuleID | tostring)"' "$tmp/report.json" >"$tmp/found" 2>/dev/null || failed
[ -s "$tmp/found" ] || failed

# Each finding's line in the diff, if it is an added line, gives its file from the
# +++ header above it. A file name with spaces ends with a tab there.
LC_ALL=C awk -F '\t' '
  NR == FNR { want[$1] = (($1 in want) ? want[$1] SUBSEP : "") $2; next }
  /^diff --git / { head = 1; next }
  head && /^\+\+\+ / { f = substr($0, 5); sub(/\t$/, "", f); if (!sub(/^b\//, "", f)) sub(/^"b\//, "\"", f); next }
  /^@@/ { head = 0; next }
  !head && /^\+/ && (FNR in want) { n = split(want[FNR], r, SUBSEP); for (i = 1; i <= n; i++) print r[i] " in " f }
' "$tmp/found" "$tmp/diff" | sort -u >"$tmp/hits" || failed
[ -s "$tmp/hits" ] || exit 0

count=$(wc -l <"$tmp/hits" | tr -d ' ')
list=$(head -n 5 "$tmp/hits" | awk 'NR > 1 { printf "; " } { printf "%s", $0 }')
[ "$count" -le 5 ] || list="$list; and $((count - 5)) more"
ask "Mentat: gitleaks flags a likely secret in the staged changes ($list). Approve only if none is a real secret."

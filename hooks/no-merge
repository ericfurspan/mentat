#!/usr/bin/env bash
# PreToolUse hook: the maintainer merges. A command that would merge a pull
# request (gh pr merge, including --auto, or the merge API through gh api) and
# the desktop app's auto-merge tool are denied. It follows the contract in
# hooks/lib/verdict.sh, so it fails closed. This is a net for common mistakes,
# not a security boundary: other routes exist.
# shellcheck disable=SC2329 # run_hook calls check.
set -uo pipefail

# shellcheck source=hooks/lib/verdict.sh
. "${0%/*}/lib/verdict.sh" 2>/dev/null || {
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Mentat: no-merge could not load hooks/lib/verdict.sh, so it blocks this call."}}'
  exit 0
}

merge="the maintainer merges; agents never merge a pull request or turn on auto-merge. If this command only mentions a merge in its text, such as a commit message or pull request body, pass that text through a file (-F or --body-file)."

check() {
  local cmd flags api
  case "$tool" in
    Bash)
      cmd=$(field '.tool_input.command') || verdict deny "no-merge could not read the command, so it blocks this call."
      # Flags (and an unquoted value each) may sit around "pr": gh -R o/r pr merge.
      flags='([[:space:]]+-[^[:space:]]+([[:space:]]+[^-[:space:]"'"'"'][^[:space:]"'"'"']*)?)*'
      # A here-string, not a pipe: grep -q stops at the first match, and under pipefail
      # the writer's broken pipe on a long command would fail the test and pass a merge.
      if grep -Eq "(^|[^[:alnum:]_.-])gh${flags}[[:space:]]+pr${flags}[[:space:]]+merge([[:space:]]|\$)" <<<"$cmd"; then
        verdict deny "$merge"
      fi
      api='(^|[^[:alnum:]_.-])gh[[:space:]]+api[[:space:]].*pulls/[^/[:space:]]+/merge([^[:alnum:]_]|$)'
      if grep -Eq "$api" <<<"$cmd"; then verdict deny "$merge"; fi
      verdict pass
      ;;
    mcp__ccd_pr__set_auto_merge) verdict deny "$merge" ;;
    *) verdict pass ;;
  esac
}

run_hook check

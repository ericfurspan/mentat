#!/usr/bin/env bash
# PreToolUse hook: agents do not push to the default branch. A git push that
# would change it (a refspec ending there, a delete of it, --all, --mirror, or
# no refspec while it is checked out) gets a permission prompt, so the
# maintainer decides; a repository whose workflow commits to the default branch
# (a journal) still works when the maintainer approves. --tags alone is not a
# branch change and passes. This is a net for mistakes, not a security boundary:
# other routes exist. When it cannot read its input, it stays out of the way.
set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
[ "$tool" = Bash ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
case "$cmd" in *push*) ;; *) exit 0 ;; esac
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
[ -n "$cwd" ] || cwd=$PWD

ask() {
  jq -n --arg n "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask",
    permissionDecisionReason: ("Mentat: agents do not push to the default branch (" + $n + "). Approve only if you want this push to go to it.")}}'
  exit 0
}

# load <dir>: sets $defaults (origin/HEAD, else main and master) and $current.
load() {
  local ref
  current=$(git -C "$1" symbolic-ref --short HEAD 2>/dev/null) || current=""
  if ref=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && [ -n "${ref#origin/}" ]; then
    defaults=${ref#origin/}
  else
    defaults="main master"
  fi
}
is_default() {
  local d
  [ -n "$1" ] || return 1
  for d in $defaults; do [ "$1" = "$d" ] && return 0; done
  return 1
}

nl=$'\n'
pieces=${cmd//;/$nl}
pieces=${pieces//|/$nl}
pieces=${pieces//&/$nl}

# A command can chain several: look at each piece that starts with git ... push.
while IFS= read -r seg; do
  words=()
  read -r -a words <<<"$seg" || true
  n=${#words[@]}
  [ "$n" -gt 0 ] || continue
  for ((i = 0; i < n; i++)); do words[i]=${words[i]//[\"\']/}; done

  i=0
  while [ "$i" -lt "$n" ]; do
    case "${words[i]}" in *=* | env | command | sudo | nohup | time) i=$((i + 1)) ;; *) break ;; esac
  done
  [ "$i" -lt "$n" ] || continue
  case "${words[i]}" in git | */git) ;; *) continue ;; esac
  i=$((i + 1))
  dir=""
  while [ "$i" -lt "$n" ]; do
    case "${words[i]}" in
      -C) dir=${words[i + 1]:-}; i=$((i + 2)) ;;
      -c | --git-dir | --work-tree | --namespace) i=$((i + 2)) ;;
      -*) i=$((i + 1)) ;;
      *) break ;;
    esac
  done
  [ "$i" -lt "$n" ] && [ "${words[i]}" = push ] || continue
  i=$((i + 1))

  where=$cwd
  case "$dir" in "") ;; /*) where=$dir ;; *) where=$cwd/$dir ;; esac
  load "$where"

  pos=()
  tags=0
  while [ "$i" -lt "$n" ]; do
    w=${words[i]}
    case "$w" in
      --all | --mirror) ask "${defaults// / or }" ;;
      --tags) tags=1; i=$((i + 1)) ;;
      --repo | -o | --push-option | --receive-pack | --exec) i=$((i + 2)) ;;
      -*) i=$((i + 1)) ;;
      *) pos+=("$w"); i=$((i + 1)) ;;
    esac
  done

  # The first word is the remote; the rest are refspecs.
  np=${#pos[@]}
  if [ "$np" -le 1 ]; then
    if [ "$tags" -eq 0 ] && is_default "$current"; then ask "$current"; fi
    continue
  fi
  for ((j = 1; j < np; j++)); do
    spec=${pos[j]#+}
    case "$spec" in *:*) dest=${spec#*:} ;; *) dest=$spec ;; esac
    dest=${dest#+}
    dest=${dest#refs/heads/}
    case "$spec" in HEAD) dest=$current ;; esac
    if is_default "$dest"; then ask "$dest"; fi
    # A wildcard refspec can carry the default branch along.
    case "$dest" in *\**) ask "${defaults// / or }" ;; esac
  done
done <<<"$pieces"
exit 0

#!/usr/bin/env bash
# SessionStart hook: prints rules.md, Mentat's workflow rules, which Claude Code
# adds to every session's context on startup, resume, clear, compact and fork.
# Claude Code caps a hook's output at 10,000 characters; tests/run holds this
# hook's output under a limit just above its current size, raised only in the
# pull request that grows past it, with the maintainer's agreement in the spec.
# Before the rules, it prints one problem line when the installed git hook templates
# are missing or differ from this copy (lib/templates.sh), or cannot be checked.
# Finds its files relative to this script, never the working directory, so it
# also runs outside a plugin.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=/dev/null
# Bash 3.2 exits when . finds no file, so the file is looked for first.
if ! { [ -f "$root/lib/templates.sh" ] && . "$root/lib/templates.sh" && state=$(templates_state "$root"); } 2>/dev/null; then
  printf 'Mentat PROBLEM: %s. Tell the maintainer before anything else, and run mentat check.\n\n' \
    "${state:-the installed git hook templates could not be checked}"
fi
cat "$root/rules.md"

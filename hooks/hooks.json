{
  "modules": ["./decisions-pane.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__ccd_pr__set_auto_merge",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-merge" }
        ]
      }
    ]
  }
}

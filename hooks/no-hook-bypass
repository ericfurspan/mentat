#!/usr/bin/env bash
# PreToolUse hook: agents never skip Mentat's git hooks. A real git command (never text
# in quotes, a comment or a heredoc body; hooks/lib/commands.sh) with --no-verify (or
# --no-veri, --no-verif), commit's -n (alone or in a bundle, never an option's value),
# a -c or --config-env setting core.hooksPath, or a git config write of core.hooksPath
# is denied. The git wrapper drops these anyway; the denial tells the agent at once.
# A real gh pr create or gh pr new gets a permission prompt while git status --porcelain
# in its directory prints anything, or when its branch changes an agent instruction
# file against origin/<default>, unless the branch name holds an item id that mentat
# second-opinion --link recorded as reviewed in the shared git folder. A cd joined to
# the command by && alone moves these checks to its directory; any other cd adds its
# directory to the session's. It follows the contract in hooks/lib/verdict.sh, so it
# fails closed. This is a net for common mistakes, not a security boundary: other
# routes exist.
# shellcheck disable=SC2329 # run_hook calls check.
set -uo pipefail

# shellcheck source=hooks/lib/verdict.sh
. "${0%/*}/lib/verdict.sh" 2>/dev/null || {
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Mentat: no-hook-bypass could not load hooks/lib/verdict.sh, so it blocks this call."}}'
  exit 0
}
# shellcheck source=hooks/lib/commands.sh
. "${0%/*}/lib/commands.sh" 2>/dev/null || {
  deny_literal "no-hook-bypass could not load hooks/lib/commands.sh, so it blocks this call."
  exit 0
}

bypass="agents never skip Mentat's git hooks (--no-verify, commit -n or a core.hooksPath override)."

no_verify() {
  case "$1" in --no-veri | --no-verif | --no-verify) return 0 ;; esac
  return 1
}

# git_bypass: returns 0 when the real git command in words skips the git hooks.
git_bypass() {
  local k=$((ci + 1)) w v sub="" b l dd=""
  while [ "$k" -lt "$n" ]; do
    w=${words[k]}
    case "$w" in
      -c | --config-env)
        v=${words[k + 1]:-}
        if hooks_key "${v%%=*}"; then return 0; fi
        k=$((k + 2))
        continue
        ;;
      --config-env=*) v=${w#--config-env=}; if hooks_key "${v%%=*}"; then return 0; fi ;;
      -C | --git-dir | --work-tree | --namespace | --super-prefix | --attr-source) k=$((k + 2)); continue ;;
      -*) if no_verify "$w"; then return 0; fi ;;
      *) sub=$w; k=$((k + 1)); break ;;
    esac
    k=$((k + 1))
  done
  [ "$sub" != config ] || ! config_hooks_write "$k" || return 0
  while [ "$k" -lt "$n" ]; do
    w=${words[k]}
    k=$((k + 1))
    if no_verify "$w"; then return 0; fi
    [ "$sub" = commit ] && [ -z "$dd" ] || continue
    case "$w" in
      --) dd=1 ;;
      --message | --file | --reuse-message | --reedit-message | --template | --author | --date | \
        --cleanup | --fixup | --squash | --trailer | --pathspec-from-file) k=$((k + 1)) ;;
      --*) ;;
      -?*)
        b=${w#-}
        while [ -n "$b" ]; do
          l=${b:0:1} b=${b:1}
          case "$l" in
            n) return 0 ;;
            [mFCct]) [ -n "$b" ] || k=$((k + 1)); b="" ;;
            [Su]) b="" ;;
          esac
        done
        ;;
    esac
  done
  return 1
}

# real_commands: denies a real git command that skips the hooks, and returns 0 when a
# real gh command is pr create or pr new.
real_commands() {
  local line pr=1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    split_words "$line"
    command_at
    case "${words[ci]:-}" in
      git | */git) if git_bypass; then return 2; fi ;;
    esac
    gh_at || continue
    [ "${words[gi]:-}" = pr ] || continue
    gi=$((gi + 1))
    gh_skip
    case "${words[gi]:-}" in create | new) pr=0 ;; esac
  done <<<"$commands"
  return "$pr"
}

# note <reason>: adds a reason for the prompt, once; the hook asks at the end.
nl=$'\n'
reasons=""
note() {
  case "$nl$reasons$nl" in *"$nl$1$nl"*) return ;; esac
  reasons+=${reasons:+$nl}$1
}
# unclean <dir>: notes uncommitted changes when git status there prints anything.
unclean() {
  [ -z "$(git --no-optional-locks -C "$1" status --porcelain 2>/dev/null)" ] ||
    note "Mentat: agents push and open pull requests from a clean working tree, and git status lists uncommitted changes. Approve only if you want to go ahead without committing them."
}

# load <dir>: sets $defaults (origin/HEAD, else main and master) and $current.
load() {
  local ref
  current=$(git -C "$1" symbolic-ref --short HEAD 2>/dev/null) || current=""
  if ref=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && [ -n "${ref#origin/}" ]; then
    defaults=${ref#origin/}
  else
    defaults="main master"
  fi
}
# linked <dir>: the branch in <dir> has a segment (split on /) that is, ignoring
# case, an item id a link line of the second-opinion record names, alone or
# followed by -. The record is only read, never run.
linked() {
  local rec kind id found=1
  [ -n "$current" ] || return 1
  rec=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) && [ -n "$rec" ] || return 1
  case "$rec" in /*) ;; *) rec=$1/$rec ;; esac
  shopt -s nocasematch
  # A missing or unreadable record reads as empty.
  while read -r kind _ id _; do
    [ "$kind" = link ] && [ -n "$id" ] || continue
    case "/$current/" in */"$id"/* | */"$id"-*) found=0; break ;; esac
  done 2>/dev/null <"$rec/mentat/second-opinions"
  shopt -u nocasematch
  return "$found"
}
# instructions <dir>: notes a branch whose change from its merge base with
# origin/<default> adds, changes, deletes or renames an AGENTS.md,
# AGENTS.override.md, CLAUDE.md or SKILL.md, or the root rules.md or prompts/,
# unless linked. No default-branch ref, or a git error, notes nothing.
instructions() {
  local d paths p
  load "$1"
  for d in $defaults; do
    git -C "$1" rev-parse -q --verify "refs/remotes/origin/$d" >/dev/null 2>&1 || continue
    paths=$(git -c core.quotePath=false -C "$1" diff --name-only --no-relative --no-renames "origin/$d...HEAD" 2>/dev/null) || continue
    while IFS= read -r p; do
      case "/$p" in
        */AGENTS.md | */AGENTS.override.md | */CLAUDE.md | */SKILL.md | /rules.md | /prompts/*)
          linked "$1" ||
            note "Mentat: this pull request changes agent instructions, and no design review on record (mentat second-opinion --link) names this branch's item. Approve only if Codex and Grok are off for this session or the change alters no meaning."
          return
          ;;
      esac
    done <<<"$paths"
  done
}
# resolve <path> [base]: sets $to, the directory a cd would use: ~, $HOME and
# ${HOME}, alone or before /, go to HOME; an absolute path stays; anything else is
# relative to base, else $here. A ~user, or HOME unset, gives an empty $to.
# shellcheck disable=SC2016 # The words are not expanded: $HOME is literal text.
resolve() {
  case "$1" in
    \~ | '$HOME' | '${HOME}') to=${HOME:-} ;;
    \~/* | '$HOME/'* | '${HOME}/'*) to=${HOME:+$HOME/${1#*/}} ;;
    /*) to=$1 ;;
    \~*) to="" ;;
    *) to=${2:-$here}/$1 ;;
  esac
}

# Both scanners below take the text up to the next character that matters in
# one chunk and drop it by offset: in bash 3.2, ${#s} and ${s:i:1} cost the
# length of $s, and ${s#"$x"} and ${s//x/y} more, so a per-character loop or a
# substitution with many matches is quadratic on a long pull request body.
tab=$'\t'

# tokenize <text>: sets $words, split on blanks the way a shell does: single
# and double quotes and backslashes keep a path with spaces in one word. An
# unmatched quote ends at the end of the text.
tokenize() {
  local s=$1 run c q="" cur="" has=0
  words=()
  while [ -n "$s" ]; do
    case "$q" in
      \") run=${s%%[\"\\]*} ;;
      \') run=${s%%\'*} ;;
      *) run=${s%%[\'\"\\\ "$tab"]*}; [ -z "$run" ] || has=1 ;;
    esac
    cur+=$run; s=${s:${#run}}
    [ -n "$s" ] || break
    c=${s:0:1}; s=${s:1}
    if [ -n "$q" ]; then
      # The closing quote, or a backslash inside double quotes.
      if [ "$c" = "$q" ]; then q=""; else cur+=${s:0:1}; s=${s:1}; fi
    else
      case "$c" in
        "'" | '"') q=$c; has=1 ;;
        "\\") cur+=${s:0:1}; s=${s:1}; has=1 ;;
        *) if [ "$has" -eq 1 ]; then words+=("$cur"); cur=""; has=0; fi ;;
      esac
    fi
  done
  if [ "$has" -eq 1 ]; then words+=("$cur"); fi
}

# split_quoted <text>: sets $qpieces, the text with each unquoted ;, |, & and
# newline turned into a line break (one for && and ||), each quoted newline
# into a tab and each backslash-newline outside single quotes dropped,
# quoting as in tokenize. A piece after && starts with $and, unless an unquoted
# ) came before it in its piece; after |, || or |& with $pipe; after the & of a
# redirect (2>&1, &>file) with $redir.
and=$'\002' pipe=$'\003' redir=$'\004'
split_quoted() {
  local s=$1 run c q="" last="" closed=0
  qpieces=""
  while [ -n "$s" ]; do
    case "$q" in
      \") run=${s%%[\"\\"$nl"]*} ;;
      \') run=${s%%[\'"$nl"]*} ;;
      *) run=${s%%[\'\"\\\;\|\&\)"$nl"]*} ;;
    esac
    qpieces+=$run; s=${s:${#run}}
    [ -z "$run" ] || last=${run: -1}
    [ -n "$s" ] || break
    c=${s:0:1}; s=${s:1}
    case "$q$c" in
      "'" | '"') q=$c ;;
      "''" | '""') q="" ;;
      # A backslash, unquoted or inside double quotes, keeps the next character;
      # before a newline, both go (a line continuation).
      \\ | \"\\) c=${s:0:1}; s=${s:1}; case "$c" in "$nl") c="" ;; *) c="\\$c" ;; esac ;;
      ?$nl) c=$tab ;;
      ")") closed=1 ;;
      "&")
        case "$last${s:0:1}" in
          [\<\>]* | *\>) c=$nl$redir ;;
          *\&) s=${s:1}; if [ "$closed" -eq 1 ]; then c=$nl; else c=$nl$and; fi; closed=0 ;;
          *) c=$nl; closed=0 ;;
        esac
        ;;
      "|") case "${s:0:1}" in "|" | "&") s=${s:1} ;; esac; c=$nl$pipe; closed=0 ;;
      *) c=$nl; closed=0 ;;
    esac
    qpieces+=$c
    [ -z "$c" ] || last=${c: -1}
  done
}

# covered: the quoted split covers every plain piece with the text of $seg: it has
# as many pieces that are that text, or start with it and go on with a quoted ;, |,
# & or newline (a tab there).
covered() {
  local np nq
  np=$(S=$seg LC_ALL=C awk '$0 == ENVIRON["S"] { c++ } END { print c + 0 }' <<<"$pieces")
  nq=$(S=$seg LC_ALL=C awk 'BEGIN { s = ENVIRON["S"]; n = length(s) }
    $0 == s || (substr($0, 1, n) == s && index(";|&\t", substr($0, n + 1, 1)) > 0) { c++ }
    END { print c + 0 }' <<<"$qseen")
  [ "$np" -le "$nq" ]
}

# skip_flags: moves $i past gh flags; -R and --repo take the next word.
skip_flags() {
  while [ "$i" -lt "$n" ]; do
    case "${words[i]}" in -R | --repo) i=$((i + 2)) ;; -*) i=$((i + 1)) ;; *) break ;; esac
  done
}

# pr_checks: notes the reasons a gh pr create or gh pr new in the command asks.
# The plain split also catches commands with an unmatched quote or inside a
# quoted string; the quoted split reads separators inside quotes as text. Both
# are checked, and the plain split leaves a piece the quoted split covers to
# it. The plain split joins each line that ends in a backslash with the next.
# A command can chain several: look at each piece that starts with gh pr create.
# A cd piece sets the directory ($here) for the pieces after it, up to the ) that
# closes a ( subshell it is in. $prev is the directory cd - uses. The session's
# directory ($cwd) is checked too, unless $chain says a cd that resolved led to the
# command through && alone, with no group opened or closed between; only the quoted
# split sets it. A cd through env, sudo, nohup or time, or after a pipe, does not,
# nor any after a ( opens inside a subshell ($nest), whose directory the walk does
# not track.
pr_checks() {
  pieces=$(printf '%s' "$cmd" | LC_ALL=C awk '{ if (sub(/\\$/, "")) printf "%s", $0; else print }' | LC_ALL=C tr ';|&' '\n')
  split_quoted "$cmd"
  qseen=$nl
  while IFS= read -r seg; do qseen+=${seg#["$and$pipe$redir"]}$nl; done <<<"$qpieces"
  for pass in plain quoted; do
    if [ "$pass" = plain ]; then text=$pieces; else text=$qpieces; fi
    here=$cwd prev="" sub=0 ends=0 chain=0 nest=0
    while IFS= read -r seg; do
      join=""
      if [ "$pass" = quoted ]; then
        case "$seg" in ["$and$pipe$redir"]*) join=${seg:0:1} seg=${seg:1} ;; esac
      fi
      case "$join" in "$and" | "$redir") ;; *) chain=0 ;; esac
      if [ "$ends" -eq 1 ] && [ "$sub" -eq 1 ]; then here=$saved prev=$saved_prev sub=0; fi
      ends=0
      tokenize "$seg"
      n=${#words[@]}
      [ "$n" -gt 0 ] || continue
      # A group ends with ) on the last word, or } as its own word.
      w=${words[n - 1]}
      while :; do case "$w" in *")") w=${w%")"}; ends=1 ;; *) break ;; esac; done
      words[n - 1]=$w
      case "$w" in "" | "}") unset "words[n - 1]"; n=$((n - 1)) ;; esac

      i=0 via=0
      while [ "$i" -lt "$n" ]; do
        # A group starts with ( or { on the first word; ( starts a subshell.
        w=${words[i]}
        while :; do
          case "$w" in
            "("*) w=${w#"("}; chain=0; if [ "$sub" -eq 0 ]; then sub=1 saved=$here saved_prev=$prev; else nest=1; fi ;;
            "{"*) w=${w#"{"}; chain=0 ;;
            *) break ;;
          esac
        done
        words[i]=$w
        case "$w" in
          "" | *=* | command) i=$((i + 1)) ;;
          env | sudo | nohup | time) via=1 i=$((i + 1)) ;;
          *) break ;;
        esac
      done
      [ "$i" -lt "$n" ] || continue
      case "${words[i]}" in
        cd)
          # A directory it cannot resolve or that does not exist leaves $here as
          # it was. cd - with no previous directory goes back to the session's.
          to=${words[i + 1]:-}
          [ "$to" != -- ] || to=${words[i + 2]:-}
          case "$to" in
            "") to=${HOME:-} ;;
            -) to=${prev:-$cwd} ;;
            -*) to="" ;;
            *) resolve "$to" ;;
          esac
          chain=0
          if [ -n "$to" ] && [ -d "$to" ]; then
            prev=$here here=$to
            if [ "$pass" = quoted ] && [ "$via" -eq 0 ] && [ "$nest" -eq 0 ]; then
              case "$join" in "$pipe" | "$redir") ;; *) chain=1 ;; esac
            fi
          fi
          ;;
        gh | */gh)
          # Flags may come before pr and before create.
          i=$((i + 1))
          skip_flags
          [ "${words[i]:-}" = pr ] || continue
          i=$((i + 1))
          skip_flags
          case "${words[i]:-}" in create | new) ;; *) continue ;; esac
          if [ "$pass" = plain ] && covered; then continue; fi
          unclean "$here"
          instructions "$here"
          if [ "$chain" -eq 0 ] && [ "$here" != "$cwd" ]; then
            unclean "$cwd"
            instructions "$cwd"
          fi
          ;;
      esac
    done <<<"$text"
  done
}

check() {
  local rc
  [ "$tool" = Bash ] || verdict pass
  cmd=$(field '.tool_input.command') || verdict deny "no-hook-bypass could not read the command, so it blocks this call."
  case "$cmd" in *git* | *gh*) ;; *) verdict pass ;; esac
  shell_commands "$cmd" || verdict deny "no-hook-bypass could not split the command, so it blocks this call."
  real_commands
  rc=$?
  [ "$rc" != 2 ] || verdict deny "$bypass"
  [ "$rc" = 0 ] || verdict pass
  cwd=$(field '.cwd') || cwd=""
  [ -n "$cwd" ] || cwd=$PWD
  pr_checks
  [ -n "$reasons" ] || verdict pass
  verdict ask "${reasons//$nl/ }"
}

run_hook check

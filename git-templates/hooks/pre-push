#!/usr/bin/env bash
# Mentat's git pre-push template, for a core.hooksPath that names this folder. It reads
# every ref line git sends and refuses the push when any destination is the default
# branch of the repository pushed to (from git ls-remote --symref <push URL> HEAD, else
# refs/remotes/<remote>/HEAD, else main and master), whether an update, a force push or
# a deletion, and when the outgoing commits add a likely secret or the scan cannot run.
# Each commit is scanned on its own diff as text, root commits and files git treats as
# binary included; a merge commit on what its resolution changed from git's own merge of
# its parents (--diff-merges=remerge, git 2.36 or later; an older git refuses). Other
# branches and tags pass, force pushes and deletions included. Then it runs the
# repository's own pre-push hook (own-hook.sh) with the same arguments and ref lines.
# Git hooks cannot ask, so each check refuses. This is a net for common mistakes, not a
# security boundary.
set -uo pipefail

here=${0%/*}
scan=$here/../scan
remote=${1:-origin}
# Git passes the URL it pushes to, which a pushurl can make another repository than
# the one the remote fetches from.
dest=${2:-$remote}
refuse() { printf 'Mentat: push refused: %s\n' "$1" >&2; exit 1; }

# The ref lines, read twice: once here, once by the repository's own hook. The file is
# removed as soon as both are open.
lines=$(mktemp "${TMPDIR:-/tmp}/mentat-pre-push.XXXXXX") || refuse "could not save the ref lines git sent."
if ! cat >"$lines" || ! exec 3<"$lines" 4<"$lines"; then
  rm -f "$lines"
  refuse "could not save the ref lines git sent."
fi
rm -f "$lines"

defaults=$(git ls-remote --symref "$dest" HEAD 2>/dev/null |
  awk '$1 == "ref:" && $3 == "HEAD" && sub(/^refs\/heads\//, "", $2) { print $2; exit }')
if [ -z "$defaults" ]; then
  defaults=$(git symbolic-ref --short "refs/remotes/$remote/HEAD" 2>/dev/null) && defaults=${defaults#"$remote"/}
fi
[ -n "$defaults" ] || defaults="main master"

diffs=""
while read -r _ lsha rref rsha <&3; do
  [ -n "$rref" ] || continue
  for d in $defaults; do
    if [ "$rref" = "refs/heads/$d" ]; then
      if [ "${lsha//0/}" = "" ]; then refuse "agents never delete the default branch ($d)."; fi
      refuse "agents never push to the default branch ($d); push a branch and open a pull request."
    fi
  done
  [ "${lsha//0/}" != "" ] || continue
  if [ "${rsha//0/}" != "" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    range=("$rsha..$lsha")
  else
    range=("$lsha" --not "--remotes=$remote")
  fi
  out=$(git -c core.quotePath=false log -p --root --text --diff-merges=remerge --no-relative --no-ext-diff --no-textconv --no-color -U0 \
    --src-prefix=a/ --dst-prefix=b/ --format='commit %H' "${range[@]}" --) ||
    refuse "git could not list the outgoing commits of $rref, so they were not scanned for secrets."
  [ -z "$out" ] || diffs+=$out$'\n'
done
exec 3<&-

hits=$(printf '%s' "$diffs" | "$scan")
case $? in
  0) ;;
  1) refuse "gitleaks flags a likely secret in the outgoing commits:"$'\n'"$hits"$'\n'"Remove it from the branch's history, or ask the maintainer to push it." ;;
  *) refuse "the secret scan of the outgoing commits could not run (run mentat check)." ;;
esac
# shellcheck source=/dev/null
{ [ -f "$here/../own-hook.sh" ] && . "$here/../own-hook.sh"; } ||
  refuse "own-hook.sh could not be loaded, so the repository's own hook could not run (run mentat check)."
own_hook pre-push "$@" <&4 4<&-

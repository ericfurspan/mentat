#!/usr/bin/env bash
# Mentat's chain-only git hook template, one copy per hook name Mentat does not check,
# for a core.hooksPath that names this folder: it runs the repository's own hook of
# this file's name (own-hook.sh), with the same arguments, stdin and exit status. There
# is none for reference-transaction or post-index-change: git runs them on every ref
# update and index write, too often to start one, so a repository's own copies of those
# two do not run for agents.
set -uo pipefail

here=${0%/*}
name=${0##*/}
# shellcheck source=/dev/null
{ [ -f "$here/../own-hook.sh" ] && . "$here/../own-hook.sh"; } || {
  printf 'Mentat: %s refused: own-hook.sh could not be loaded, so the repository'"'"'s own hook could not run (run mentat check).\n' "$name" >&2
  exit 1
}
own_hook "$name" "$@"

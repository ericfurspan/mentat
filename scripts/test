#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS and in CI on Linux.
# A tool missing locally is reported as SKIP; in CI (CI=true) it fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }
skip() {
  if [ "${CI:-}" = "true" ]; then
    fail "$1 (required in CI)"
  else
    printf 'SKIP: %s\n' "$1"
  fi
}

# JSON and YAML files parse with strict parsers. JSON must be exactly one
# standard value (no NaN, Infinity or leading zeros); every YAML document counts.
if command -v ruby >/dev/null 2>&1; then
  if ! data_files=$(git ls-files --cached --others --exclude-standard '*.json' '*.yml' '*.yaml'); then
    fail "could not list JSON and YAML files"
  else
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$f" in
        *.json) parse='JSON.parse(File.read(ARGV[0]))' ;;
        *) parse='YAML.load_stream(File.read(ARGV[0]))' ;;
      esac
      if ruby -rjson -ryaml -e "$parse" "$f" >/dev/null 2>&1; then
        pass "$f parses"
      else
        fail "$f does not parse"
      fi
    done <<< "$data_files"
  fi
else
  skip "ruby not installed, JSON and YAML not checked"
fi

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# The output style the project selects must exist under that exact name.
if command -v jq >/dev/null 2>&1; then
  # jq returns the name only if it is a non-empty string with no line breaks,
  # so the shell never trims or splits it before the exact match.
  style=$(jq -r '.outputStyle | select(type == "string" and length > 0 and (test("[\\r\\n]") | not))' \
    .claude/settings.json 2>/dev/null)
  if [ -n "$style" ] && grep -qxF "name: $style" .claude/output-styles/*.md 2>/dev/null; then
    pass "output style '$style' exists"
  else
    fail "no output style named '$style' in .claude/output-styles"
  fi
else
  skip "jq not installed, output style setting not checked"
fi

# The SessionStart hook prints rules.md unchanged, within Claude Code's
# 10,000-character limit for context a hook adds.
if hook_out=$(hooks/session-start); then
  if [ "$hook_out" != "$(cat rules.md)" ]; then
    fail "hooks/session-start output differs from rules.md"
  elif [ "${#hook_out}" -ge 10000 ]; then
    fail "hooks/session-start prints ${#hook_out} characters (limit 10000)"
  else
    pass "hooks/session-start prints rules.md (${#hook_out} characters)"
  fi
else
  fail "hooks/session-start exited non-zero"
fi

# Shell scripts pass shellcheck.
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck scripts/test hooks/session-start; then
    pass "shellcheck scripts/test hooks/session-start"
  else
    fail "shellcheck scripts/test hooks/session-start"
  fi
else
  skip "shellcheck not installed, shell scripts not checked"
fi

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed\n' "$failures"
  exit 1
fi
printf 'All checks passed\n'

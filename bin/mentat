#!/usr/bin/env bash
# mentat: Mentat's command line. Usage errors exit 64.
#   mentat review <PR>  Reviews the pull request's head with local Codex at once, then
#     waits for CI on that head and posts the result only once CI passed. 0 no findings,
#     2 findings posted (link printed), 1 not reviewed (error, incomplete review or no
#     result in time), 3 the head moved, 4 CI did not pass on the head (failing or
#     unfinished checks printed, then the review, which is not posted and not a round).
#     When no CI check ran on the head, a line says so.
#     `mentat review --local <PR>` is the same. A comment that holds a local path or a
#     private name, in a public repository, is kept in a local file and not posted (exit 1).
#   mentat review --grok <PR>  The same with Grok, if installed: its start comment and
#     review are posted only once CI passed on the head it reviewed. Same exit codes.
#     Grok's time limit is MENTAT_GROK_TIMEOUT_SECONDS (default 1800). Set
#     MENTAT_GROK_REASONING_EFFORT to pass --reasoning-effort to Grok (weigh too);
#     unset leaves Grok's default.
#     Both take `--request <file>` and `--require-ci` after the mode, if any, in either order:
#     `mentat review --request <file> <PR>`. With --require-ci, a head where no CI check ran
#     exits 4 like failed CI, posting nothing; without it, such a head is reviewed and posted.
#     The file holds the agreed request (what to build, what to leave alone, how it is checked)
#     for a repository that keeps it outside GitHub. It is read once, before the review;
#     a missing, unreadable or blank file is not reviewed. It goes to the reviewing tool as
#     its own data block, and the posted comment records a fingerprint of it.
#   mentat ci <PR>  Waits for CI on the pull request's head the same way, and
#     reviews nothing. 0 CI passed (or there is none), 1 could not read, 3 the head
#     moved, 4 CI did not pass (failing or unfinished checks printed).
#   mentat status <PR> [--request <file>]  Prints, read-only, one line of the pull request's
#     review state from the comments the review commands posted as this gh account: the head
#     commit, the local Codex rounds (and Claude review rounds when present), whether the head
#     is the last reviewed commit, the Grok state (none, running, done or did not finish) and
#     the CI state (none, running, passed or failed). With --request, also whether the last
#     review's spec fingerprint matches the file. Posts nothing. 0 printed, 1 could not read.
#   The review tools setting: ~/.config/mentat/reviewers lists the tools weigh
#     and consult run, any of claude, codex and grok; missing or empty runs Codex and Grok.
#     Another word stops those commands (64). ~/.config/mentat/claude-model may name the
#     Claude model; otherwise it is the most capable one in a family other than the
#     builder's (prompts/builder.md). Claude runs headless in safe mode, with no settings
#     files, no MCP servers and no saved session, in a rebuilt environment, and each of its
#     replies names the builder and reviewer models.
#   mentat weigh <idea file>  Has Codex and Grok (or the setting's tools) each judge an idea,
#     at HEAD and in parallel, and prints each reply with its verdict line. Nothing is posted.
#     0 at least one tool delivered a verdict, 1 none did, 5 the checkout is behind origin's
#     default branch (not a tool failure: update it and run again), 64 usage. It first
#     fetches origin's default branch into a private ref, leaving origin/<default> and
#     FETCH_HEAD as they are; when that fails or there is no origin, a local
#     origin/<default> still counts, and the output says when freshness could not be
#     checked. Time limits:
#     MENTAT_REVIEW_TIMEOUT_SECONDS (Codex and Claude) and MENTAT_GROK_TIMEOUT_SECONDS (Grok);
#     MENTAT_GROK_REASONING_EFFORT sets Grok's effort. Grok may use its backend web search here
#     (never in review); the local fetch tool is denied. Claude reads an export with file tools only.
#   mentat consult <question file>  Has Codex and Grok (or the setting's tools) each answer any
#     question, in parallel, each in an empty folder with no files and no repository (it works
#     outside git), with web search on. Prints each reply with its CONSULT line. Nothing is
#     posted. 0 at least one tool answered, 1 none did, 64 usage. Same time limits and effort
#     variables as weigh. Grok and Claude have web search alone; Grok's local fetch tool is denied.
#   mentat check  Checks, read-only, what Mentat itself needs: tools, each review tool in
#     effect, gh signed in, the repository readable; prints the codex and grok versions, and warns
#     when the private word list is unreadable, the list misses a private repository
#     this account can reach, by count only, the Mentat plugin is installed at different
#     versions, or, with ~/.config/mentat/warn-kept-branches present, the repository keeps
#     head branches after merge.
#     0 Mentat can work (warnings printed), 1 it cannot.
set -uo pipefail

# Find this file's real location through any symlinks (macOS's bash 3.2 and BSD
# readlink have no `readlink -f`), then load the code beside it.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd) || exit 1
  src=$(readlink "$src") || exit 1
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd) || exit 1
for lib in shared publish codex grok claude parallel weigh consult check status; do
  if [ ! -f "$root/lib/$lib.sh" ]; then
    printf 'mentat: missing %s\n' "$root/lib/$lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$root/lib/$lib.sh" || exit 1
done

case "${1:-}" in
  review)
    shift
    # Exactly one pull request number, after --local or --grok if given: "review 7
    # --grok" would otherwise run local Codex.
    mode=local
    case "${1:-}" in --local) shift ;; --grok) shift; mode=grok ;; esac
    # --request <file> and --require-ci, each at most once, in either order.
    request_file="" request_given=no require_ci=no
    while :; do
      case "${1:-}" in
        --request)
          [ "$request_given" = no ] && [ $# -ge 2 ] || die "usage: mentat review [--local | --grok] [--request <file>] [--require-ci] <pull request number>" 64
          # shellcheck disable=SC2034 # read by read_request in lib/shared.sh
          request_file=$2 request_given=yes; shift 2 ;;
        --require-ci)
          [ "$require_ci" = no ] || die "usage: mentat review [--local | --grok] [--request <file>] [--require-ci] <pull request number>" 64
          require_ci=yes; shift ;;
        *) break ;;
      esac
    done
    [ $# -eq 1 ] || die "usage: mentat review [--local | --grok] [--request <file>] [--require-ci] <pull request number>" 64
    case "$mode" in grok) review_grok "$@" ;; *) review_local "$@" ;; esac ;;
  ci) shift; [ $# -eq 1 ] || die "usage: mentat ci <pull request number>" 64; ci "$@" ;;
  status) shift; status "$@" ;;
  weigh) shift; weigh "$@" ;;
  consult) shift; consult "$@" ;;
  check) shift; check "$@" ;;
  *) die "usage: mentat review [--local | --grok] [--request <file>] [--require-ci] <pull request number> | mentat ci <pull request number> | mentat status <pull request number> [--request <file>] | mentat weigh <idea file> | mentat consult <question file> | mentat check" 64 ;;
esac

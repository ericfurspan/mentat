#!/usr/bin/env bash
# mentat: Mentat's command line. Usage errors exit 64.
#   mentat review <PR>  Reviews the pull request's head with local Codex at once, then
#     waits for CI on that head and posts the result only once CI passed. 0 no findings,
#     2 findings posted (link printed), 1 not reviewed (error, incomplete review or no
#     result in time), 3 the head moved, 4 CI did not pass on the head (failing or
#     unfinished checks printed, then the review, which is not posted and not a round).
#     When no CI check ran on the head, a line says so.
#     `mentat review --local <PR>` is the same. A comment that holds a local path or a
#     private name, in a public repository, is kept in a local file and not posted (exit 1).
#   mentat review --grok <PR>  The same with Grok, if installed: its start comment and
#     review are posted only once CI passed on the head it reviewed. Same exit codes.
#     It runs once per pull request: this gh account's own start comment refuses another.
#     `mentat review --grok --stop <PR>` is the one other run, also once per pull request:
#     the same review, whose comments say "Grok stop review" in place of "Grok review".
#     A plain --grok is refused once this account's stop review started.
#     Grok's time limit is MENTAT_GROK_TIMEOUT_SECONDS (default 1800). Set
#     MENTAT_GROK_REASONING_EFFORT to pass --reasoning-effort to Grok (second-opinion too);
#     unset leaves Grok's default.
#     Both take `--request <file>` and `--require-ci` after the mode, if any, in any order
#     with --stop:
#     `mentat review --request <file> <PR>`. With --require-ci, a head where no CI check ran
#     exits 4 like failed CI, posting nothing; without it, such a head is reviewed and posted.
#     The file holds the agreed request (what to build, what to leave alone, how it is checked)
#     for a repository that keeps it outside GitHub. It is read once, before the review;
#     a missing, unreadable or blank file is not reviewed. It goes to the reviewing tool as
#     its own data block, and the posted comment records a fingerprint of it.
#   mentat ci <PR>  Waits for CI on the pull request's head the same way, and
#     reviews nothing. 0 CI passed (or there is none), 1 could not read, 3 the head
#     moved, 4 CI did not pass (failing or unfinished checks printed).
#   mentat status <PR> [--request <file>]  Prints, read-only, one line of the pull request's
#     review state from the comments the review commands posted as this gh account: the head
#     commit, the local Codex rounds (and Claude review rounds when present), whether the head
#     is the last reviewed commit, the Grok state (none, running, done or did not finish), the
#     Grok stop review's (none, or running, done or did not finish on a commit, a done one
#     with its result and spec fingerprint) and the CI state (none, running, passed or failed). With --request, also whether the last
#     review's spec fingerprint matches the file. Posts nothing. 0 printed, 1 could not read.
#   mentat second-opinion <idea file>  Has Codex and Grok each
#     judge an idea, at HEAD and in parallel, and prints each reply with its verdict line.
#     Nothing is posted. 0 at least one tool delivered a verdict, 1 none did, 5 the checkout
#     is behind origin's default branch (not a tool failure: update it and run again),
#     64 usage. A run with a verdict appends the date, commit and idea file fingerprint to
#     <git common dir>/mentat/second-opinions, which stays on this machine. It first
#     fetches origin's default branch into a private ref, leaving origin/<default> and
#     FETCH_HEAD as they are; when that fails or there is no origin,
#     a local origin/<default> still counts, and the output says when freshness could not
#     be checked. Time limits:
#     MENTAT_REVIEW_TIMEOUT_SECONDS (Codex) and MENTAT_GROK_TIMEOUT_SECONDS (Grok);
#     MENTAT_GROK_REASONING_EFFORT sets Grok's effort. Grok may use its backend web search here
#     (never in review); the local fetch tool is denied.
#   mentat second-opinion --link <item id> <idea file>  Records the item as reviewed when
#     that record holds a run with a verdict on the idea file's current content. Calls no
#     model. 0 linked, 1 not (no such run, or not in a repository), 64 usage.
#   mentat second-opinion --web <question file>  Has Codex and Grok
#     each answer any question, in parallel, each in an empty folder with no files and no
#     repository (it works outside git), with web search on. Prints each reply with its
#     answer line. Nothing is posted. 0 at least one tool answered, 1 none did, 64 usage.
#     Same time limits and effort variables. Grok has web search alone; its
#     local fetch tool is denied.
#   mentat check  Checks, read-only, what Mentat itself needs: tools, the git hook
#     templates installed and the same as this copy when agents' git uses them
#     (lib/templates.sh), gh signed in, the repository readable; prints the codex and grok
#     versions, and warns when agents' git does not use the templates,
#     the private word list is unreadable, the list misses a private repository
#     this account can reach, by count only, the Mentat plugin is installed at different
#     versions, or, with ~/.config/mentat/warn-kept-branches present, the repository keeps
#     head branches after merge.
#     0 Mentat can work (warnings printed), 1 it cannot.
set -uo pipefail

# Find this file's real location through any symlinks (macOS's bash 3.2 and BSD
# readlink have no `readlink -f`), then load the code beside it.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd) || exit 1
  src=$(readlink "$src") || exit 1
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd) || exit 1
for lib in shared publish codex grok parallel second-opinion templates check status; do
  if [ ! -f "$root/lib/$lib.sh" ]; then
    printf 'mentat: missing %s\n' "$root/lib/$lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$root/lib/$lib.sh" || exit 1
done

case "${1:-}" in
  review)
    shift
    # Exactly one pull request number, after --local or --grok if given: "review 7
    # --grok" would otherwise run local Codex.
    mode=local
    case "${1:-}" in --local) shift ;; --grok) shift; mode=grok ;; esac
    # --request <file>, --require-ci and, with --grok only, --stop, each at most once, in any order.
    request_file="" request_given=no require_ci=no grok_stop=no
    while :; do
      case "${1:-}" in
        --stop)
          [ "$mode" = grok ] && [ "$grok_stop" = no ] || die "usage: mentat review [--local | --grok [--stop]] [--request <file>] [--require-ci] <pull request number>" 64
          grok_stop=yes; shift ;;
        --request)
          [ "$request_given" = no ] && [ $# -ge 2 ] || die "usage: mentat review [--local | --grok [--stop]] [--request <file>] [--require-ci] <pull request number>" 64
          # shellcheck disable=SC2034 # read by read_request in lib/shared.sh
          request_file=$2 request_given=yes; shift 2 ;;
        --require-ci)
          [ "$require_ci" = no ] || die "usage: mentat review [--local | --grok [--stop]] [--request <file>] [--require-ci] <pull request number>" 64
          require_ci=yes; shift ;;
        *) break ;;
      esac
    done
    [ $# -eq 1 ] || die "usage: mentat review [--local | --grok [--stop]] [--request <file>] [--require-ci] <pull request number>" 64
    case "$mode" in grok) review_grok "$@" ;; *) review_local "$@" ;; esac ;;
  ci) shift; [ $# -eq 1 ] || die "usage: mentat ci <pull request number>" 64; ci "$@" ;;
  status) shift; status "$@" ;;
  second-opinion) shift; second_opinion "$@" ;;
  check) shift; check "$@" ;;
  *) die "usage: mentat review [--local | --grok [--stop]] [--request <file>] [--require-ci] <pull request number> | mentat ci <pull request number> | mentat status <pull request number> [--request <file>] | mentat second-opinion [--web] <file> | mentat second-opinion --link <item id> <idea file> | mentat check" 64 ;;
esac

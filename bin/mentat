#!/usr/bin/env bash
# mentat: Mentat's command line. Usage errors exit 64.
#   mentat review <PR>  Waits for CI on the pull request's head, then reviews that head
#     with local Codex and posts the result. 0 no findings, 2 findings posted (link
#     printed), 1 not reviewed (error, incomplete review or no result in time), 3 the head
#     moved, 4 CI did not pass on the head (failing checks printed; nothing reviewed).
#     `mentat review --local <PR>` is the same. A comment that holds a local path or a
#     private name, in a public repository, is kept in a local file and not posted (exit 1).
#   mentat review --grok <PR>  Waits for CI the same way, then reviews the pull
#     request's head with Grok, if installed, and posts the result. Same exit codes.
#     Grok's time limit is MENTAT_GROK_TIMEOUT_SECONDS (default 1800). Set
#     MENTAT_GROK_REASONING_EFFORT to pass --reasoning-effort to Grok (weigh too);
#     unset leaves Grok's default.
#     Both take `--request <file>` after the mode, if any: `mentat review --request <file> <PR>`.
#     The file holds the agreed request (what to build, what to leave alone, how it is checked)
#     for a repository that keeps it outside GitHub. It is read once, before the wait for CI;
#     a missing, unreadable or blank file is not reviewed. It goes to the reviewing tool as
#     its own data block, and the posted comment records a fingerprint of it.
#   mentat ci <PR>  Waits for CI on the pull request's head the same way, and
#     reviews nothing. 0 CI passed (or there is none), 1 could not read, 3 the head
#     moved, 4 CI did not pass (failing or unfinished checks printed).
#   mentat status <PR> [--request <file>]  Prints, read-only, one line of the pull request's
#     review state from the comments the review commands posted as this gh account: the head
#     commit, the local Codex rounds (and Claude review rounds when present), whether the head
#     is the last reviewed commit, the Grok state (none, running, done or did not finish) and
#     the CI state (none, running, passed or failed). With --request, also whether the last
#     review's spec fingerprint matches the file. Posts nothing. 0 printed, 1 could not read.
#   mentat challenge <plan-file>  Has Codex challenge a written plan and prints the result.
#     0 challenge delivered (read the verdict), 1 not challenged.
#   mentat weigh <idea file>  Has Codex and Grok each judge an idea, at HEAD and in parallel,
#     and prints each reply with its verdict line. Nothing is posted. 0 at least one tool
#     delivered a verdict, 1 neither did, 64 usage. Time limits: MENTAT_REVIEW_TIMEOUT_SECONDS
#     (Codex) and MENTAT_GROK_TIMEOUT_SECONDS (Grok); MENTAT_GROK_REASONING_EFFORT sets Grok's effort.
#     Grok may use its backend web search here (never in review); the local fetch tool is denied.
#   mentat consult <question file>  Has Codex and Grok each answer any question, in parallel, each
#     in an empty folder with no files and no repository (it works outside git), with web search
#     on. Prints each reply with its CONSULT line. Nothing is posted. 0 at least one tool answered,
#     1 neither did, 64 usage. Same time limits and effort variables as weigh. Grok has web search
#     alone; its local fetch tool is denied.
#   mentat check  Checks, read-only, what Mentat itself needs: tools,
#     gh signed in, the repository readable; prints the codex and grok versions, and warns
#     when the repository keeps head branches after merge, the private word list is
#     missing or unreadable, the list misses a private repository this account can
#     reach, by count only, or the Mentat plugin is installed at different versions.
#     0 Mentat can work (warnings printed), 1 it cannot.
set -uo pipefail

# Find this file's real location through any symlinks (macOS's bash 3.2 and BSD
# readlink have no `readlink -f`), then load the code beside it.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd) || exit 1
  src=$(readlink "$src") || exit 1
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd) || exit 1
for lib in shared publish codex grok parallel weigh consult check status; do
  if [ ! -f "$root/lib/$lib.sh" ]; then
    printf 'mentat: missing %s\n' "$root/lib/$lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$root/lib/$lib.sh" || exit 1
done

case "${1:-}" in
  review)
    shift
    # Exactly one pull request number, after --local or --grok if given: "review 7
    # --grok" would otherwise run local Codex.
    mode=local
    case "${1:-}" in --local) shift ;; --grok) shift; mode=grok ;; esac
    request_file="" request_given=no
    if [ "${1:-}" = --request ]; then
      [ $# -ge 2 ] || die "usage: mentat review [--local | --grok] [--request <file>] <pull request number>" 64
      # shellcheck disable=SC2034 # read by read_request in lib/shared.sh
      request_file=$2 request_given=yes; shift 2
    fi
    [ $# -eq 1 ] || die "usage: mentat review [--local | --grok] [--request <file>] <pull request number>" 64
    case "$mode" in grok) review_grok "$@" ;; *) review_local "$@" ;; esac ;;
  ci) shift; [ $# -eq 1 ] || die "usage: mentat ci <pull request number>" 64; ci "$@" ;;
  status) shift; status "$@" ;;
  challenge) shift; challenge "$@" ;;
  weigh) shift; weigh "$@" ;;
  consult) shift; consult "$@" ;;
  check) shift; check "$@" ;;
  *) die "usage: mentat review [--local | --grok] [--request <file>] <pull request number> | mentat ci <pull request number> | mentat status <pull request number> [--request <file>] | mentat challenge <plan file> | mentat weigh <idea file> | mentat consult <question file> | mentat check" 64 ;;
esac

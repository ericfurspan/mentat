#!/usr/bin/env bash
# mentat: Mentat's command line. Usage errors exit 64.
#   mentat review <PR>  Waits for CI on the pull request's head, then comments
#     `@codex review`, which starts the Codex GitHub app's review of that head,
#     and waits for the result. 0 no findings, 2 findings posted (printed), 1 not
#     reviewed (app busy, error or no result in time), 3 the head moved, 4 CI did
#     not pass on the head (failing checks printed; nothing reviewed).
#   mentat review --local <PR>  Waits for CI the same way, then reviews the pull
#     request's head with local Codex and posts the result. Same exit codes.
#   mentat review --grok <PR>  Waits for CI the same way, then reviews the pull
#     request's head with Grok, if installed, and posts the result. Same exit codes.
#     Grok's time limit is MENTAT_GROK_TIMEOUT_SECONDS (default 1800).
#   mentat ci <PR>  Waits for CI on the pull request's head the same way, and
#     reviews nothing. 0 CI passed (or there is none), 1 could not read, 3 the head
#     moved, 4 CI did not pass (failing or unfinished checks printed).
#   mentat challenge <plan-file>  Has Codex challenge a written plan and prints the result.
#     0 challenge delivered (read the verdict), 1 not challenged.
#   mentat weigh <idea file>  Has Codex and Grok each judge an idea, at HEAD and in parallel,
#     and prints each reply with its verdict line. Nothing is posted. 0 at least one tool
#     delivered a verdict, 1 neither did, 64 usage. Time limits: MENTAT_REVIEW_TIMEOUT_SECONDS
#     (Codex) and MENTAT_GROK_TIMEOUT_SECONDS (Grok).
#   mentat check  Checks, read-only, what Mentat itself needs: tools,
#     gh signed in, the repository readable; prints the codex and grok versions. 0 Mentat
#     can work (warnings printed), 1 it cannot.
set -uo pipefail

# Find this file's real location through any symlinks (macOS's bash 3.2 and BSD
# readlink have no `readlink -f`), then load the code beside it.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd) || exit 1
  src=$(readlink "$src") || exit 1
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd) || exit 1
for lib in shared codex grok weigh check; do
  if [ ! -f "$root/lib/$lib.sh" ]; then
    printf 'mentat: missing %s\n' "$root/lib/$lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$root/lib/$lib.sh" || exit 1
done

case "${1:-}" in
  review)
    shift
    # Exactly one pull request number, after --local or --grok if given: "review 7
    # --local" would otherwise run the app path.
    mode=app
    case "${1:-}" in --local) shift; mode=local ;; --grok) shift; mode=grok ;; esac
    [ $# -eq 1 ] || die "usage: mentat review [--local | --grok] <pull request number>" 64
    case "$mode" in local) review_local "$@" ;; grok) review_grok "$@" ;; *) review "$@" ;; esac ;;
  ci) shift; [ $# -eq 1 ] || die "usage: mentat ci <pull request number>" 64; ci "$@" ;;
  challenge) shift; challenge "$@" ;;
  weigh) shift; weigh "$@" ;;
  check) shift; check "$@" ;;
  *) die "usage: mentat review [--local | --grok] <pull request number> | mentat ci <pull request number> | mentat challenge <plan file> | mentat weigh <idea file> | mentat check" 64 ;;
esac

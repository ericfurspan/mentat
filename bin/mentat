#!/usr/bin/env bash
# mentat: Mentat's command line. Usage errors exit 64. Its settings, the MENTAT_* names
# below, with each one's default and what an empty value means: docs/settings.md.
#   mentat review <PR>  Reviews the pull request's head with a headless Claude at once, then
#     waits for CI on that head and posts the result only once CI passed. 0 no findings,
#     2 findings posted (link printed), 1 not reviewed (error, incomplete review or no
#     result in time), 3 the head moved, 4 CI did not pass on the head (failing or
#     unfinished checks printed, then the review, which is not posted and not a round),
#     7 the pull request already has the round limit's completed local rounds (as mentat
#     status counts them): nothing ran or was posted; --codex and --grok are never refused.
#     When no CI check ran on the head, a line says so.
#     A comment that holds a local path or a private name, in a public repository, is
#     kept in a local file and not posted (exit 1).
#     Each reviewer's failures in a row on this machine (its tool failing, timing out or
#     giving no usable reply or result line, and a Grok sign-in refusal) are kept in
#     reviewer-failures-<claude|codex|grok> in Mentat's cache folder (XDG_CACHE_HOME, else
#     ~/.cache); a checked reply ends the row. A Grok sign-in refusal, a Grok refusal for
#     usage or billing when no earlier failure in the row was one (once per row of
#     failures in this machine's record, not per outage), and any other failure from the
#     second in a row, also print one line starting "mentat: tell the maintainer now:"
#     with the reviewer, the count, the pull requests and the reason (still exit 1).
#     Claude runs in a fresh context, with read tools only, at --effort high, on
#     MENTAT_REVIEW_MODEL, or, with MENTAT_FIRST_REVIEW_MODEL set, on that model while the pull request has no local round (as mentat status counts them), and,
#     when Claude reports that no model ran, once more on the review default if that is
#     another model, whatever MENTAT_REVIEW_MODEL names; the record names the model that
#     ran, and MENTAT_FIRST_REVIEW_MODEL when it chose it. Its time limit is
#     MENTAT_REVIEW_TIMEOUT_SECONDS. The round limit is MENTAT_REVIEW_ROUNDS (empty counts as
#     unset; any other value but a whole number of 1 or more exits 64), which the record names.
#   mentat review --codex <PR>  The same with local Codex in place of Claude, on the model
#     MENTAT_CODEX_MODEL names when it is set, else Codex's own default model.
#     --codex and --grok first read whether outside reviewers are on here, as mentat
#     reviewers does; unless they are on, they print why, post nothing and exit 6.
#   mentat review --grok <PR>  The same with Grok, if installed: its start comment and
#     review are posted only once CI passed on the head it reviewed. Same exit codes.
#     It runs once per pull request: this gh account's own start comment refuses another.
#     `mentat review --grok --stop <PR>` is the one other run, also once per pull request:
#     the same review, whose comments say "Grok stop review" in place of "Grok review".
#     A plain --grok is refused once this account's stop review started.
#     Grok's time limit is MENTAT_GROK_TIMEOUT_SECONDS. Grok runs with --reasoning-effort
#     MENTAT_GROK_REASONING_EFFORT, in reviews and second opinions alike; the review's record
#     names the level asked for.
#     All take `--request <file>` and `--require-ci` after the mode, if any, in any order
#     with --stop:
#     `mentat review --request <file> <PR>`. With --require-ci, a head where no CI check ran,
#     or a pull request that conflicts with its base branch or whose merge state cannot be
#     read, exits 4 like failed CI, posting nothing; without it, such a head is reviewed and posted.
#     The file holds the agreed request (what to build, what to leave alone, how it is checked)
#     for a repository that keeps it outside GitHub. It is read once, before the review;
#     a missing, unreadable or blank file is not reviewed. It goes to the reviewing tool as
#     its own data block, and the posted comment records a fingerprint of it.
#   mentat ci <PR>  Waits for CI on the pull request's head the same way, and
#     reviews nothing. 0 CI passed (or there is none), 1 could not read, 3 the head
#     moved, 4 CI did not pass (failing or unfinished checks printed).
#   mentat status <PR> [--request <file>]  Prints, read-only, one line of the pull request's
#     review state from the comments the review commands posted as this gh account: the head
#     commit, the local rounds (completed Local Claude reviews; a Codex review is not a
#     round) against the limit in force (MENTAT_REVIEW_ROUNDS, as for review), whether the
#     head is the last commit Claude
#     reviewed, the Grok state (none, running, done or did not finish), the
#     Grok stop review's (none, or running, done or did not finish on a commit, a done one
#     with its result and spec fingerprint), the Codex review's on the last commit Claude
#     reviewed (none, did not finish on it, or done on it with its result and spec
#     fingerprint) and the CI state (none, running, passed or failed). With --request, also whether the last
#     Claude review's spec fingerprint matches the file, and a done Codex review's. Then the
#     repository owner's review, the first that holds: no single owner (an organization owns
#     the repository), author, approved on head (their latest submitted review), requested or
#     not requested. Last, the calls section: present when the description has a heading
#     "Calls made without the maintainer" at any level, else missing. Either is unknown
#     (<why>) when a read it needs fails, which stops nothing else.
#     Posts nothing. 0 printed, 1 could not read.
#   mentat reviewers  Prints whether outside reviewers (Codex and Grok) are on in this
#     repository, on one line: "reviewers: on", "reviewers: off" or "reviewers: unknown -
#     <reason>". Only .claude/settings.json on origin's default branch counts: on when it
#     sets enabledPlugins "mentat-reviewers@mentat" to true; off when that is false or
#     absent; unknown when it cannot be read or is anything else, or the default branch
#     cannot be found or fetched. It fetches that branch into a private ref, deleted once
#     read, leaving origin/<default> and FETCH_HEAD as they are. Calls no gh. 0 for each
#     state, 64 usage.
#   mentat second-opinion <idea file>  Has Codex and Grok each
#     judge an idea, at HEAD and in parallel, and prints each reply with its verdict line.
#     Nothing is posted. 0 at least one tool delivered a verdict, 1 none did, 5 the checkout
#     is behind origin's default branch (not a tool failure: update it and run again),
#     6 outside reviewers are not on here (not a tool failure: nothing was sent), 64 usage.
#     After the usage checks it reads whether outside reviewers are on here, as review
#     --codex does; unless they are on, it prints why, sends nothing and exits 6. It then
#     fetches origin's default branch into a private ref, leaving origin/<default> and
#     FETCH_HEAD as they are. Time limits:
#     MENTAT_REVIEW_TIMEOUT_SECONDS (Codex) and MENTAT_GROK_TIMEOUT_SECONDS (Grok);
#     Codex runs on MENTAT_CODEX_MODEL when it is set, else its own default model;
#     Grok's effort is MENTAT_GROK_REASONING_EFFORT. Grok may use its backend web search here
#     (never in review); the local fetch tool is denied.
#   review --codex, review --grok and second-opinion belong to the mentat-reviewers module:
#     mentat hands each, with the arguments after its mode, to the module's entry
#     mentat-review-codex, mentat-review-grok or mentat-second-opinion, in this checkout's
#     plugins/mentat-reviewers/bin or else on PATH, and exits 64 with neither.
#   mentat check  Checks what Mentat itself needs, changing nothing but a temporary ref
#     (deleted after) that mentat reviewers' fetch uses: tools, the git
#     hooks installed and the same as this copy when agents' git uses them
#     (lib/git-hooks.sh), gh signed in, the repository readable, claude installed at a version
#     the merge hook and the review need; prints the Mentat modules installed, whether
#     outside reviewers are on here as mentat reviewers reads it, and whether codex and grok
#     are installed, and warns when outside reviewers are unknown or are on with codex or
#     grok missing, when agents' git does not use the git hooks, the private word list is unreadable, the
#     list misses a private repository this account can reach, by count only, the Mentat
#     plugin is installed at different versions, or, with ~/.config/mentat/warn-kept-branches
#     present, the repository keeps head branches after merge.
#     0 Mentat can work (warnings printed), 1 it cannot.
#   mentat fingerprint <file> [<expected>]  Prints the file's spec fingerprint, read as
#     review --request reads it (the first 12 hex characters of the SHA-256 of its text
#     without trailing newlines). With <expected>, prints both: 0 they match, 1 they differ.
#     2 the file is missing, unreadable or blank (no fingerprint printed), 64 usage.
#   mentat worktree branch <name>  In the current checkout, first checks for a local branch
#     <name>, then runs git fetch origin, then makes <name> from origin/<default> with no
#     upstream (the default branch found as mentat reviewers finds it). 0 made, 1 the branch
#     already exists (nothing fetched), 2 the fetch failed or the default branch could not be
#     found; no branch is made unless it exits 0. 64 usage.
#   mentat worktree snapshot [<checkout>]  Prints one line of four space-separated tokens
#     for the checkout, by default the main checkout (the folder above git's common
#     directory): "<branch|detached> <HEAD> <clean|dirty> <hash>", the hash the SHA-256 of
#     git status --porcelain -- ':(exclude).claude/worktrees'. Changes nothing, fetches
#     nothing. 0 printed, 2 the checkout cannot be read or is on a branch named detached
#     (which the line cannot tell apart from a detached HEAD), 64 usage.
#   mentat worktree verify <line> [<checkout>]  Compares the checkout (by default the main
#     checkout) with a snapshot line by the rule of "Main-checkout check" in
#     skills/build/helpers.md: unchanged when the branch and status hash are the noted ones
#     and HEAD is the noted one or moved only forward along origin/<branch> as last fetched
#     (no fetch); detached at the snapshot, only the same HEAD passes. 0 unchanged, 1 changed
#     (each difference named, with the current status paths on a status change), 2 the line
#     cannot be parsed or the checkout cannot be read or is on a branch named detached,
#     64 usage. It says when the snapshot's checkout was not clean, which makes the check
#     weaker.
#   mentat worktree cleanup <PR> <branch>  After a merge, in the current repository, follows
#     "After merge" in skills/build/helpers.md. It reads the pull request once (gh) and,
#     before changing anything, checks it is MERGED with head branch name <branch>; when the
#     local branch exists, that its commit is the pull request's head; when a worktree has
#     the branch, that it is not the checkout this runs in, that no other worktree is
#     nested under it, and that git status --porcelain --ignored prints nothing in it. Then
#     git worktree remove (never --force) and git branch -D; never the remote branch.
#     0 done, or nothing left to remove (said so), 1 the first failed check named (nothing
#     changed), git refused the removal (worktree and branch kept) or the branch delete
#     failed after it (the branch left named), 2 the pull request could not be read (gh
#     failing or signed out, no such number; nothing changed), 64 usage.
#   mentat state ...  The orchestrator's handover state, one JSON store at
#     <git common dir>/mentat/state.json shared by every worktree (missing reads as empty;
#     a write keeps fields it does not know). Each write runs under /usr/bin/lockf -k -t 10
#     on state.lock beside it, else flock -w 10, and renames a temporary file over the store.
#     Every state command: 1 a definite no or none (or a refusal, nothing changed), 2 it
#     cannot answer (outside a git repository, the store unreadable, empty, not one JSON
#     object or a field of the wrong type, naming the file; the lock not free within 10
#     seconds, naming it; neither lockf nor flock found; gh failing), 64 usage.
#   mentat state show  Prints the store.
#   mentat state orchestrator  Prints the recorded orchestrator id and "running" or "ended".
#     1 none recorded.
#   mentat state orchestrator set <id>  Records the id with no mark, replacing any earlier
#     id and its mark.
#   mentat state orchestrator ended <id>  Marks the recorded id no longer running; 1 when
#     <id> is not the recorded id (nothing changed).
#   mentat state owner [<item>]  Prints the recorded orchestrator id, 1 when none or it is
#     marked ended; with <item>, the item's recorded build session, 1 when none.
#   mentat state session add <id> <item>...  Records the build session and makes it each
#     item's session. session end <id> marks it ended (1 unknown). session list prints
#     "<id> <running|ended> <items>" per session, tab-separated.
#   mentat state item set <id> [--fingerprint F] [--stage S] [--session ID] [--pr N]
#     [--held-by TEXT]  Records the item's fields. Stages: held handed confirmed not-taken
#     pr ready merged closed; pr or ready with no PR number recorded or given is refused (1).
#     item get <id> prints it (1 unknown); item list [--stage S] prints "<id> <stage>" per item.
#   mentat state note add <hold|question> <text>  Records a note and prints its id (never
#     reused). note list [<kind>] prints "<id> <kind> <open|cleared> <text>" per note, in
#     order added, cleared ones included. note clear <id>: 1 unknown or already cleared.
#   mentat state can-dispatch  Reads the open pull requests (gh pr list --state open --limit
#     1000) and prints the waiting ones (first description line "**Status:** Ready" or
#     "**Status:** Not reviewed: fast track agreed by the maintainer", or at stage ready),
#     the items in flight (handed, confirmed, or pr with an open pull request not waiting),
#     the limit MENTAT_READY_LIMIT (a whole number of 1 or more, else the default, said once
#     on stderr when set but not one) and how many items may be handed over (the limit less
#     both, at least 0). 0 when at least 1, 1 when none, 2 gh failed (no count).
set -uo pipefail

# Find this file's real location through any symlinks (macOS's bash 3.2 and BSD
# readlink have no `readlink -f`), then load the code beside it.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd) || exit 1
  src=$(readlink "$src") || exit 1
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd) || exit 1
for lib in shared publish review git-hooks check status worktree state; do
  if [ ! -f "$root/lib/$lib.sh" ]; then
    printf 'mentat: missing %s\n' "$root/lib/$lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$root/lib/$lib.sh" || exit 1
done

# Hands the command to the reviewers module's entry mentat-$1, with the other arguments
# and MENTAT_ROOT set to this folder, where the entry finds the shared code: the copy that
# ships with this core while it exists, so core and module are one version, else the
# entry on PATH, where the module puts it when it is on, for a core that ships without
# the module folder. With neither, it exits 64.
handover() {
  local entry="mentat-$1"
  shift
  export MENTAT_ROOT="$root"
  if [ -x "$root/plugins/mentat-reviewers/bin/$entry" ]; then exec "$root/plugins/mentat-reviewers/bin/$entry" "$@"; fi
  if command -v "$entry" >/dev/null 2>&1; then exec "$entry" "$@"; fi
  die "this command needs the mentat-reviewers module, which was not found: turn it on and run again" 64
}

case "${1:-}" in
  review)
    shift
    case "${1:-}" in
      --codex) shift; handover review-codex "$@" ;;
      --grok) shift; handover review-grok "$@" ;;
    esac
    review_args "" "$@"
    round_limit
    # shellcheck disable=SC2154 # pr is set by review_args
    review_local claude "$pr" ;;
  ci) shift; [ $# -eq 1 ] || die "usage: mentat ci <pull request number>" 64; ci "$@" ;;
  status) shift; status "$@" ;;
  reviewers) shift; reviewers_command "$@" ;;
  second-opinion) shift; handover second-opinion "$@" ;;
  check) shift; check "$@" ;;
  fingerprint) shift; fingerprint_command "$@" ;;
  worktree) shift; worktree_command "$@" ;;
  state) shift; state_command "$@" ;;
  *) die "usage: mentat review [--codex | --grok [--stop]] [--request <file>] [--require-ci] <pull request number> | mentat ci <pull request number> | mentat status <pull request number> [--request <file>] | mentat reviewers | mentat second-opinion <file> | mentat check | mentat fingerprint <file> [<expected>] | mentat worktree branch <name> | mentat worktree snapshot [<checkout>] | mentat worktree verify <line> [<checkout>] | mentat worktree cleanup <pull request number> <branch> | mentat state show | mentat state orchestrator [set <id> | ended <id>] | mentat state owner [<item>] | mentat state session add <id> <item>... | mentat state session end <id> | mentat state session list | mentat state item set <id> [--fingerprint F] [--stage S] [--session ID] [--pr N] [--held-by TEXT] | mentat state item get <id> | mentat state item list [--stage S] | mentat state note add <hold|question> <text> | mentat state note list [<hold|question>] | mentat state note clear <id> | mentat state can-dispatch" 64 ;;
esac

#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS and in CI (.github/workflows/tests.yml).
# A tool it needs that is missing fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# CHANGELOG.md is refreshed on request, so parallel pull requests do not each edit it.
# shellcheck disable=SC2016 # the backticks are literal text in AGENTS.md
if grep -qxF -- '- `CHANGELOG.md` is refreshed only when the maintainer asks: one pull request adds dated lines, newest date first, written from the titles of the pull requests merged since its last entry.' AGENTS.md &&
  ! grep -qE '[Ee]very pull request.*CHANGELOG' AGENTS.md; then
  pass "AGENTS.md holds the changelog refresh rule and no per-pull-request changelog rule"
else
  fail "AGENTS.md lacks the changelog refresh rule or asks every pull request to edit CHANGELOG.md"
fi

# The reviewing tool is named (Codex, Grok or Claude), never "the reviewer".
# The scan skips tests/*.sh (they use `gh pr ready` as test input) and skills/*/CREDITS.md.
retired=$(git ls-files -z -- . ':!tests/run' ':!tests/*.sh' ':!skills/*/CREDITS.md' | xargs -0 grep -n -i -F -e 'the reviewer')
if [ -z "$retired" ]; then
  pass "no tracked prose says \"the reviewer\""
else
  fail "tracked prose says \"the reviewer\":"
  printf '%s\n' "$retired"
fi

# Outside the tracker adapters, rules, skills and the builder prompt name no tracker's own statuses, fields,
# labels or buttons. The list is the Linear adapter's own words; the core writes "triage" in lowercase.
linear_words="Waiting on you|Priority|No priority|Urgent|Mark as duplicate|Decline|Snooze|Linear's Accept|[a-z,;(] Triage|[(]Triage|Triage status"
tracker_words=$( { printf '%s\n' rules.md prompts/builder.md; git ls-files -- skills; } |
  grep -v -x -e skills/backlog/linear.md -e skills/backlog/github.md -e skills/linear/SKILL.md | tr '\n' '\0' |
  xargs -0 grep -n -E -e "$linear_words")
if [ -z "$tracker_words" ]; then
  pass "no tracker's own words outside the tracker adapters"
else
  fail "rules, skills or the builder prompt name a tracker's own words outside the adapters:"
  printf '%s\n' "$tracker_words"
fi

# The README stays short: at most 500 words by wc -w.
readme_words=$(wc -w <README.md | tr -d ' ')
if [ "$readme_words" -le 500 ]; then
  pass "README.md is at most 500 words ($readme_words)"
else
  fail "README.md is $readme_words words, over 500"
fi

# After "Ready to merge: #N", nothing reaches #N's branch until the maintainer answers a hold.
# Each file must keep the words that carry the obligation, not just the reply's template.
hold_check() {
  local file=$1 s
  shift
  for s in "$@"; do
    if ! grep -q -F -- "$s" "$file"; then
      fail "$file must give the hold after \"Ready to merge: #N\" (missing: $s)"
      return
    fi
  done
  pass "$file gives the hold after \"Ready to merge: #N\""
}
hold_check rules.md "pushes nothing to #N's branch until the maintainer answers a reply opening \"Hold #N: <reason>\""
hold_check skills/review/after-ready.md 'push nothing yet' '"Hold #N: <reason>" and end the turn'

# A fast track skips the Codex and Grok reviews only after a check of the complete final diff, says so in
# the status line, and is kept in the spec so a resumed or compacted session still has it.
fast_track_check() {
  local what=$1 s=$2
  if grep -q -F -- "$s" skills/review/fast-track.md; then
    pass "skills/review/fast-track.md gives the fast track's $what"
  else
    fail "skills/review/fast-track.md must give the fast track's $what (missing: $s)"
  fi
}
fast_track_check "turning on only by the maintainer" 'Claude Code never turns it on itself'
fast_track_check "check of the complete final diff" 'check the complete final diff'
fast_track_check "status line" 'Not reviewed: fast track agreed by the maintainer'
fast_track_check "record in the spec" 'one line in the spec, written when it was agreed'
fast_track_check "skipped reviewers" 'names every reviewer skipped, Codex and Grok (fast track agreed by the maintainer)'

# An open hand check blocks "Ready to merge: #N" (the review and Claude-only skills), and a push after Ready
# skips its review round only on the maintainer's yes, for a diff that changes no file a program runs.
phrase_check() {
  local file=$1 what=$2 s=$3
  if grep -q -F -- "$s" "$file"; then
    pass "$file gives $what"
  else
    fail "$file must give $what (missing: $s)"
  fi
}
phrase_check skills/review/SKILL.md "the pointer to after-ready.md" "Read \`after-ready.md\` in this skill's folder then, before acting on anything for #N, and again after a compaction."
phrase_check skills/review/SKILL.md "the pointer to ready-gate.md" "Then apply \`ready-gate.md\` in this skill's folder, and again after a compaction. With no open hand check, tell the maintainer in chat:"
phrase_check skills/review/ready-gate.md "the open hand check's status line" 'Blocked: <the hand check>'
phrase_check skills/review/ready-gate.md "the open hand check's one sentence in chat" 'the chat reply names the hand check in one plain sentence'
phrase_check skills/review/ready-gate.md "the open hand check's no merge line" 'Then say no "Ready to merge: #N"'
phrase_check skills/claude-review/SKILL.md "the open hand check's stop before the merge line" 'step 6 does not run'
phrase_check skills/claude-review/SKILL.md "step 6's pointer to the ready gate" "6. With no open hand check, follow \`../review/ready-gate.md\`."
phrase_check skills/claude-review/SKILL.md "step 5's hand check gate" "Then read \`../review/ready-gate.md\`, again after a compaction, and apply its hand check gate"
phrase_check skills/claude-review/SKILL.md "the Claude round's record of the spec fingerprint" 'Agreed request fingerprint: <12 hex>'
phrase_check skills/claude-review/SKILL.md "the waiver's comparison with the last Claude round's fingerprint" "or that comment has none, a Claude round runs instead"
phrase_check skills/review/ready-gate.md "the after-merge step that does not block" 'does not hold back "Ready to merge: #N"'
phrase_check skills/review/ready-gate.md "the open hand check as the maintainer's, until the Verification says they checked it" 'A hand check is open when a requirement of the spec is one the maintainer checks by hand and the Verification does not say the maintainer checked it and what they saw.'
phrase_check skills/review/ready-gate.md "that a builder's or Claude Code's own look does not close a hand check" "A builder's or Claude Code's own look does not close it."
phrase_check skills/review/ready-gate.md "the record of the maintainer's reported hand check" 'record in the Verification that the maintainer checked it and what they saw'
phrase_check skills/review/ready-gate.md "the open hand check's wait written in one place" "the wait is written as \`mentat:backlog\` \"Waits on the maintainer\" says (with a backlog item, only on it plus one line atop the pull request; an external item is marked waiting, not as a merge wait)"
phrase_check skills/pr/SKILL.md "the wait's one line above the summary with a backlog item" "A wait on the maintainer goes first in the body, above \`## Summary\`, as \`mentat:backlog\` \"Waits on the maintainer\" says: when the wait is on a backlog item (external or a GitHub issue), only its one line saying the steps are on the backlog item; with no backlog item, the wait itself."
phrase_check skills/backlog/SKILL.md "the spec's hand check requirement as the maintainer's" 'and one the maintainer checks by hand says so.'
phrase_check skills/pr/SKILL.md "the spec shape's hand check requirement as the maintainer's" 'and one the maintainer checks by hand says so;'
phrase_check skills/review/after-ready.md "the waived round's diff rule" 'changes no file a program runs, sources or fetches'
phrase_check skills/review/after-ready.md "the waived round's yes for that push" 'on their yes for that push'
phrase_check skills/review/after-ready.md "the waived round's status line" "the status line is \`Not reviewed: last push waived by the maintainer\`"
phrase_check skills/review/after-ready.md "the waived round's measure from the last reviewed head" 'the diff is measured from the last head a review covered'
phrase_check skills/review/after-ready.md "the waived round's normal round on doubt or a changed spec" 'any doubt, a pushed diff that differs from the proposal, or a change to the spec runs the normal round'
phrase_check skills/review/after-ready.md "what a waived push still runs and says" "it runs \`mentat ci\` and \`mentat:review\` \"Final check\", the push uses no round"
phrase_check skills/review/after-ready.md "the waived round's Verification line and merge message" 'a Verification line and the merge message say it was waived and not reviewed'
phrase_check skills/claude-review/SKILL.md "the open hand check's status line" 'Blocked: <the hand check>'
phrase_check skills/claude-review/SKILL.md "the waived round's exception" "(\`../review/after-ready.md\` \"Waived round\")"
phrase_check skills/claude-review/SKILL.md "the waived round's status line" "the status line is \`Not reviewed: last push waived by the maintainer\`"
phrase_check skills/claude-review/SKILL.md "that an earlier Claude round does not make a waived push Ready" 'an earlier Claude round does not make it Ready'
# Before "Ready to merge: #N", the owner is asked again unless they approved the current head.
phrase_check skills/review/ready-gate.md "the owner's review request unless they approved the head" "If the repository owner is not the author, request their review (\`gh pr edit <N> --add-reviewer <owner>\`) unless their latest submitted review is \`APPROVED\` with a commit oid equal to \`headRefOid\` (\`gh pr view <N> --json reviews,headRefOid\`; not \`reviewDecision\`); if that read fails, request it."

# A P0 or P1 finding from Codex or Grok that was answered, not fixed, is named in the final check.
phrase_check skills/review/SKILL.md "a serious finding answered, not fixed, in one Verification line" 'A P0 or P1 finding from Codex or Grok that was answered instead of fixed is named in one Verification line, which can be its line in step 4'"'"'s list; a pull request with none adds no line.'
phrase_check skills/review/SKILL.md "a serious finding in the one more sentence" 'or a P0 or P1 finding answered instead of fixed'
# Recorded advice against an item is quoted with "Ready to merge: #N" and answered or said to still hold, without blocking Ready.
phrase_check skills/review/SKILL.md "advice against the item in the list of added sentences" 'Add a sentence only for advice against the item (below), a weaker review'
phrase_check skills/review/SKILL.md "the advice comment read before the merge line and quoted" "Before that line, read the backlog item or issue for the latest advice comment (\`mentat:backlog\` \"Advice against\"); with one, its sentence quotes the recorded reason and says it still holds, or names the later recorded decision or spec change that answers it."

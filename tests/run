#!/usr/bin/env bash
# The repository's one test command. Runs locally and in CI on macOS.
# A tool missing locally is reported as SKIP; in CI (CI=true) it fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }
skip() {
  if [ "${CI:-}" = "true" ]; then
    fail "$1 (required in CI)"
  else
    printf 'SKIP: %s\n' "$1"
  fi
}

# JSON and YAML files parse with strict parsers. JSON must be exactly one
# standard value (no NaN, Infinity or leading zeros); every YAML document counts.
if command -v ruby >/dev/null 2>&1; then
  if ! data_files=$(git ls-files --cached --others --exclude-standard '*.json' '*.yml' '*.yaml'); then
    fail "could not list JSON and YAML files"
  else
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$f" in
        *.json) parse='JSON.parse(File.read(ARGV[0]))' ;;
        *) parse='YAML.load_stream(File.read(ARGV[0]))' ;;
      esac
      if ruby -rjson -ryaml -e "$parse" "$f" >/dev/null 2>&1; then
        pass "$f parses"
      else
        fail "$f does not parse"
      fi
    done <<< "$data_files"
  fi
else
  skip "ruby not installed, JSON and YAML not checked"
fi

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# The plugin's output style is named Mentat and is the owner's to choose, not
# forced; this repository turns the plugin on and chooses it.
if grep -qx 'name: Mentat' output-styles/mentat.md && ! grep -q '^force-for-plugin:' output-styles/mentat.md; then
  pass "output-styles/mentat.md is the Mentat style, not forced"
else
  fail "output-styles/mentat.md must set name: Mentat and must not set force-for-plugin"
fi
if command -v jq >/dev/null 2>&1; then
  if [ "$(jq -r '.enabledPlugins["mentat@mentat"]' .claude/settings.json)" = true ]; then
    pass ".claude/settings.json turns the plugin on"
  else
    fail ".claude/settings.json does not turn on mentat@mentat"
  fi
  if [ "$(jq -r '.outputStyle' .claude/settings.json)" = mentat:Mentat ]; then
    pass ".claude/settings.json chooses the Mentat style"
  else
    fail ".claude/settings.json does not choose the Mentat style (outputStyle mentat:Mentat)"
  fi
else
  skip "jq not installed, plugin setting not checked"
fi

# hooks.json runs the SessionStart hook, which is what loads the rules.
if command -v jq >/dev/null 2>&1; then
  if jq -e '.hooks.SessionStart[0].hooks[0].command | endswith("/hooks/session-start")' hooks/hooks.json >/dev/null; then
    pass "hooks.json runs hooks/session-start on SessionStart"
  else
    fail "hooks.json does not run hooks/session-start on SessionStart"
  fi
else
  skip "jq not installed, SessionStart wiring not checked"
fi

# The SessionStart hook prints rules.md unchanged, within Claude Code's
# 10,000-character limit for context a hook adds.
if hook_out=$(hooks/session-start); then
  if [ "$hook_out" != "$(cat rules.md)" ]; then
    fail "hooks/session-start output differs from rules.md"
  elif [ "${#hook_out}" -ge 10000 ]; then
    fail "hooks/session-start prints ${#hook_out} characters (limit 10000)"
  else
    pass "hooks/session-start prints rules.md (${#hook_out} characters)"
  fi
else
  fail "hooks/session-start exited non-zero"
fi

# Each skill's name matches its folder, which is how Claude Code finds it.
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  dir=${f%/SKILL.md}
  # Only the frontmatter block at the top of the file counts.
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="name: ${dir#skills/}" "$f"; then
    pass "$f is named ${dir#skills/}"
  else
    fail "$f must set name: ${dir#skills/}"
  fi
done

# rules.md names each workflow skill as a Skill tool call: every name it uses
# has a skill, and every skill the agent can call is named there. Each skill
# stays under 15,000 characters, a house limit toward Claude Code's budget for
# skill text kept after compaction.
while IFS= read -r name; do
  [ -n "$name" ] || continue
  if [ -f "skills/$name/SKILL.md" ]; then
    pass "rules.md names mentat:$name, which exists"
  else
    fail "rules.md names mentat:$name, but skills/$name/SKILL.md is missing"
  fi
done <<< "$(grep -o 'mentat:[a-z-]*' rules.md | sed 's/^mentat://' | sort -u)"
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  name=${f#skills/}; name=${name%/SKILL.md}
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "disable-model-invocation: true" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f is started by the maintainer, not named in rules.md"
  elif grep -q "mentat:$name\`" rules.md; then
    pass "$f is named in rules.md"
  else
    fail "$f can be called by the agent but rules.md does not name mentat:$name"
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -lt 15000 ]; then
    pass "$f is $size characters (limit 15000)"
  else
    fail "$f is $size characters (limit 15000)"
  fi
done

# The retro reads sessions through skills/retro/transcript, which redacts
# token-like strings. The values below are fake.
if command -v jq >/dev/null 2>&1 && command -v perl >/dev/null 2>&1; then
  fixture='{"type":"user","message":{"content":"use ghp_FAKEFAKEFAKEFAKE1234, password=notarealpass1 and AWS SecretAccessKey=fakeFAKEfakeFAKE0001 -----BEGIN RSA PRIVATE KEY-----\nFAKEPEMBODY\n-----END RSA PRIVATE KEY-----"}}
{"type":"user","message":{"content":"Authorization: Bearer FAKEBEARER0004"}}
{"type":"user","message":{"content":"-----BEGIN RSA PRIVATE KEY-----\nFAKELONGKEY0008'"$(printf 'A%.0s' $(seq 1 500))"'"}}
{"type":"user","message":{"content":"kept after the key"}}
{"type":"user","message":{"content":"password=\"cabin drift moist jewel\" set"}}
{"type":"user","message":{"content":"secret=\"four short'"'"'s words\" set"}}
{"type":"user","message":{"content":"pasted glpat-FAKEgitlab0006abcdefgh and wJalrXUtnFEMI/K7MDENG/bPxRfiCYFAKE0007 in plan 2026-10-06-skills-split-plan.md"}}
{"type":"user","message":{"content":[{"type":"tool_result","content":"FAKEOUTPUT0002"}]}}
{"type":"user","message":{"content":[{"type":"tool_result","is_error":true,"content":"FAKEERROR0005"}]}}
{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash","input":{"command":"echo FAKECOMMAND0003","description":"Print a value"}}]}}'
  if out=$(skills/retro/transcript /dev/stdin <<<"$fixture") && ! grep -qE 'FAKEFAKE|notarealpass|fakeFAKE|FAKEPEM|FAKEBEARER|FAKELONGKEY|cabin drift|four short|FAKEgitlab|FAKE0007|FAKEOUTPUT|FAKEERROR|FAKECOMMAND' <<<"$out" && grep -qx "result: error" <<<"$out" && grep -qx "user: kept after the key" <<<"$out" && grep -q "\[TRUNCATED\]" <<<"$out" && grep -q "2026-10-06-skills-split-plan.md" <<<"$out" &&
    grep -q "user: use <REDACTED>" <<<"$out" && grep -qx "result: ok" <<<"$out" && grep -qx "tool: Bash Print a value" <<<"$out"; then
    pass "skills/retro/transcript leaves out tool output and commands and redacts secrets"
  else
    fail "skills/retro/transcript lets tool output, a command or a secret through"
  fi
else
  skip "jq or perl not installed, skills/retro/transcript not checked"
fi

# mentat review, review --local, challenge and check behave as specified (stub
# gh and codex), and so does the merge hook.
if command -v jq >/dev/null 2>&1; then
  for t in tests/review.sh tests/review-local.sh tests/challenge.sh tests/check.sh tests/no-merge.sh; do
    if out=$("$t" 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; fail "$t"; fi
  done
else
  skip "jq not installed, mentat review, challenge, check and the hooks not tested"
fi

# The Mentat band and pane is a Claude Code mod: the plugin validates (warnings are fine,
# only a failure counts) and the mod's own tests, tests/*.test.tsx, pass.
if command -v claude >/dev/null 2>&1; then
  for sub in validate test; do
    if out=$(claude plugin "$sub" . 2>&1); then
      pass "claude plugin $sub ."
    else
      printf '%s\n' "$out"
      fail "claude plugin $sub ."
    fi
  done
else
  skip "claude not installed, the Mentat band and pane not validated or tested"
fi

# Shell scripts pass shellcheck.
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck tests/run hooks/session-start hooks/no-merge bin/mentat skills/retro/transcript tests/review.sh tests/review-local.sh tests/challenge.sh tests/check.sh tests/no-merge.sh; then
    pass "shellcheck tests/run hooks/session-start hooks/no-merge bin/mentat skills/retro/transcript tests/review.sh tests/review-local.sh tests/challenge.sh tests/check.sh tests/no-merge.sh"
  else
    fail "shellcheck tests/run hooks/session-start hooks/no-merge bin/mentat skills/retro/transcript tests/review.sh tests/review-local.sh tests/challenge.sh tests/check.sh tests/no-merge.sh"
  fi
else
  skip "shellcheck not installed, shell scripts not checked"
fi

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed\n' "$failures"
  exit 1
fi
printf 'All checks passed\n'

#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS and in CI (.github/workflows/tests.yml).
# A tool it needs that is missing fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }

# Outside the tracker adapters, rules, skills and the builder prompt name no tracker's own statuses, fields,
# labels or buttons. The list is the Linear adapter's own words; the core writes "triage" in lowercase.
linear_words="Waiting on you|Priority|No priority|Urgent|Mark as duplicate|Decline|Snooze|Linear's Accept|[a-z,;(] Triage|[(]Triage|Triage status"
tracker_words=$( { printf '%s\n' rules.md prompts/builder.md; git ls-files -- skills; } |
  grep -v -x -e skills/backlog/linear.md -e skills/backlog/github.md | tr '\n' '\0' |
  xargs -0 grep -n -E -e "$linear_words")
if [ -z "$tracker_words" ]; then
  pass "no tracker's own words outside the tracker adapters"
else
  fail "rules, skills or the builder prompt name a tracker's own words outside the adapters:"
  printf '%s\n' "$tracker_words"
fi

# The README stays short: at most 500 words by wc -w.
readme_words=$(wc -w <README.md | tr -d ' ')
if [ "$readme_words" -le 500 ]; then
  pass "README.md is at most 500 words ($readme_words)"
else
  fail "README.md is $readme_words words, over 500"
fi

# A triage sitting is started only by the maintainer and lists its arguments.
for s in 'name: triage' 'disable-model-invocation: true'; do
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="$s" skills/triage/SKILL.md; then
    pass "skills/triage/SKILL.md's frontmatter sets $s"
  else
    fail "skills/triage/SKILL.md's frontmatter must set $s"
  fi
done
if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^description: / && /Arguments: project names or all, source options, or brainstorm with a text or link\./ { found = 1; exit 0 } END { exit !found }' skills/triage/SKILL.md; then
  pass "skills/triage/SKILL.md's description lists its arguments"
else
  fail "skills/triage/SKILL.md's description must list its arguments (Arguments: project names or all, source options, or brainstorm with a text or link.)"
fi

# The / menu shows descriptions as plain text: no skill's description holds <, > or a backtick, and a menu
# skill's description value is one short line of at most 150 characters.
for f in skills/*/SKILL.md; do
  d=$(awk 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit } NR > 1 && /^description: / { print; exit }' "$f")
  if [ -z "$d" ]; then
    fail "$f's frontmatter must have a description line"
    continue
  fi
  case $d in
    *'<'* | *'>'* | *'`'*) fail "$f's description must hold no <, > or backtick" ;;
    *) pass "$f's description holds no <, > or backtick" ;;
  esac
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "user-invocable: false" { found = 1; exit 0 } END { exit !found }' "$f"; then
    continue
  fi
  v=${d#description: \"}
  v=${v%\"}
  if [ "${#v}" -le 150 ]; then
    pass "$f's menu description is at most 150 characters"
  else
    fail "$f's menu description must be at most 150 characters (it has ${#v})"
  fi
done

# Skills only agents call stay out of the / menu and stay callable by the agent.
for s in propose pr review backlog grill; do
  f=skills/$s/SKILL.md
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "user-invocable: false" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f's frontmatter sets user-invocable: false"
  else
    fail "$f's frontmatter must set user-invocable: false"
  fi
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^disable-model-invocation:/ { found = 1; exit 0 } END { exit !found }' "$f"; then
    fail "$f's frontmatter must not set disable-model-invocation, so the agent can call it"
  else
    pass "$f's frontmatter does not set disable-model-invocation"
  fi
done

# A planning session is started only by the maintainer and lists its argument.
for s in 'name: plan' 'disable-model-invocation: true'; do
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="$s" skills/plan/SKILL.md; then
    pass "skills/plan/SKILL.md's frontmatter sets $s"
  else
    fail "skills/plan/SKILL.md's frontmatter must set $s"
  fi
done
if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^description: / && /Arguments: a backlog item id\./ { found = 1; exit 0 } END { exit !found }' skills/plan/SKILL.md; then
  pass "skills/plan/SKILL.md's description lists its argument"
else
  fail "skills/plan/SKILL.md's description must list its argument (Arguments: a backlog item id.)"
fi

# The status report and a build run are started by a command and list their arguments.
for k in status build; do
  f=skills/$k/SKILL.md
  for s in "name: $k" 'disable-model-invocation: true'; do
    if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="$s" "$f"; then
      pass "$f's frontmatter sets $s"
    else
      fail "$f's frontmatter must set $s"
    fi
  done
done
if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^description: / && /Arguments: project names or all\./ { found = 1; exit 0 } END { exit !found }' skills/status/SKILL.md; then
  pass "skills/status/SKILL.md's description lists its arguments"
else
  fail "skills/status/SKILL.md's description must list its arguments (Arguments: project names or all.)"
fi
if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^description: / && /Arguments: backlog item ids\./ { found = 1; exit 0 } END { exit !found }' skills/build/SKILL.md; then
  pass "skills/build/SKILL.md's description lists its arguments"
else
  fail "skills/build/SKILL.md's description must list its arguments (Arguments: backlog item ids.)"
fi

# Instruction text loads into sessions, so it describes the build command's form and never writes a slash command bare.
bare=$(grep -nE '(^|[^`])/mentat:' rules.md skills/*/SKILL.md | cut -d: -f1,2)
if [ -n "$bare" ]; then
  fail "rules.md and skills must keep every /mentat: command name in backticks (bare at: $bare)"
else
  pass "rules.md and skills keep every /mentat: command name in backticks"
fi

# Reviews that run at once in one checkout must not share its record of the last fetch.
if grep -l FETCH_HEAD lib/*.sh; then
  fail "a script under lib/ reads FETCH_HEAD, which concurrent reviews in one checkout share"
else
  pass "no script under lib/ reads FETCH_HEAD"
fi

# mentat status reads review state from the headings the review commands write. Each heading it
# matches must still be written as below; a change here also changes lib/status.sh and tests/status.sh.
status_heading() {
  local file=$1 s=$2
  if grep -q -F -- "$s" "$file"; then
    pass "$file writes the heading mentat status reads: $s"
  else
    fail "$file no longer writes the heading mentat status reads (missing: $s); update lib/status.sh and tests/status.sh with it"
  fi
}
status_heading lib/codex.sh "printf '## Local Codex review of %s: %s, spec fingerprint %s\n\n' \"\$head\" \"\$(result_word \"\$result\")\" \"\$request_fp\""
status_heading lib/grok.sh "printf '## Local Grok review of %s: %s, spec fingerprint %s\n\n' \"\$head\" \"\$(result_word \"\$result\")\" \"\$request_fp\""
status_heading lib/grok.sh "gh pr comment \"\$pr\" --body \"Grok review started on \$head\""
status_heading lib/grok.sh "gh pr comment \"\$pr\" --body \"Grok review did not finish on \$head: \$1\""
status_heading lib/grok.sh "printf '## Local Grok stop review of %s: %s, spec fingerprint %s\n\n' \"\$head\" \"\$(result_word \"\$result\")\" \"\$request_fp\""
status_heading lib/grok.sh "gh pr comment \"\$pr\" --body \"Grok stop review started on \$head\""
status_heading lib/grok.sh "gh pr comment \"\$pr\" --body \"Grok stop review did not finish on \$head: \$1\""
status_heading lib/shared.sh '"REVIEW RESULT: NO FINDINGS") printf '"'"'no findings'"'"' ;;'
status_heading lib/shared.sh '"REVIEW RESULT: FINDINGS") printf '"'"'findings'"'"' ;;'
status_heading lib/shared.sh '"REVIEW RESULT: INCOMPLETE - "*) printf '"'"'incomplete'"'"' ;;'
status_heading skills/claude-review/SKILL.md "\`Claude review round <n> on <sha>\`"
status_heading skills/claude-review/SKILL.md "\`Agreed request fingerprint: <12 hex>\`"
# mentat status behaves as specified (stub gh), and its test passes shellcheck.
if command -v jq >/dev/null 2>&1; then
  if out=$(tests/status.sh 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; fail tests/status.sh; fi
else
  fail "jq not installed, mentat status not tested"
fi
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck tests/status.sh; then pass "shellcheck tests/status.sh"; else fail "shellcheck tests/status.sh"; fi
else
  fail "shellcheck not installed, tests/status.sh not checked"
fi

if [ -z "$(git ls-files .claude)" ]; then
  pass "nothing under .claude/ is version-controlled"
else
  fail ".claude/ must not be version-controlled (settings are the maintainer's own)"
fi

# hooks.json runs the SessionStart hook once, which is what loads rules.md.
if command -v jq >/dev/null 2>&1; then
  if jq -e '.hooks.SessionStart | length == 1 and (.[0].hooks | length == 1) and (.[0].hooks[0].command | endswith("/hooks/session-start"))' hooks/hooks.json >/dev/null; then
    pass "hooks.json runs hooks/session-start as its one SessionStart command"
  else
    fail "hooks.json must have exactly one SessionStart command, ending in /hooks/session-start"
  fi
else
  fail "jq not installed, SessionStart wiring not checked"
fi

# The SessionStart hook prints rules.md unchanged, and its complete output, trailing newline
# included, stays under a limit just above its current size, well under Claude Code's
# 10,000-character cap on a hook's output. Growth past the limit raises it in the same pull
# request, with the maintainer's agreement in the spec. It counts bytes, never fewer than
# characters, so it is never looser than the cap. These runs see an installed and current
# copy of the git hook templates and a stub gitleaks; tests/git-templates.sh covers the
# problem lines.
hook_file=$(mktemp) || exit 1
templates_copy=$(mktemp -d) || exit 1
cp -Rp git-templates "$templates_copy/" || exit 1
mkdir "$templates_copy/bin" && printf '#!/bin/sh\nexit 0\n' >"$templates_copy/bin/gitleaks" && chmod +x "$templates_copy/bin/gitleaks" || exit 1
path_before=$PATH
export PATH="$templates_copy/bin:$PATH" MENTAT_GIT_TEMPLATES_DIR="$templates_copy/git-templates"
if hooks/session-start >"$hook_file"; then
  hook_size=$(wc -c <"$hook_file" | tr -d ' ')
  if ! cmp -s "$hook_file" rules.md; then
    fail "hooks/session-start output differs from rules.md"
  elif [ "$hook_size" -ge 8900 ]; then
    fail "hooks/session-start prints $hook_size bytes, trailing newline included (limit 8900)"
  else
    pass "hooks/session-start prints rules.md, $hook_size bytes, trailing newline included (limit 8900)"
  fi
else
  fail "hooks/session-start exited non-zero"
fi
rm -f "$hook_file"
# The file is found relative to the plugin root, not the working directory.
hook_script=$PWD/hooks/session-start
if hook_out=$(cd /tmp && "$hook_script") && [ "$hook_out" = "$(cat rules.md)" ]; then
  pass "hooks/session-start prints the same from another directory"
else
  fail "hooks/session-start differs when run from another directory"
fi
rm -rf "$templates_copy"
PATH=$path_before
unset MENTAT_GIT_TEMPLATES_DIR
# Its worst case stays under the 10,000-character cap: rules.md at the largest size the
# limit above allows (8,899 bytes), the templates in use at a long path with missing,
# not executable and changed files, and neither gitleaks nor jq installed.
worst=$(mktemp -d) || exit 1
long=$worst
for i in 1 2 3 4; do long=$long/$(printf '%0200d' 0); done
mkdir -p "$worst/plugin/hooks" "$worst/plugin/lib" "$worst/bin" "$long" || exit 1
cp hooks/session-start "$worst/plugin/hooks/" && cp lib/templates.sh "$worst/plugin/lib/" && cp -Rp git-templates "$worst/plugin/" && cp -Rp git-templates "$long/" || exit 1
{ cat rules.md; head -c $((8899 - $(wc -c <rules.md))) /dev/zero | tr '\0' x; } >"$worst/plugin/rules.md"
rm "$long/git-templates/scan" "$long/git-templates/hooks/commit-msg"; chmod -x "$long/git-templates/hooks/post-merge"
for f in own-hook.sh hooks/pre-commit hooks/pre-push hooks/post-commit; do printf '# changed\n' >>"$long/git-templates/$f"; done
for t in bash env dirname cat cmp tr; do ln -s "$(command -v "$t")" "$worst/bin/$t"; done
worst_out=$(cd /tmp && MENTAT_GIT_TEMPLATES_DIR="$long/git-templates" PATH="$worst/bin" "$worst/plugin/hooks/session-start" | wc -c | tr -d ' ')
worst_line=$(cd /tmp && MENTAT_GIT_TEMPLATES_DIR="$long/git-templates" PATH="$worst/bin" "$worst/plugin/hooks/session-start" | head -n 1)
case $worst_line in
  "Mentat PROBLEM: the git hook templates agents' git uses have problems (3 missing or not executable, 4 changed, not installed: gitleaks jq)"*)
    if [ "$worst_out" -lt 10000 ]; then pass "hooks/session-start's worst case prints $worst_out bytes (cap 10,000)"
    else fail "hooks/session-start's worst case prints $worst_out bytes, over the 10,000-character cap"; fi ;;
  *) fail "hooks/session-start's worst case did not print its problem line: $worst_line" ;;
esac
rm -rf "$worst"

# The safety rules in rules.md match tests/fixtures/rules-safety.md exactly: the Approval and
# "What agents never do" sections (heading to the next level-two heading, trailing blank lines
# dropped) and each line before the fixture's first heading, as a whole line of rules.md.
safety=tests/fixtures/rules-safety.md
rules_section() {
  awk -v h="$2" '
    $0 == h { on = 1; print; next }
    on && /^## / { exit }
    on && $0 == "" { blank++; next }
    on { while (blank > 0) { print ""; blank-- } print }
  ' "$1"
}
for h in '## Approval' '## What agents never do'; do
  n=$(grep -cxF -- "$h" rules.md)
  if [ "$n" != 1 ]; then
    fail "rules.md must have the heading \"$h\" exactly once (it has $n)"
  elif d=$(diff <(rules_section "$safety" "$h") <(rules_section rules.md "$h")); then
    pass "rules.md's \"$h\" section matches $safety"
  else
    fail "rules.md's \"$h\" section differs from $safety (< fixture, > rules.md):"
    printf '%s\n' "$d"
  fi
done
while IFS= read -r s; do
  [ -n "$s" ] || continue
  if grep -qxF -- "$s" rules.md; then
    pass "rules.md has the whole line from $safety: ${s:0:60}..."
  else
    fail "rules.md must have this line from $safety, whole and unchanged: $s"
  fi
done <<< "$(awk '/^## / { exit } NF' "$safety")"

# Each skill's name matches its folder, which is how Claude Code finds it.
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  dir=${f%/SKILL.md}
  # Only the frontmatter block at the top of the file counts.
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="name: ${dir#skills/}" "$f"; then
    pass "$f is named ${dir#skills/}"
  else
    fail "$f must set name: ${dir#skills/}"
  fi
done

# rules.md names each workflow skill as a Skill tool call: every name it uses
# has a skill, and every skill the agent can call is named there or in a skill
# rules.md names (a step's procedure, such as mentat:propose, names the skills
# it calls). Each skill stays under 15,000 characters, a house limit toward
# Claude Code's budget for skill text kept after compaction.
named_by=rules.md
while IFS= read -r name; do
  [ -n "$name" ] || continue
  if [ -f "skills/$name/SKILL.md" ]; then
    pass "rules.md names mentat:$name, which exists"
    named_by="$named_by skills/$name/SKILL.md"
  else
    fail "rules.md names mentat:$name, but skills/$name/SKILL.md is missing"
  fi
done <<< "$(grep -ho 'mentat:[a-z-]*' rules.md | sed 's/^mentat://' | sort -u)"
# Paths in named_by have no spaces: skill names are [a-z-].
is_named() {
  local g
  for g in $named_by; do
    if grep -q "mentat:$1\`" "$g"; then return 0; fi
  done
  return 1
}
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  name=${f#skills/}; name=${name%/SKILL.md}
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "disable-model-invocation: true" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f is started by the maintainer, not named in rules.md"
  elif is_named "$name"; then
    pass "$f is named in rules.md or a skill it names"
  else
    fail "$f can be called by the agent but neither rules.md nor a skill it names names mentat:$name"
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -lt 15000 ]; then
    pass "$f is $size characters (limit 15000)"
  else
    fail "$f is $size characters (limit 15000)"
  fi
done

# A supporting file a skill names in backticks (lowercase `name.md`, or `../<skill>/name.md`)
# exists, relative to that skill's folder. A bare name found at the repository root, such as rules.md, is not one.
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  dir=${f%/SKILL.md}
  while IFS= read -r ref; do
    [ -n "$ref" ] || continue
    case $ref in
      ../*) ;;
      *) if [ -f "$ref" ]; then continue; fi ;;
    esac
    if [ -f "$dir/$ref" ]; then
      pass "$f names $ref, which exists"
    else
      fail "$f names $ref, but $dir/$ref is missing"
    fi
  done <<< "$(grep -o -E "\`(\.\./[a-z-]+/)?[a-z][a-z0-9-]*\.md\`" "$f" | tr -d '\`' | sort -u)"
done

# mentat review, review --local, review --grok, second-opinion (both modes) and check behave as
# specified (stub gh, codex, grok and gitleaks), and so do the merge, push, private text and secret hooks,
# the contract the merge hook keeps through hooks/lib/verdict.sh, and the git hook templates.
# They run at once, each into its own file, and print whole in this order.
if command -v jq >/dev/null 2>&1; then
  behavior=(tests/review.sh tests/review-local.sh tests/review-grok.sh tests/second-opinion.sh tests/second-opinion-web.sh tests/check.sh tests/hook-contract.sh tests/no-merge.sh tests/no-default-push.sh tests/no-private-text.sh tests/no-commit-secrets.sh tests/git-templates.sh)
  outs=$(mktemp -d) || exit 1
  pids=()
  # Background jobs ignore Ctrl-C, and so does all they start. Each script runs in its own
  # process group, so an interrupt stops every group and waits until nothing in it runs.
  stop_behavior() {
    local p
    for p in ${pids[@]+"${pids[@]}"}; do kill -TERM -- "-$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null; done
    wait
    for p in ${pids[@]+"${pids[@]}"}; do
      while kill -0 -- "-$p" 2>/dev/null; do sleep 0.1; done
    done
    rm -rf "$outs"
    exit 130
  }
  trap stop_behavior INT TERM
  for t in "${behavior[@]}"; do
    perl -e 'setpgrp(0, 0); exec @ARGV or exit 127' "$t" >"$outs/${t#tests/}" 2>&1 &
    pids+=("$!")
  done
  i=0
  for t in "${behavior[@]}"; do
    if wait "${pids[$i]}"; then rc=0; else rc=1; fi
    out=$(cat "$outs/${t#tests/}")
    printf '%s\n' "$out"
    # A script fails once, by its exit status or by a FAIL line it printed.
    if [ "$rc" != 0 ] || grep -q '^FAIL: ' "$outs/${t#tests/}"; then fail "$t"; fi
    i=$((i + 1))
  done
  trap - INT TERM
  rm -rf "$outs"
else
  fail "jq not installed, mentat review, check and the hooks not tested"
fi

# The plugin's manifests validate (warnings are fine, only a failure counts).
if command -v claude >/dev/null 2>&1; then
  if out=$(claude plugin validate . 2>&1); then
    pass "claude plugin validate ."
  else
    printf '%s\n' "$out"
    fail "claude plugin validate ."
  fi
else
  fail "claude not installed, the plugin manifests not validated"
fi

# The CI workflow declares permissions and pins every action to a commit (a
# check of form, not of least privilege).
workflow=.github/workflows/tests.yml
if [ -f "$workflow" ] && grep -q '^permissions:' "$workflow" \
  && ! grep -E '^[[:space:]-]*uses:' "$workflow" \
    | grep -Evq '^[[:space:]-]*uses:[[:space:]]+[A-Za-z0-9._-]+/[A-Za-z0-9._-]+@[0-9a-f]{40}([[:space:]]+#.*)?$'; then
  pass "$workflow declares permissions and pins every action to a commit"
else
  fail "$workflow must exist, declare explicit permissions, and pin every action to a 40-hex commit (uses: owner/repo@<sha>)"
fi

# Shell scripts pass shellcheck.
if command -v shellcheck >/dev/null 2>&1; then
  checked=(tests/run hooks/session-start hooks/lib/*.sh hooks/no-merge hooks/no-default-push hooks/no-private-text hooks/no-commit-secrets git-templates/scan git-templates/own-hook.sh git-templates/hooks/* bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/second-opinion.sh tests/second-opinion-web.sh tests/check.sh tests/hook-contract.sh tests/no-merge.sh tests/no-default-push.sh tests/no-private-text.sh tests/no-commit-secrets.sh tests/git-templates.sh)
  if shellcheck "${checked[@]}"; then
    pass "shellcheck ${checked[*]}"
  else
    fail "shellcheck ${checked[*]}"
  fi
else
  fail "shellcheck not installed, shell scripts not checked"
fi

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed\n' "$failures"
  exit 1
fi
printf 'All checks passed\n'

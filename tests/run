#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS and in CI (.github/workflows/tests.yml).
# A tool it needs that is missing fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# The reviewing tool is named (Codex, Grok or Claude), never "the reviewer".
# The scan skips tests/*.sh (they use `gh pr ready` as test input) and skills/*/CREDITS.md.
retired=$(git ls-files -z -- . ':!tests/run' ':!tests/*.sh' ':!skills/*/CREDITS.md' | xargs -0 grep -n -i -F -e 'the reviewer')
if [ -z "$retired" ]; then
  pass "no tracked prose says \"the reviewer\""
else
  fail "tracked prose says \"the reviewer\":"
  printf '%s\n' "$retired"
fi

# After "You: merge #N.", nothing reaches #N's branch until the maintainer answers a hold.
# Each file must keep the words that carry the obligation, not just the reply's template.
hold_check() {
  local file=$1 s
  shift
  for s in "$@"; do
    if ! grep -q -F -- "$s" "$file"; then
      fail "$file must give the hold after \"You: merge #N.\" (missing: $s)"
      return
    fi
  done
  pass "$file gives the hold after \"You: merge #N.\""
}
hold_check rules.md "pushes nothing to #N's branch until the maintainer answers a reply opening \"Hold #N: <reason>\""
hold_check skills/review/SKILL.md 'push nothing yet' '"Hold #N: <reason>" and end the turn'

# A fast track skips the Codex and Grok reviews only after a check of the complete final diff, says so in
# the status line, and is kept in the spec so a resumed or compacted session still has it.
fast_track_check() {
  local what=$1 s=$2
  if grep -q -F -- "$s" skills/review/SKILL.md; then
    pass "skills/review/SKILL.md gives the fast track's $what"
  else
    fail "skills/review/SKILL.md must give the fast track's $what (missing: $s)"
  fi
}
fast_track_check "check of the complete final diff" 'check the complete final diff'
fast_track_check "status line" 'Not reviewed: fast track agreed by the maintainer'
fast_track_check "record in the spec" 'one line in the spec, written when it was agreed'

# An open hand check blocks "You: merge #N." (the review and Claude-only skills), and a push after Ready
# skips its review round only on the maintainer's yes, for a diff that changes no file a program runs.
phrase_check() {
  local file=$1 what=$2 s=$3
  if grep -q -F -- "$s" "$file"; then
    pass "$file gives $what"
  else
    fail "$file must give $what (missing: $s)"
  fi
}
phrase_check skills/review/SKILL.md "the open hand check's status line" 'the status line is `Blocked: <the hand check>`'
phrase_check skills/review/SKILL.md "the open hand check's first step in chat" 'the chat reply opens with the first step'
phrase_check skills/review/SKILL.md "the after-merge step that does not block" 'does not hold back "You: merge #N."'
phrase_check skills/review/SKILL.md "the waived round's diff rule" 'changes no file a program runs, sources or fetches'
phrase_check skills/review/SKILL.md "the waived round's yes for that push" "Skip only on the maintainer's yes for that push"
phrase_check skills/review/SKILL.md "the waived round's status line" 'Not reviewed: last push waived by the maintainer'
phrase_check skills/review/SKILL.md "the waived round's measure from the last reviewed head" 'measured from the last head a review covered'
phrase_check skills/claude-review/SKILL.md "the open hand check's status line" 'the status line is `Blocked: <the hand check>`'
phrase_check skills/claude-review/SKILL.md "the waived round's exception" '"Waived round"'

# Reviews that run at once in one checkout must not share its record of the last fetch.
if grep -l FETCH_HEAD lib/*.sh; then
  fail "a script under lib/ reads FETCH_HEAD, which concurrent reviews in one checkout share"
else
  pass "no script under lib/ reads FETCH_HEAD"
fi

if [ -z "$(git ls-files .claude)" ]; then
  pass "nothing under .claude/ is version-controlled"
else
  fail ".claude/ must not be version-controlled (settings are the maintainer's own)"
fi

# hooks.json runs the SessionStart hook once, which is what loads rules.md.
if command -v jq >/dev/null 2>&1; then
  if jq -e '.hooks.SessionStart | length == 1 and (.[0].hooks | length == 1) and (.[0].hooks[0].command | endswith("/hooks/session-start"))' hooks/hooks.json >/dev/null; then
    pass "hooks.json runs hooks/session-start as its one SessionStart command"
  else
    fail "hooks.json must have exactly one SessionStart command, ending in /hooks/session-start"
  fi
else
  fail "jq not installed, SessionStart wiring not checked"
fi

# The SessionStart hook prints rules.md unchanged, within Claude Code's
# 10,000-character limit for the output of a hook.
if hook_out=$(hooks/session-start); then
  if [ "$hook_out" != "$(cat rules.md)" ]; then
    fail "hooks/session-start output differs from rules.md"
  elif [ "${#hook_out}" -ge 10000 ]; then
    fail "hooks/session-start prints ${#hook_out} characters (limit 10000)"
  else
    pass "hooks/session-start prints rules.md (${#hook_out} characters)"
  fi
else
  fail "hooks/session-start exited non-zero"
fi
# The file is found relative to the plugin root, not the working directory.
hook_script=$PWD/hooks/session-start
if hook_out=$(cd /tmp && "$hook_script") && [ "$hook_out" = "$(cat rules.md)" ]; then
  pass "hooks/session-start prints the same from another directory"
else
  fail "hooks/session-start differs when run from another directory"
fi

# Each skill's name matches its folder, which is how Claude Code finds it.
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  dir=${f%/SKILL.md}
  # Only the frontmatter block at the top of the file counts.
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="name: ${dir#skills/}" "$f"; then
    pass "$f is named ${dir#skills/}"
  else
    fail "$f must set name: ${dir#skills/}"
  fi
done

# rules.md names each workflow skill as a Skill tool call: every name it uses
# has a skill, and every skill the agent can call is named there. Each skill
# stays under 15,000 characters, a house limit toward Claude Code's budget for
# skill text kept after compaction.
while IFS= read -r name; do
  [ -n "$name" ] || continue
  if [ -f "skills/$name/SKILL.md" ]; then
    pass "rules.md names mentat:$name, which exists"
  else
    fail "rules.md names mentat:$name, but skills/$name/SKILL.md is missing"
  fi
done <<< "$(grep -ho 'mentat:[a-z-]*' rules.md | sed 's/^mentat://' | sort -u)"
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  name=${f#skills/}; name=${name%/SKILL.md}
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "disable-model-invocation: true" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f is started by the maintainer, not named in rules.md"
  elif grep -q "mentat:$name\`" rules.md; then
    pass "$f is named in rules.md"
  else
    fail "$f can be called by the agent but rules.md does not name mentat:$name"
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -lt 15000 ]; then
    pass "$f is $size characters (limit 15000)"
  else
    fail "$f is $size characters (limit 15000)"
  fi
done

# mentat review, review --local, review --grok, challenge, weigh, consult and check behave as
# specified (stub gh, codex and grok), and so does the merge hook and the push hook.
if command -v jq >/dev/null 2>&1; then
  for t in tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh; do
    if out=$("$t" 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; fail "$t"; fi
  done
else
  fail "jq not installed, mentat review, challenge, check and the hooks not tested"
fi

# The plugin's manifests validate (warnings are fine, only a failure counts).
if command -v claude >/dev/null 2>&1; then
  if out=$(claude plugin validate . 2>&1); then
    pass "claude plugin validate ."
  else
    printf '%s\n' "$out"
    fail "claude plugin validate ."
  fi
else
  fail "claude not installed, the plugin manifests not validated"
fi

# The CI workflow declares permissions and pins every action to a commit (a
# check of form, not of least privilege).
workflow=.github/workflows/tests.yml
if [ -f "$workflow" ] && grep -q '^permissions:' "$workflow" \
  && ! grep -E '^[[:space:]-]*uses:' "$workflow" \
    | grep -Evq '^[[:space:]-]*uses:[[:space:]]+[A-Za-z0-9._-]+/[A-Za-z0-9._-]+@[0-9a-f]{40}([[:space:]]+#.*)?$'; then
  pass "$workflow declares permissions and pins every action to a commit"
else
  fail "$workflow must exist, declare explicit permissions, and pin every action to a 40-hex commit (uses: owner/repo@<sha>)"
fi

# Shell scripts pass shellcheck.
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh; then
    pass "shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh"
  else
    fail "shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh"
  fi
else
  fail "shellcheck not installed, shell scripts not checked"
fi

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed\n' "$failures"
  exit 1
fi
printf 'All checks passed\n'

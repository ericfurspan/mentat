# The / menu shows descriptions as plain text: no skill's description holds <, > or a backtick, and a menu
# skill's description value is one short line of at most 150 characters.
for f in skills/*/SKILL.md; do
  d=$(awk 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit } NR > 1 && /^description: / { print; exit }' "$f")
  if [ -z "$d" ]; then
    fail "$f's frontmatter must have a description line"
    continue
  fi
  case $d in
    *'<'* | *'>'* | *'`'*) fail "$f's description must hold no <, > or backtick" ;;
    *) pass "$f's description holds no <, > or backtick" ;;
  esac
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "user-invocable: false" { found = 1; exit 0 } END { exit !found }' "$f"; then
    continue
  fi
  v=${d#description: \"}
  v=${v%\"}
  if [ "${#v}" -le 150 ]; then
    pass "$f's menu description is at most 150 characters"
  else
    fail "$f's menu description must be at most 150 characters (it has ${#v})"
  fi
done

# Skills only agents call stay out of the / menu and stay callable by the agent.
for s in propose pr review backlog grill; do
  f=skills/$s/SKILL.md
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "user-invocable: false" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f's frontmatter sets user-invocable: false"
  else
    fail "$f's frontmatter must set user-invocable: false"
  fi
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^disable-model-invocation:/ { found = 1; exit 0 } END { exit !found }' "$f"; then
    fail "$f's frontmatter must not set disable-model-invocation, so the agent can call it"
  else
    pass "$f's frontmatter does not set disable-model-invocation"
  fi
done


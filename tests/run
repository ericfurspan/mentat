#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS; this repository has no CI.
# A tool it needs that is missing fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# The plugin's output style is named Mentat and is not forced.
if grep -qx 'name: Mentat' prompts/output-style.md && ! grep -q '^force-for-plugin:' prompts/output-style.md; then
  pass "prompts/output-style.md is the Mentat style, not forced"
else
  fail "prompts/output-style.md must set name: Mentat and must not set force-for-plugin"
fi
if [ -z "$(git ls-files .claude)" ]; then
  pass "nothing under .claude/ is version-controlled"
else
  fail ".claude/ must not be version-controlled (settings are the maintainer's own)"
fi

# hooks.json runs the SessionStart hook twice, which is what loads the rules:
# once for rules.md and once, with an argument, for rules-records.md. Claude
# Code caps each hook's output at 10,000 characters, so the rules are two files.
if command -v jq >/dev/null 2>&1; then
  if jq -e '.hooks.SessionStart[0].hooks | length == 2' hooks/hooks.json >/dev/null; then
    pass "hooks.json has exactly two SessionStart commands"
  else
    fail "hooks.json must have exactly two SessionStart commands"
  fi
  if jq -e '.hooks.SessionStart[0].hooks | map(.command) | any(endswith("/hooks/session-start"))' hooks/hooks.json >/dev/null; then
    pass "hooks.json runs hooks/session-start with no argument on SessionStart"
  else
    fail "hooks.json does not run hooks/session-start with no argument on SessionStart"
  fi
  if jq -e '.hooks.SessionStart[0].hooks | map(.command) | any(endswith("/hooks/session-start rules-records.md"))' hooks/hooks.json >/dev/null; then
    pass "hooks.json runs hooks/session-start rules-records.md on SessionStart"
  else
    fail "hooks.json does not run hooks/session-start rules-records.md on SessionStart"
  fi
else
  fail "jq not installed, SessionStart wiring not checked"
fi

# The SessionStart hook prints each rules file unchanged, within Claude Code's
# 10,000-character limit for context a hook adds.
if hook_out=$(hooks/session-start); then
  if [ "$hook_out" != "$(cat rules.md)" ]; then
    fail "hooks/session-start output differs from rules.md"
  elif [ "${#hook_out}" -ge 10000 ]; then
    fail "hooks/session-start prints ${#hook_out} characters (limit 10000)"
  else
    pass "hooks/session-start prints rules.md (${#hook_out} characters)"
  fi
else
  fail "hooks/session-start exited non-zero"
fi
if hook_out=$(hooks/session-start rules-records.md); then
  if [ "$hook_out" != "$(cat rules-records.md)" ]; then
    fail "hooks/session-start rules-records.md output differs from rules-records.md"
  elif [ "${#hook_out}" -ge 10000 ]; then
    fail "hooks/session-start rules-records.md prints ${#hook_out} characters (limit 10000)"
  else
    pass "hooks/session-start rules-records.md prints rules-records.md (${#hook_out} characters)"
  fi
else
  fail "hooks/session-start rules-records.md exited non-zero"
fi
# The file is found relative to the plugin root, not the working directory.
hook_script=$PWD/hooks/session-start
if hook_out=$(cd /tmp && "$hook_script" rules-records.md) && [ "$hook_out" = "$(cat rules-records.md)" ]; then
  pass "hooks/session-start rules-records.md prints the same from another directory"
else
  fail "hooks/session-start rules-records.md differs when run from another directory"
fi

# Each skill's name matches its folder, which is how Claude Code finds it.
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  dir=${f%/SKILL.md}
  # Only the frontmatter block at the top of the file counts.
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="name: ${dir#skills/}" "$f"; then
    pass "$f is named ${dir#skills/}"
  else
    fail "$f must set name: ${dir#skills/}"
  fi
done

# rules.md and rules-records.md name each workflow skill as a Skill tool call:
# every name they use has a skill, and every skill the agent can call is named
# there. Each skill
# stays under 15,000 characters, a house limit toward Claude Code's budget for
# skill text kept after compaction.
while IFS= read -r name; do
  [ -n "$name" ] || continue
  if [ -f "skills/$name/SKILL.md" ]; then
    pass "rules.md names mentat:$name, which exists"
  else
    fail "rules.md names mentat:$name, but skills/$name/SKILL.md is missing"
  fi
done <<< "$(grep -ho 'mentat:[a-z-]*' rules.md rules-records.md | sed 's/^mentat://' | sort -u)"
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  name=${f#skills/}; name=${name%/SKILL.md}
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "disable-model-invocation: true" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f is started by the maintainer, not named in rules.md"
  elif grep -q "mentat:$name\`" rules.md rules-records.md; then
    pass "$f is named in rules.md"
  else
    fail "$f can be called by the agent but rules.md does not name mentat:$name"
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -lt 15000 ]; then
    pass "$f is $size characters (limit 15000)"
  else
    fail "$f is $size characters (limit 15000)"
  fi
done

# mentat review, review --local, review --grok, challenge, weigh and check behave as
# specified (stub gh, codex and grok), and so does the merge hook and the push hook.
if command -v jq >/dev/null 2>&1; then
  for t in tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh; do
    if out=$("$t" 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; fail "$t"; fi
  done
else
  fail "jq not installed, mentat review, challenge, check and the hooks not tested"
fi

# The plugin's manifests validate (warnings are fine, only a failure counts).
if command -v claude >/dev/null 2>&1; then
  if out=$(claude plugin validate . 2>&1); then
    pass "claude plugin validate ."
  else
    printf '%s\n' "$out"
    fail "claude plugin validate ."
  fi
else
  fail "claude not installed, the plugin manifests not validated"
fi

# Shell scripts pass shellcheck.
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh; then
    pass "shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh"
  else
    fail "shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh"
  fi
else
  fail "shellcheck not installed, shell scripts not checked"
fi

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed\n' "$failures"
  exit 1
fi
printf 'All checks passed\n'

#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS and in CI (.github/workflows/tests.yml).
# A tool it needs that is missing fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# CHANGELOG.md is refreshed on request, so parallel pull requests do not each edit it.
# shellcheck disable=SC2016 # the backticks are literal text in AGENTS.md
if grep -qxF -- '- `CHANGELOG.md` is refreshed only when the maintainer asks: one pull request adds dated lines, newest date first, written from the titles of the pull requests merged since its last entry.' AGENTS.md &&
  ! grep -qE '[Ee]very pull request.*CHANGELOG' AGENTS.md; then
  pass "AGENTS.md holds the changelog refresh rule and no per-pull-request changelog rule"
else
  fail "AGENTS.md lacks the changelog refresh rule or asks every pull request to edit CHANGELOG.md"
fi

# The reviewing tool is named (Codex, Grok or Claude), never "the reviewer".
# The scan skips tests/*.sh (they use `gh pr ready` as test input) and skills/*/CREDITS.md.
retired=$(git ls-files -z -- . ':!tests/run' ':!tests/*.sh' ':!skills/*/CREDITS.md' | xargs -0 grep -n -i -F -e 'the reviewer')
if [ -z "$retired" ]; then
  pass "no tracked prose says \"the reviewer\""
else
  fail "tracked prose says \"the reviewer\":"
  printf '%s\n' "$retired"
fi

# Maintainer-facing text names the stages (Inbox, Backlog, Todo), triage and the spec, never the older names
# for them; only the thin intake alias under skills/intake/ may say its own name.
old_phrases=$( { printf '%s\n' rules.md README.md prompts/builder.md; git ls-files -- skills; } | tr '\n' '\0' |
  xargs -0 grep -n -i -E \
    -e '(^|[^[:alnum:]])(tak(e|es|en|ing)|took)[ -]([[:alpha:]]+ ){0,2}on([^[:alnum:]]|$)' \
    -e 'agree the spec|build go-ahead|kept for reference|keep for reference')
old_command=$( { printf '%s\n' rules.md README.md prompts/builder.md; git ls-files -- skills; } | grep -v '^skills/intake/' | tr '\n' '\0' |
  xargs -0 grep -n -i -E -e '(^|[^[:alnum:]])intake([^[:alnum:]]|$)')
stage_names=$(printf '%s\n%s\n' "$old_phrases" "$old_command" | sed '/^$/d')
if [ -z "$stage_names" ]; then
  pass "rules, skills, the builder prompt and README use the stage and triage names"
else
  fail "rules, skills, the builder prompt or README use an older name for a stage, triage or the spec:"
  printf '%s\n' "$stage_names"
fi

# Outside the tracker adapters, rules, skills and the builder prompt name no tracker's own statuses, fields,
# labels or buttons. The list is the Linear adapter's own words; the core writes "triage" in lowercase.
linear_words="Waiting on you|Priority|No priority|Urgent|Mark as duplicate|Decline|Snooze|Linear's Accept|[a-z,;(] Triage|[(]Triage|Triage status"
tracker_words=$( { printf '%s\n' rules.md prompts/builder.md; git ls-files -- skills; } |
  grep -v -x -e skills/backlog/linear.md -e skills/backlog/github.md -e skills/linear/SKILL.md | tr '\n' '\0' |
  xargs -0 grep -n -E -e "$linear_words")
if [ -z "$tracker_words" ]; then
  pass "no tracker's own words outside the tracker adapters"
else
  fail "rules, skills or the builder prompt name a tracker's own words outside the adapters:"
  printf '%s\n' "$tracker_words"
fi

# The README stays short: at most 500 words by wc -w.
readme_words=$(wc -w <README.md | tr -d ' ')
if [ "$readme_words" -le 500 ]; then
  pass "README.md is at most 500 words ($readme_words)"
else
  fail "README.md is $readme_words words, over 500"
fi

# After "You: merge #N.", nothing reaches #N's branch until the maintainer answers a hold.
# Each file must keep the words that carry the obligation, not just the reply's template.
hold_check() {
  local file=$1 s
  shift
  for s in "$@"; do
    if ! grep -q -F -- "$s" "$file"; then
      fail "$file must give the hold after \"You: merge #N.\" (missing: $s)"
      return
    fi
  done
  pass "$file gives the hold after \"You: merge #N.\""
}
hold_check rules.md "pushes nothing to #N's branch until the maintainer answers a reply opening \"Hold #N: <reason>\""
hold_check skills/review/SKILL.md 'push nothing yet' '"Hold #N: <reason>" and end the turn'

# A fast track skips the Codex and Grok reviews only after a check of the complete final diff, says so in
# the status line, and is kept in the spec so a resumed or compacted session still has it.
fast_track_check() {
  local what=$1 s=$2
  if grep -q -F -- "$s" skills/review/fast-track.md; then
    pass "skills/review/fast-track.md gives the fast track's $what"
  else
    fail "skills/review/fast-track.md must give the fast track's $what (missing: $s)"
  fi
}
fast_track_check "turning on only by the maintainer" 'Claude Code never turns it on itself'
fast_track_check "check of the complete final diff" 'check the complete final diff'
fast_track_check "status line" 'Not reviewed: fast track agreed by the maintainer'
fast_track_check "record in the spec" 'one line in the spec, written when it was agreed'
fast_track_check "skipped reviewers" 'names every reviewer skipped, Codex and Grok (fast track agreed by the maintainer)'

# An open hand check blocks "You: merge #N." (the review and Claude-only skills), and a push after Ready
# skips its review round only on the maintainer's yes, for a diff that changes no file a program runs.
phrase_check() {
  local file=$1 what=$2 s=$3
  if grep -q -F -- "$s" "$file"; then
    pass "$file gives $what"
  else
    fail "$file must give $what (missing: $s)"
  fi
}
phrase_check skills/review/SKILL.md "the open hand check's status line" 'Blocked: <the hand check>'
phrase_check skills/review/SKILL.md "the open hand check's one sentence in chat" 'the chat reply names the hand check in one plain sentence'
phrase_check skills/review/SKILL.md "the open hand check's no merge line" 'Then say no "You: merge #N."'
phrase_check skills/claude-review/SKILL.md "the open hand check's stop before the merge line" 'step 6 does not run'
phrase_check skills/claude-review/SKILL.md "step 5's hand check gate" 'apply the hand check gate of'
phrase_check skills/claude-review/SKILL.md "the Claude round's record of the spec fingerprint" 'Agreed request fingerprint: <12 hex>'
phrase_check skills/claude-review/SKILL.md "the waiver's comparison with the last Claude round's fingerprint" "or that comment has none, a Claude round runs instead"
phrase_check skills/review/SKILL.md "the after-merge step that does not block" 'does not hold back "You: merge #N."'
phrase_check skills/review/SKILL.md "the open hand check as the maintainer's, until the Verification says they checked it" 'A hand check is open when a requirement of the spec is one the maintainer checks by hand and the Verification does not say the maintainer checked it and what they saw.'
phrase_check skills/review/SKILL.md "that a builder's or Claude Code's own look does not close a hand check" "A builder's or Claude Code's own look does not close it."
phrase_check skills/review/SKILL.md "the record of the maintainer's reported hand check" 'record in the Verification that the maintainer checked it and what they saw'
phrase_check skills/review/SKILL.md "the open hand check's wait written in one place" "the wait is written as \`mentat:backlog\` \"Waits on the maintainer\" says (with a backlog item, only on it plus one line atop the pull request; an external item is marked waiting, not as a merge wait)"
phrase_check skills/pr/SKILL.md "the wait's one line above the summary with a backlog item" "A wait on the maintainer goes first in the body, above \`## Summary\`, as \`mentat:backlog\` \"Waits on the maintainer\" says: when the wait is on a backlog item (external or a GitHub issue), only its one line saying the steps are on the backlog item; with no backlog item, the wait itself."
phrase_check skills/claude-review/SKILL.md "the open hand check as the maintainer's, not closed by an agent's own look" "(a requirement the maintainer checks by hand whose Verification row still does not say the maintainer checked it and what they saw; a builder's or Claude Code's own look does not close it)"
phrase_check skills/backlog/SKILL.md "the spec's hand check requirement as the maintainer's" 'and one the maintainer checks by hand says so.'
phrase_check skills/pr/SKILL.md "the spec shape's hand check requirement as the maintainer's" 'and one the maintainer checks by hand says so;'
phrase_check skills/review/SKILL.md "the waived round's diff rule" 'changes no file a program runs, sources or fetches'
phrase_check skills/review/SKILL.md "the waived round's yes for that push" 'on their yes for that push'
phrase_check skills/review/SKILL.md "the waived round's status line" "the status line is \`Not reviewed: last push waived by the maintainer\`"
phrase_check skills/review/SKILL.md "the waived round's measure from the last reviewed head" 'the diff is measured from the last head a review covered'
phrase_check skills/review/SKILL.md "the waived round's normal round on doubt or a changed spec" 'any doubt, a pushed diff that differs from the proposal, or a change to the spec runs the normal round'
phrase_check skills/review/SKILL.md "what a waived push still runs and says" "it runs \`mentat ci\` and the final check, the push uses no round"
phrase_check skills/review/SKILL.md "the waived round's Verification line and merge message" 'a Verification line and the merge message say it was waived and not reviewed'
phrase_check skills/review/SKILL.md "the waived round on the Claude-only path" 'On the Claude-only path it also skips the Claude round, unless the spec changed.'
phrase_check skills/claude-review/SKILL.md "the open hand check's status line" 'Blocked: <the hand check>'
phrase_check skills/claude-review/SKILL.md "the waived round's exception" '"Waived round"'
phrase_check skills/claude-review/SKILL.md "the waived round's status line" "the status line is \`Not reviewed: last push waived by the maintainer\`"
phrase_check skills/claude-review/SKILL.md "that an earlier Claude round does not make a waived push Ready" 'an earlier Claude round does not make it Ready'
# Before "You: merge #N.", the owner is asked again unless they approved the current head.
for f in skills/review/SKILL.md skills/claude-review/SKILL.md; do
  phrase_check "$f" "the owner's review request unless they approved the head" "If the repository owner is not the author, request their review (\`gh pr edit <N> --add-reviewer <owner>\`) unless their latest submitted review is \`APPROVED\` with a commit oid equal to \`headRefOid\` (\`gh pr view <N> --json reviews,headRefOid\`; not \`reviewDecision\`); if that read fails, request it."
done

# A P0 or P1 finding from Codex or Grok that was answered, not fixed, is named in the final check.
phrase_check skills/review/SKILL.md "a serious finding answered, not fixed, in one Verification line and the merge message" 'A P0 or P1 finding from Codex or Grok that was answered instead of fixed is named in one Verification line, which can be its line in step 4'"'"'s list, and in one sentence of the "You: merge #N." message; a pull request with none adds no line.'
phrase_check skills/review/SKILL.md "a serious finding in the one more sentence" 'or a P0 or P1 finding answered instead of fixed'
# Round five ends in a named state; only the maintainer allows more rounds.
phrase_check skills/review/SKILL.md "round five's pushed fixes and status line" "any fixes are pushed, and the status line is \`Not reviewed: no review round left\`, with no \"You: merge #N.\" on that head; the maintainer decides."
phrase_check skills/review/SKILL.md "round five with no fixes to push" "With no fixes to push, the state is \`Ready\` only if every Ready condition holds, including that the round covered the current spec"
phrase_check skills/review/SKILL.md "a round five that did not finish or cover the spec" "a round five that did not finish or did not cover the spec is \`Not reviewed: <why>\`, and anything else is \`Blocked: <why>\`."
phrase_check skills/review/SKILL.md "extra rounds allowed by the maintainer" 'The maintainer may say in chat how many extra rounds to allow; a Verification line records the allowance, those rounds run as normal, and the limit applies again once they are used.'
phrase_check skills/review/SKILL.md "no extra rounds without the maintainer" 'Claude Code never allows extra rounds on its own.'
# From the second Codex round the description lists what is settled, which the review prompt treats as data.
phrase_check skills/review/SKILL.md "the settled list from the second Codex round" "From the second Codex round, the description's Verification holds one line for each finding already fixed or answered, with its fix commit or its reason."
# mentat status replaces counting comments, and each skill says what status does not show.
for f in skills/review/SKILL.md skills/claude-review/SKILL.md; do
  phrase_check "$f" "mentat status for rounds, Grok's state and the spec" 'mentat status <N> [--request <file>]'
  phrase_check "$f" "that did not finish covers an INCOMPLETE Grok result and a true non-finish" 'covers both an INCOMPLETE Grok result, whose findings are still sorted'
  phrase_check "$f" "that running means did not finish unless this session's run is going" "\`grok: running\` means did not finish unless this session's own run is still going"
  phrase_check "$f" "that status skips an INCOMPLETE Codex review" 'status skips an INCOMPLETE Codex review'
  phrase_check "$f" "that head reviewed: yes can mean a Claude round" "\`head reviewed: yes\` can mean a Claude round, so once Codex is back on, a Codex review still runs on the head"
done
phrase_check skills/review/SKILL.md "the latest comment read once Codex is turned back on" 'or Codex was just turned back on'
phrase_check skills/review/SKILL.md "the final check reading Grok's fingerprint from its comment" 'read from its comment, because status compares only the last Codex or Claude review'
phrase_check skills/pr/SKILL.md "a check that failed first as the builder's report" "a check that failed before the fix and passed after is the builder's report"
# For each check that runs code which the builder adds or changes, it shows the check fails when the source breaks its requirement.
phrase_check prompts/builder.md "the smallest source edit that breaks a new check's requirement" "For each check that runs code (a hook, script or command test) whose assertion you add or change, other than a bug fix's failing check, make the smallest edit to the source that makes the requirement it covers untrue, leaving the check's search text in place (for a check that forbids something, introduce it). A check that only looks for text in a file needs no such proof. Never edit the test to force a failure. Show that check failing with a focused run of it, not an extra full test run."
phrase_check skills/pr/SKILL.md "titles in Conventional Commits" 'Titles follow Conventional Commits.'
phrase_check skills/pr/SKILL.md "the alert type in one clause" 'Use the GitHub alert type that fits the note.'
# The builder commits each logical change on its own, one per review finding, and runs the test command once, last.
phrase_check prompts/builder.md "a commit per logical change a reviewer can read alone" 'commit each logical change a reviewer can read alone'
phrase_check prompts/builder.md "one commit for what is only coherent together" 'keep together what is only coherent together, such as a wording change and the check that pins it'
phrase_check prompts/builder.md "one commit per review finding fixed" 'When the brief fixes review findings, make one commit per finding fixed'
phrase_check prompts/builder.md "a shared commit for findings on the same lines" 'findings that must change the same lines share a commit'
phrase_check prompts/builder.md "a subject that says what the commit does" 'Each subject says what the commit does'
phrase_check prompts/builder.md "the subject's format from AGENTS.md, else Conventional Commits" "in the commit format the repository's AGENTS.md names, otherwise Conventional Commits"
phrase_check prompts/builder.md "no finding text, local path or private name in a subject" 'holds no finding text, local path or private name'
phrase_check prompts/builder.md "the test command once, on the last commit" 'The test command runs once, on the last commit; earlier commits need not pass it.'
# A changed hook, workflow or instruction file reaches the note or Verification, defined once in mentat:pr.
phrase_check skills/pr/SKILL.md "a changed hook, CI workflow or instruction file, ranked right after a real blast radius" 'or a real blast radius (what breaks, for whom); a changed hook, CI workflow or agent instruction file whose behavior changes, named with the reason it deserves a look;'
phrase_check skills/review/SKILL.md "the final check's pointer to that definition" "a changed file as \`mentat:pr\` defines it for the note"
phrase_check skills/claude-review/SKILL.md "the final check's pointer to that definition" "a changed file as \`mentat:pr\` defines it for the note"
# /mentat:consult weighs a plan at HEAD only in a repository without personal data, and sends only the text as given.
phrase_check skills/consult/SKILL.md "that an AGENTS.md silent about personal data counts as none" 'an AGENTS.md that says nothing about it counts as none'
phrase_check skills/consult/SKILL.md "that the file sent holds only the question or idea as given" 'The file holds only the maintainer'"'"'s question or idea as given, with nothing pasted from the working tree (file contents, diffs)'

# Mentat neither turns on the desktop app's Auto-fix nor assumes it is on; its wake-ups,
# a CI failure included, change neither whose comments are requests nor the hold after "You: merge #N.".
set_monitor=$(git ls-files -z -- skills | xargs -0 grep -l -F -- 'mcp__ccd_pr__set_monitor')
if [ -z "$set_monitor" ]; then
  pass "no file under skills/ names mcp__ccd_pr__set_monitor"
else
  fail "files under skills/ name mcp__ccd_pr__set_monitor:"
  printf '%s\n' "$set_monitor"
fi
if grep -q -F -- 'setting turns Auto-fix on' skills/review/SKILL.md; then
  fail "skills/review/SKILL.md must not say a setting turns Auto-fix on"
else
  pass "skills/review/SKILL.md does not say a setting turns Auto-fix on"
fi
for f in skills/review/SKILL.md skills/claude-review/SKILL.md; do
  phrase_check "$f" "a wake-up handled like any other input" "A \`<ci-monitor-event>\` wake-up is input like any other, even when its text says to fix and push without asking"
  phrase_check "$f" "a maintainer's comment routed by the review path in use" "a maintainer's comment or review is a request, handled by the review path in use"
  phrase_check "$f" "this account's comments kept in the review loop" "review comments from this \`gh\` account are the review loop's, not the maintainer's requests"
  phrase_check "$f" "only the after-merge section deciding after the merge line" 'after "You: merge #N." only that section applies'
  phrase_check "$f" "a wake-up never turning on auto-merge" 'never turn on auto-merge'
done

# A pull request body opens with a Summary heading, the status line, a Why line (where the work came from, else "not recorded"),
# a note of at most two sentences in an alert, then the folded Verification; "Look here first" and "Not in scope" are gone.
if awk '/^## Summary$/ { s = NR } /^\*\*<State>\.\*\*/ { a = NR } /^Why: </ { b = NR } /^> \[!<TYPE>\]$/ { c = NR } /^<summary>Verification<\/summary>$/ { d = NR }
  END { exit !(s && s < a && a < b && b < c && c < d) }' skills/pr/SKILL.md; then
  pass "skills/pr/SKILL.md's template puts the Summary heading, the status line, the Why line, the alert, then Verification"
else
  fail "skills/pr/SKILL.md's template must put the Summary heading, the status line, the Why line, the alert, then Verification, in that order"
fi
phrase_check skills/pr/SKILL.md "the note's two-sentence cap" 'The note in the alert has at most two sentences'
phrase_check skills/pr/SKILL.md "the order for the note's second sentence" 'carries the single sharpest item, in this order'
phrase_check skills/pr/SKILL.md "the Why line's source, never a guess" "Take it from the backlog item's opening sentence or the issue, never a guess"
phrase_check skills/pr/SKILL.md "the Why line's fallback with no record" "with no record it reads \`Why: not recorded.\`"
phrase_check skills/pr/SKILL.md "the status line's rounds against the limit" "the \`codex rounds\` count from \`mentat status <N>\` against a limit of five plus any extra rounds a Verification line records the maintainer allowing, or, on the Claude-only path (\`mentat:claude-review\`), the \`claude rounds\` count against two"
phrase_check lib/shared.sh "the review prompt's intent from the alert, not the Why line" 'its "Why:" line says where the work came from, not the intent'
phrase_check lib/shared.sh "the review prompt's rule for wording in text agents follow" 'There, wording, names included, is a correctness problem when it can be read in a way that makes an agent act wrongly'
phrase_check skills/backlog/SKILL.md "where the work came from in an item's opening sentence" 'from when Claude Code creates the item or the maintainer agrees it, where the work came from: asked by the maintainer in chat'
for s in 'Look here first' 'Not in scope'; do
  found=$(git ls-files -z -- . ':!tests/run' | xargs -0 grep -l -I -F -- "$s")
  if [ -z "$found" ]; then
    pass "no tracked file gives \"$s\""
  else
    fail "tracked files still give \"$s\":"
    printf '%s\n' "$found"
  fi
done

# A grill asks one decision per prompt, always with a way to stop, and is offered at most once per request.
phrase_check skills/grill/SKILL.md "one decision per prompt" "Ask one decision per \`AskUserQuestion\` prompt"
phrase_check skills/grill/SKILL.md "no several questions at once" 'Never put several questions in one message or one prompt'
phrase_check skills/grill/SKILL.md "the Stop here option on every prompt" 'Every prompt also has a "Stop here" option'
phrase_check skills/propose/SKILL.md "the grill offer at most once per request" 'at most once per request, and starts it only if the maintainer agrees'
# A grill's record goes in the weigh's file.
phrase_check skills/propose/SKILL.md "the grill's record in the weigh's file" "answers (with any grill's record, as \`mentat:grill\` defines it)"
# A settlement that changes the idea gets another weigh round, up to three, before the one agreement question.
phrase_check skills/propose/SKILL.md "another weigh round only for an adopted change to the idea" "It runs another round only when the last round's settlement adopts a change to the idea's requirements, scope or approach; a wording-only change does not count."
phrase_check skills/propose/SKILL.md "when the weigh rounds stop" 'The rounds stop when a settlement adopts no such change, or after three rounds in all.'
phrase_check skills/propose/SKILL.md "a later round's file with the whole revised idea and no earlier replies" "Each later round's file holds the whole revised idea, with its answers and deferred choices, and no earlier replies or summary of them."
phrase_check skills/propose/SKILL.md "one agreement question after the last round" 'It asks the maintainer to agree once, after the last round,'
phrase_check skills/propose/SKILL.md "the agreement question's note of a last change with no design review" 'says when the last adopted change had no design review'
# A point the maintainer corrects twice is restated and followed; before agreement, a grill is offered only for a decision still open, as propose's one offer.
phrase_check rules.md "a twice-corrected point restated in one line and followed" 'When the maintainer corrects the same point twice in a session, Claude Code restates the correction in one line and follows it.'
phrase_check rules.md "a grill offered only before agreement and for a decision still open, as propose's one offer" "Before the work is agreed, it offers a grill (\`mentat:grill\`) only if the corrections show one of the maintainer's decisions is still open, as the one offer \`mentat:propose\` allows per request, and starts it only if the maintainer agrees."
# A lasting lesson from a correction is followed at once and filed in Backlog only on a yes asked in the reply to it, never with another question.
phrase_check rules.md "a correction within the agreed scope followed at once" 'Claude Code follows any correction within the agreed scope at once.'
phrase_check rules.md "the triggers for asking to file a lesson" 'When the maintainer corrected the same point twice, said it should hold in later work, or stated a preference about how agents work in general,'
phrase_check rules.md "the lesson asked once in the reply to the correction" "its reply to that correction asks once, in one \`AskUserQuestion\` prompt, whether to file it;"
phrase_check rules.md "what does not trigger the lesson ask, and once per point" 'never for a one-off instruction for this task, a reversal already asked as a scope question or a failed check inside the review loop, and at most once per point per session.'
phrase_check rules.md "a yes files a lesson as a Backlog item, naming what it would change" "A yes files a Backlog item naming what it would change (for a working-style preference, the maintainer's own instructions);"
phrase_check rules.md "the lesson's yes agrees nothing else and is asked alone" 'it agrees nothing else and is never combined with another question, such as the next-work offer.'
phrase_check rules.md "a lesson filed only on a yes, unlike other unasked follow-ups" 'Unlike other unasked follow-ups, a lesson is filed only on that yes.'

# A triage sitting is started only by the maintainer, asks one decision per prompt, reads its readers again
# after a compaction, and sends nothing it collects to Codex or Grok.
for s in 'name: triage' 'disable-model-invocation: true'; do
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="$s" skills/triage/SKILL.md; then
    pass "skills/triage/SKILL.md's frontmatter sets $s"
  else
    fail "skills/triage/SKILL.md's frontmatter must set $s"
  fi
done
if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && /^description: / && /Arguments: project names or all, source options, or brainstorm with a text or link\./ { found = 1; exit 0 } END { exit !found }' skills/triage/SKILL.md; then
  pass "skills/triage/SKILL.md's description lists its arguments"
else
  fail "skills/triage/SKILL.md's description must list its arguments (Arguments: project names or all, source options, or brainstorm with a text or link.)"
fi
# The old command stays as a thin alias that runs triage during the rollout.
for s in 'name: intake' 'disable-model-invocation: true'; do
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="$s" skills/intake/SKILL.md; then
    pass "skills/intake/SKILL.md's frontmatter sets $s"
  else
    fail "skills/intake/SKILL.md's frontmatter must set $s"
  fi
done
phrase_check skills/intake/SKILL.md "the alias's pointer to triage" "This command is now \`/mentat:triage\`. Read \`../triage/SKILL.md\` and follow it with the same arguments."

#!/usr/bin/env bash
# The repository's one test command. Runs locally on macOS and in CI (.github/workflows/tests.yml).
# A tool it needs that is missing fails the run.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

failures=0
pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }

# Codex reads review rules from this heading in AGENTS.md.
if grep -qx '## Code Review Rules' AGENTS.md; then
  pass "AGENTS.md has a Code Review Rules section"
else
  fail "AGENTS.md is missing '## Code Review Rules'"
fi

# The reviewing tool is named (Codex, Grok or Claude), never "the reviewer".
# The scan skips tests/*.sh (they use `gh pr ready` as test input) and skills/*/CREDITS.md.
retired=$(git ls-files -z -- . ':!tests/run' ':!tests/*.sh' ':!skills/*/CREDITS.md' | xargs -0 grep -n -i -F -e 'the reviewer')
if [ -z "$retired" ]; then
  pass "no tracked prose says \"the reviewer\""
else
  fail "tracked prose says \"the reviewer\":"
  printf '%s\n' "$retired"
fi

# After "You: merge #N.", nothing reaches #N's branch until the maintainer answers a hold.
# Each file must keep the words that carry the obligation, not just the reply's template.
hold_check() {
  local file=$1 s
  shift
  for s in "$@"; do
    if ! grep -q -F -- "$s" "$file"; then
      fail "$file must give the hold after \"You: merge #N.\" (missing: $s)"
      return
    fi
  done
  pass "$file gives the hold after \"You: merge #N.\""
}
hold_check rules.md "pushes nothing to #N's branch until the maintainer answers a reply opening \"Hold #N: <reason>\""
hold_check skills/review/SKILL.md 'push nothing yet' '"Hold #N: <reason>" and end the turn'

# A fast track skips the Codex and Grok reviews only after a check of the complete final diff, says so in
# the status line, and is kept in the spec so a resumed or compacted session still has it.
fast_track_check() {
  local what=$1 s=$2
  if grep -q -F -- "$s" skills/review/SKILL.md; then
    pass "skills/review/SKILL.md gives the fast track's $what"
  else
    fail "skills/review/SKILL.md must give the fast track's $what (missing: $s)"
  fi
}
fast_track_check "check of the complete final diff" 'check the complete final diff'
fast_track_check "status line" 'Not reviewed: fast track agreed by the maintainer'
fast_track_check "record in the spec" 'one line in the spec, written when it was agreed'

# An open hand check blocks "You: merge #N." (the review and Claude-only skills), and a push after Ready
# skips its review round only on the maintainer's yes, for a diff that changes no file a program runs.
phrase_check() {
  local file=$1 what=$2 s=$3
  if grep -q -F -- "$s" "$file"; then
    pass "$file gives $what"
  else
    fail "$file must give $what (missing: $s)"
  fi
}
phrase_check skills/review/SKILL.md "the open hand check's status line" 'Blocked: <the hand check>'
phrase_check skills/review/SKILL.md "the open hand check's first step in chat" 'the chat reply opens with the first step'
phrase_check skills/review/SKILL.md "the open hand check's no merge line" 'Then say no "You: merge #N."'
phrase_check skills/claude-review/SKILL.md "the open hand check's stop before the merge line" 'step 6 does not run'
phrase_check skills/claude-review/SKILL.md "step 5's hand check gate" 'apply the hand check gate of'
phrase_check skills/claude-review/SKILL.md "the Claude round's record of the spec fingerprint" 'Agreed request fingerprint: <12 hex>'
phrase_check skills/claude-review/SKILL.md "the waiver's comparison with the last Claude round's fingerprint" "or that comment has none, a Claude round runs instead"
phrase_check skills/review/SKILL.md "the after-merge step that does not block" 'does not hold back "You: merge #N."'
phrase_check skills/review/SKILL.md "the waived round's diff rule" 'changes no file a program runs, sources or fetches'
phrase_check skills/review/SKILL.md "the waived round's yes for that push" "Skip only on the maintainer's yes for that push"
phrase_check skills/review/SKILL.md "the waived round's status line" 'Not reviewed: last push waived by the maintainer'
phrase_check skills/review/SKILL.md "the waived round's measure from the last reviewed head" 'measured from the last head a review covered'
phrase_check skills/claude-review/SKILL.md "the open hand check's status line" 'Blocked: <the hand check>'
phrase_check skills/claude-review/SKILL.md "the waived round's exception" '"Waived round"'

# A grill asks one decision per prompt, always with a way to stop, and is offered at most once per request.
phrase_check skills/grill/SKILL.md "one decision per prompt" "Ask one decision per \`AskUserQuestion\` prompt"
phrase_check skills/grill/SKILL.md "no several questions at once" 'Never put several questions in one message or one prompt'
phrase_check skills/grill/SKILL.md "the Stop here option on every prompt" 'Every prompt also has a "Stop here" option'
phrase_check skills/propose/SKILL.md "the grill offer at most once per request" 'at most once per request, and starts it only if the maintainer agrees'
# A grill's record goes in the weigh's file; with no change here, a second opinion is offered once, through the consult skill's steps.
phrase_check skills/propose/SKILL.md "the grill's record in the weigh's file" "answers (with any grill's record, as \`mentat:grill\` defines it)"
phrase_check skills/grill/SKILL.md "the second opinion offer only when no change here follows" 'only when the agreed list will not lead to a change in this repository'
phrase_check skills/grill/SKILL.md "the second opinion offer in its own prompt" "ask once, in its own \`AskUserQuestion\` prompt"
phrase_check skills/grill/SKILL.md "no second opinion offer after Stop here" 'Make no offer after "Stop here".'
phrase_check skills/grill/SKILL.md "the second opinion through the consult skill's steps" "follow its steps 1 to 4 rather than running \`mentat consult\` directly"

# A decision that does not block work reaches the maintainer as their own instructions say, and mentat:propose points there.
phrase_check rules.md "the maintainer's own route for a decision that does not block" "Where the maintainer's own instructions say how a decision Claude Code does not need in order to keep working reaches them, it follows those instructions"
phrase_check skills/propose/SKILL.md "step 2's route for a decision that does not block" 'one it does not need in order to go on goes as "How it reaches them" says'

# A decision prompt can be answered on its own, a call made without the maintainer reaches chat one line each,
# mentat:propose reads the open backlog before planning, and a record is re-read right before asking about it.
phrase_check rules.md "what each option changes for the maintainer" "each saying, in the maintainer's terms, what it authorizes and changes for them"
phrase_check rules.md "why the first option is recommended, in the prompt itself" 'the question says why the first is recommended, so the prompt alone suffices'
phrase_check rules.md "a consequential call in one line of the next message" "and in one line of the next message the maintainer reads"
if grep -q -F 'not in chat' rules.md; then
  fail "rules.md must not keep a consequential call out of chat (found: not in chat)"
else
  pass "rules.md does not keep a consequential call out of chat"
fi
phrase_check skills/review/SKILL.md "each call made without the maintainer, one line each" 'name each call made without them, one line each'
phrase_check skills/claude-review/SKILL.md "each call made without the maintainer, one line each" 'each call made without them, one line each'
phrase_check skills/propose/SKILL.md "step 2's read of the open backlog" "the open backlog's titles and opening sentences (read only)"
phrase_check skills/propose/SKILL.md "step 2's planning with overlapping items" 'overlapping items and the plan around them'
phrase_check rules.md "the re-read of a record before asking about it" 'Right before asking about a record, it re-reads that record.'
# Step 2's read (mentat:propose) neither refines hand-made items nor clears merge waits: both bullets exempt it.
if [ "$(grep -c -F "not for \`mentat:propose\`'s read," skills/backlog/SKILL.md)" -eq 2 ]; then
  pass "skills/backlog/SKILL.md exempts step 2's read from refining items and clearing merge waits"
else
  fail "skills/backlog/SKILL.md must exempt step 2's read in both the hand-made items and merge waits bullets"
fi

# An item that is not agreed is described by what it is and where it stands, and waits on no one.
phrase_check skills/backlog/SKILL.md "step 2's first status, not agreed" "   - Not agreed, Claude Code's own suggestions included."
phrase_check skills/backlog/SKILL.md "a parked item's opening sentence" 'An item the maintainer set aside says "parked" in its opening sentence'
phrase_check skills/backlog/SKILL.md "a once-agreed item kept out of the order" 'one that was agreed keeps its spec and any wait, says it was agreed, and leaves the order of agreed work'
phrase_check skills/backlog/SKILL.md "Linear's Backlog status as not agreed" 'statuses are Backlog (not agreed'
phrase_check skills/backlog/SKILL.md "the new project's Backlog line as not agreed" '* Backlog: not agreed, or parked'
phrase_check skills/backlog/SKILL.md "the opening sentence's kind of item and wait" 'what the item is (such as a bug, a proposal, a follow-up or a question), where it stands, and any wait on the maintainer (step 4)'
phrase_check rules.md "a wait on the maintainer for agreed work only" 'When agreed work waits on a test or action'
phrase_check skills/backlog/SKILL.md "step 4's wait for agreed work only" 'for agreed work only (an item that is not agreed waits on no one)'
phrase_check skills/backlog/SKILL.md "the waiting stage for agreed work only" 'an issue that is not agreed waits on no one'

# After a weigh or a plan challenge, the maintainer sees each tool's reply and what Claude Code did with it in one block.
phrase_check skills/backlog/SKILL.md "the replies block's section" '## Replies in chat'
phrase_check skills/backlog/SKILL.md "the replies block's Adopting line" 'Adopting: <'
phrase_check skills/backlog/SKILL.md "the replies block's Not adopting line" 'Not adopting: <'
phrase_check skills/backlog/SKILL.md "the replies block's line for a tool with no answer" "\`not weighed\` or \`not challenged\` and why"
phrase_check skills/backlog/SKILL.md "the replies block inside a decision prompt" 'the block opens its question'
phrase_check skills/backlog/SKILL.md "the replies block with GitHub issues" 'only "Replies in chat" and "Tracker: GitHub issues" apply'
phrase_check skills/backlog/SKILL.md "the settlement from the replies block" "the block's Adopting and Not adopting lines"
phrase_check skills/propose/SKILL.md "step 2's replies block" '"Replies in chat"'
phrase_check rules.md "the replies block in a decision prompt" "(a weigh's or challenge's replies block opens the question)"
phrase_check skills/plan/SKILL.md "the challenge's replies block at hand-off" 'replies block'
for f in rules.md skills/propose/SKILL.md; do
  if grep -q -F 'in one line beside its own' "$f"; then
    fail "$f must show the weigh replies as one block (found: in one line beside its own)"
  else
    pass "$f does not give the weigh verdicts in one line beside its own"
  fi
done

# rules.md holds what applies in every session; step 2's procedure is in mentat:propose, and its standing lines stay.
phrase_check rules.md "what it holds and where a step's procedure lives" "This file holds what applies in every session; a step's procedure lives in its skill."
phrase_check rules.md "step 2's call of mentat:propose" "Claude Code calls the Skill tool with \`mentat:propose\` before giving a view, or after a one-line view of a small, clear request."
phrase_check rules.md "that a DO IT is not agreement" "A \`DO IT\` is not the maintainer's agreement."
phrase_check rules.md "that the maintainer agrees once" 'The maintainer agrees once.'
phrase_check rules.md "that agreed work is not weighed again" 'Agreed work is not weighed again.'
phrase_check rules.md "that only the maintainer turns on a fast track" 'Only the maintainer turns on a fast track.'

# Reviews that run at once in one checkout must not share its record of the last fetch.
if grep -l FETCH_HEAD lib/*.sh; then
  fail "a script under lib/ reads FETCH_HEAD, which concurrent reviews in one checkout share"
else
  pass "no script under lib/ reads FETCH_HEAD"
fi

if [ -z "$(git ls-files .claude)" ]; then
  pass "nothing under .claude/ is version-controlled"
else
  fail ".claude/ must not be version-controlled (settings are the maintainer's own)"
fi

# hooks.json runs the SessionStart hook once, which is what loads rules.md.
if command -v jq >/dev/null 2>&1; then
  if jq -e '.hooks.SessionStart | length == 1 and (.[0].hooks | length == 1) and (.[0].hooks[0].command | endswith("/hooks/session-start"))' hooks/hooks.json >/dev/null; then
    pass "hooks.json runs hooks/session-start as its one SessionStart command"
  else
    fail "hooks.json must have exactly one SessionStart command, ending in /hooks/session-start"
  fi
else
  fail "jq not installed, SessionStart wiring not checked"
fi

# The SessionStart hook prints rules.md unchanged, within Claude Code's
# 10,000-character limit for the output of a hook.
if hook_out=$(hooks/session-start); then
  if [ "$hook_out" != "$(cat rules.md)" ]; then
    fail "hooks/session-start output differs from rules.md"
  elif [ "${#hook_out}" -ge 10000 ]; then
    fail "hooks/session-start prints ${#hook_out} characters (limit 10000)"
  else
    pass "hooks/session-start prints rules.md (${#hook_out} characters)"
  fi
else
  fail "hooks/session-start exited non-zero"
fi
# The file is found relative to the plugin root, not the working directory.
hook_script=$PWD/hooks/session-start
if hook_out=$(cd /tmp && "$hook_script") && [ "$hook_out" = "$(cat rules.md)" ]; then
  pass "hooks/session-start prints the same from another directory"
else
  fail "hooks/session-start differs when run from another directory"
fi

# Each skill's name matches its folder, which is how Claude Code finds it.
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  dir=${f%/SKILL.md}
  # Only the frontmatter block at the top of the file counts.
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == want { found = 1; exit 0 } END { exit !found }' want="name: ${dir#skills/}" "$f"; then
    pass "$f is named ${dir#skills/}"
  else
    fail "$f must set name: ${dir#skills/}"
  fi
done

# rules.md names each workflow skill as a Skill tool call: every name it uses
# has a skill, and every skill the agent can call is named there or in a skill
# rules.md names (a step's procedure, such as mentat:propose, names the skills
# it calls). Each skill stays under 15,000 characters, a house limit toward
# Claude Code's budget for skill text kept after compaction.
named_by=rules.md
while IFS= read -r name; do
  [ -n "$name" ] || continue
  if [ -f "skills/$name/SKILL.md" ]; then
    pass "rules.md names mentat:$name, which exists"
    named_by="$named_by skills/$name/SKILL.md"
  else
    fail "rules.md names mentat:$name, but skills/$name/SKILL.md is missing"
  fi
done <<< "$(grep -ho 'mentat:[a-z-]*' rules.md | sed 's/^mentat://' | sort -u)"
# Paths in named_by have no spaces: skill names are [a-z-].
is_named() {
  local g
  for g in $named_by; do
    if grep -q "mentat:$1\`" "$g"; then return 0; fi
  done
  return 1
}
for f in skills/*/SKILL.md; do
  [ -e "$f" ] || continue
  name=${f#skills/}; name=${name%/SKILL.md}
  if awk 'NR == 1 && $0 != "---" { exit 1 } NR > 1 && $0 == "---" { exit 1 } NR > 1 && $0 == "disable-model-invocation: true" { found = 1; exit 0 } END { exit !found }' "$f"; then
    pass "$f is started by the maintainer, not named in rules.md"
  elif is_named "$name"; then
    pass "$f is named in rules.md or a skill it names"
  else
    fail "$f can be called by the agent but neither rules.md nor a skill it names names mentat:$name"
  fi
  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -lt 15000 ]; then
    pass "$f is $size characters (limit 15000)"
  else
    fail "$f is $size characters (limit 15000)"
  fi
done

# mentat review, review --local, review --grok, challenge, weigh, consult and check behave as
# specified (stub gh, codex and grok), and so does the merge hook and the push hook.
if command -v jq >/dev/null 2>&1; then
  for t in tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh; do
    if out=$("$t" 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; fail "$t"; fi
  done
else
  fail "jq not installed, mentat review, challenge, check and the hooks not tested"
fi

# The plugin's manifests validate (warnings are fine, only a failure counts).
if command -v claude >/dev/null 2>&1; then
  if out=$(claude plugin validate . 2>&1); then
    pass "claude plugin validate ."
  else
    printf '%s\n' "$out"
    fail "claude plugin validate ."
  fi
else
  fail "claude not installed, the plugin manifests not validated"
fi

# The CI workflow declares permissions and pins every action to a commit (a
# check of form, not of least privilege).
workflow=.github/workflows/tests.yml
if [ -f "$workflow" ] && grep -q '^permissions:' "$workflow" \
  && ! grep -E '^[[:space:]-]*uses:' "$workflow" \
    | grep -Evq '^[[:space:]-]*uses:[[:space:]]+[A-Za-z0-9._-]+/[A-Za-z0-9._-]+@[0-9a-f]{40}([[:space:]]+#.*)?$'; then
  pass "$workflow declares permissions and pins every action to a commit"
else
  fail "$workflow must exist, declare explicit permissions, and pin every action to a 40-hex commit (uses: owner/repo@<sha>)"
fi

# Shell scripts pass shellcheck.
if command -v shellcheck >/dev/null 2>&1; then
  if shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh; then
    pass "shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh"
  else
    fail "shellcheck tests/run hooks/session-start hooks/no-merge hooks/no-default-push bin/mentat lib/*.sh tests/review.sh tests/review-local.sh tests/review-grok.sh tests/challenge.sh tests/weigh.sh tests/consult.sh tests/check.sh tests/no-merge.sh tests/no-default-push.sh"
  fi
else
  fail "shellcheck not installed, shell scripts not checked"
fi

if [ "$failures" -gt 0 ]; then
  printf '%d check(s) failed\n' "$failures"
  exit 1
fi
printf 'All checks passed\n'

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/public-text" }
        ]
      },
      {
        "matcher": "^mcp__.+__(add_comment_to_pending_review|add_issue_comment|add_reply_to_pull_request_comment|create_pull_request|create_pull_request_with_copilot|discussion_comment_write|issue_write|pull_request_review_write|update_issue_comment|update_pull_request)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/public-text" }
        ]
      }
    ]
  }
}

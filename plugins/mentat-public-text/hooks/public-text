#!/usr/bin/env bash
# PreToolUse hook: denies GitHub text an agent is about to publish when it holds a word
# from ~/.config/mentat/private-words or a local home path, or when it cannot read that
# text from the command alone. It never asks. Turning the module on in a repository is
# what says that repository's text is public.
# For Bash it reads the command as the shell would and checks only gh writes: pr create,
# new, edit, comment, review and close; issue create, new, edit, comment and close;
# release create and edit; and gh api with a write method, or with fields and no GET,
# where graphql counts unless its query is known and is no mutation. It checks that
# command's own words but its -R/--repo, --template and --recover values, the api
# endpoint and api --jq and --template values, which only format the reply, and a release
# asset's folder; and the files it reads (--body-file, -F, --notes-file, --input,
# field=@file), named literally or under ~/, $HOME, $PWD, $(pwd) or $TMPDIR unless the line
# assigns that variable, from where a cd before it in the line moved. Text gh derives itself, standard input gh does not read,
# missing or unreadable files and other commands' words are not checked.
# It denies, with the retry in the reason, a gh write whose text it cannot read: a
# variable, $( ), backticks, or any $ in double quotes, in body, notes or field text or in
# a file's name, also a flag's attached value as in -F"$f", or a relative file after a cd
# it cannot follow (write the text to a file and pass that); the same in another word it
# publishes or that makes it a write, such as a title, number, branch, label or the gh
# command itself (write the value out literally); text gh reads from standard input (-);
# and a file a command before it in the line writes or may write (write it in an earlier
# call): one written by > or >>, or one named, also after = as in of=file, by any command
# other than cat, cd, pwd, gh, [, [[, test, ls, wc, grep, head, tail, stat, git, jq,
# diff, echo, printf, rg, chmod, chown, touch, open, sed without -i, -I or --in-place,
# and awk without -i or --include.
# For the GitHub MCP server's writes that carry free text (issues, pull requests, reviews,
# comments, merges, gists, files and repositories), under current and older tool names,
# it looks at every text value but owner and repo. A call is that server's when its input
# has owner and repo, or when it makes a gist or a repository.
# The reason gives the category, never the match. This is a net for mistakes, not a
# security boundary: other routes exist. When it cannot read its input, jq is missing, or
# the command is over 50 KB or 6,000 steps outside heredocs or nests over 100 levels
# below the top level (a subshell, $( ) or <( ) each counts one), it allows the call and
# says so on stderr. A file over 1 MB feeding a gh write is not checked, with a note on
# stderr; the rest of the call is.
set -uo pipefail

# Notes for text a gh write lets through unchecked, printed when the call is allowed.
notes=""
note() { case "$notes" in *"$1"*) ;; *) notes+="mentat-public-text: $1, so that file's text is allowed unchecked"$'\n' ;; esac; }
allow() { printf '%smentat-public-text: %s; the call is allowed unchecked\n' "$notes" "$1" >&2; exit 0; }
command -v jq >/dev/null 2>&1 || allow "jq is not installed"
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.tool_name // empty' 2>/dev/null) || allow "could not read the hook input"

home=${HOME:-}
PRIVATE_WORDS="$home/.config/mentat/private-words"
lc_set=${LC_ALL+x} lc_val=${LC_ALL-}
# A home folder written out with a name, as /Users/<name>/ or /home/<name>/, or this
# machine's as a whole path. ~/, /Users/Shared/, the homes of CI runners and containers
# such as /home/runner/, and a placeholder name such as /Users/you/ name no one, so they
# are no hit.
home_re='(^|[^[:alnum:]_.-])(/Users|/home)/[[:alnum:]_.-]+/'
placeholder_re='(/Users|/home)/(you|me|user|username|name|runner)/|/Users/Shared/|/home/(linuxbrew|ubuntu|node|vscode|ec2-user)/'

# Prints the category of the first hit in text $1, or returns 1 with none. Each line of
# the word list is a fixed string, ignoring case. A line starting with exact: matches
# the rest only in that case and as a whole word. Blank lines, lines starting with # and
# a line that is only exact: are skipped. A missing, unreadable or empty list matches no
# word. Here-strings, not pipes: under pipefail, grep -q stopping early on long text
# would read as no hit. It matches in the caller's locale.
private_text() {
  local words exact this_home
  if [ -n "$lc_set" ]; then LC_ALL=$lc_val; else unset LC_ALL; fi
  # This machine's home folder, as a whole path.
  this_home='(^|[^[:alnum:]_./~-])'$(printf '%s' "$home" | sed 's/[][\.*^$+?(){}|]/\\&/g')'([^[:alnum:]_]|$)'
  if { [ -n "$home" ] && [ "$home" != / ] && grep -aiqE -e "$this_home" <<<"$1"; } ||
    grep -aqE -e "$home_re" <<<"$(sed -E "s#$placeholder_re#_#g" <<<"$1")"; then
    printf 'a local path'; return 0
  fi
  words=$(grep -v -e '^[[:space:]]*$' -e '^#' -e '^exact:' "$PRIVATE_WORDS" 2>/dev/null)
  exact=$(sed -n 's/^exact:\(..*\)$/\1/p' "$PRIVATE_WORDS" 2>/dev/null)
  if { [ -n "$words" ] && grep -aiqF -e "$words" <<<"$1"; } ||
    { [ -n "$exact" ] && grep -aqFw -e "$exact" <<<"$1"; }; then
    printf 'a configured private name'; return 0
  fi
  return 1
}
refuse() {
  jq -n --arg r "Mentat: $1" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
  exit 0
}
deny() { refuse "this text for a public repository holds $1, so it was not published. Take it out of the text, or of the file the text comes from."; }
# unread_deny <class>: denies a gh write whose text the hook cannot read, saying how to
# retry.
unread_deny() {
  case "$1" in
    text) refuse "this command builds text for a public repository from a variable or a command, which the check cannot read from the command alone, so it was not published. Write the text to a file in an earlier call, then pass that file by a path written out (--body-file, --notes-file, -F field=@file or --input)." ;;
    value) refuse "a value this command publishes to a public repository, or one that makes it a write, comes from a variable or a command, which the check cannot read from the command alone, so it was not published. Write the value out literally." ;;
    stdin) refuse "this command passes text for a public repository on standard input, which the check cannot read, so it was not published. Write the text to a file in an earlier call, then pass that file in place of -." ;;
    *) refuse "a file this command publishes to a public repository is written, or may be changed, earlier in the same command, so the check cannot read it and it was not published. Write the file in an earlier call, then publish it in a call of its own." ;;
  esac
}

# The GitHub MCP server's writes, by tool name under any server name. A call is the GitHub
# server's when its input has owner and repo, or when it makes a gist or a repository.
mcp_writes='^mcp__.+__(add_comment_to_pending_review|add_issue_comment|add_reply_to_pull_request_comment|create_gist|create_issue|create_or_update_file|create_pull_request|create_pull_request_review|create_pull_request_with_copilot|create_repository|discussion_comment_write|issue_write|merge_pull_request|pull_request_review_write|push_files|sub_issue_write|submit_pending_pull_request_review|update_gist|update_issue|update_issue_comment|update_pull_request)$'
if [[ $tool =~ $mcp_writes ]]; then
  case "$tool" in
    *__create_gist | *__update_gist | *__create_repository) ;;
    *)
      github=$(printf '%s' "$input" | jq -r '.tool_input | type == "object" and has("owner") and has("repo")' 2>/dev/null) ||
        allow "could not read the tool input"
      [ "$github" = true ] || exit 0
      ;;
  esac
  text=$(printf '%s' "$input" | jq -r '[.tool_input | paths(type == "string") as $p
    | select(($p | last) as $k | $k != "owner" and $k != "repo") | getpath($p)] | join("\n")' 2>/dev/null) ||
    allow "could not read the tool input"
  hit=$(private_text "$text") || exit 0
  deny "$hit"
fi
[ "$tool" = Bash ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null) || allow "could not read the command"
# The walk reads bytes, which keeps it fast on long text.
LC_ALL=C
re_gh='(^|[^[:alnum:]_.-])gh([^[:alnum:]_.-]|$)'
[[ $cmd =~ $re_gh ]] || exit 0
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null) || allow "could not read the working folder"
[ -n "$cwd" ] || cwd=$PWD

# The walk's time grows with the text it reads outside heredocs times its steps (a word,
# quote, expansion or operator each), so it stops past this many bytes or steps, and past
# this many levels nested below the top.
walk_max=50000 step_max=6000 depth_max=100
cmd_len=${#cmd} h_used=0 steps=0 depth=-1
case "$cmd" in *'<<'*) ;; *) [ "$cmd_len" -le "$walk_max" ] || allow "the command is over 50 KB outside heredocs" ;; esac
# over: stops the walk once it has read more than walk_max bytes outside heredocs.
over() { [ $((cmd_len - ${#src} - h_used)) -le "$walk_max" ] || allow "the command is over 50 KB outside heredocs"; }
tick() {
  steps=$((steps + 1))
  [ "$steps" -le "$step_max" ] || allow "the command takes over $step_max steps to read outside heredocs"
  [ $((steps % 64)) -ne 0 ] || over
}

sq="'" bq='`' nl=$'\n' tab=$'\t'
re_blank=$'^([ \t]|\\\\\n)+'
re_plain="^[^ $tab$nl;&|()<>$sq\"\\\\\$$bq]+"
re_dq="^[^\"\\\\\$$bq]+"
re_sq="^[^$sq]*"
re_ansi="^\\\$$sq(([^$sq\\\\]|\\\\.)*)$sq?"
re_bq="^$bq([^$bq\\\\]|\\\\.)*$bq?"
re_line="^[^$nl]*"
re_comment="^#[^$nl]*"
re_name='^[A-Za-z_][A-Za-z0-9_]*'
re_assign='^[A-Za-z_][A-Za-z0-9_]*='
re_folder='^(HOME|PWD|TMPDIR)(\[[^]=]*\])?\+?='
re_brace='^\$\{([^}]*)\}'
re_pwd='^\$\([[:space:]]*pwd[[:space:]]*\)'
re_op='^(&&|\|\||\|&|;;|&>>|&>|[;&|])'
re_redir='^(<<<|<<-|<<|<>|<&|<\(|>>|>&|>\||>\(|<|>)'
re_fd='^([0-9]+)[<>]'
re_mutation='(^|[^A-Za-z0-9_])mutation([^A-Za-z0-9_]|$)'
re_parens='^[^()]+'
file_max=1048576

# What the walk keeps. A word has its text as published, its text as a file name, whether
# that name is known (no expansion in it but the home, working and temporary folders),
# and whether it is literal (no expansion at all). A command has its words and the words
# its > and >> redirects name. The files the line writes or may write are kept by name.
src=$cmd
w_text=() w_path=() w_ok=() w_lit=() w_quoted=() w_assign=() nw=0
c_words=() c_outs=() nc=0
h_delim=() h_strip=() nh=0 pend=""
f_path=() nf=0
# The folder variables the line assigns, each as " NAME ".
v_set=""

# value <name>: sets x_path for $name, the home, working or temporary folder; any other
# name, or one of those the line assigns, leaves it unknown.
value() {
  case "$v_set" in *" $1 "*) x_ok=""; return ;; esac
  case "$1" in
    HOME) x_path=$home ;;
    PWD) x_path=$cwd; [ -n "$cwd" ] || x_ok="" ;;
    TMPDIR) if [ -n "${TMPDIR:-}" ]; then x_path=$TMPDIR; else x_ok=""; fi ;;
    *) x_ok="" ;;
  esac
}
close() { [ "${src:0:1}" != ')' ] || src=${src:1}; }
# arith: skips arithmetic from just after its (( to just after the matching )).
arith() {
  local open=2
  while [ -n "$src" ] && [ "$open" -gt 0 ]; do
    tick
    if [[ $src =~ $re_parens ]]; then src=${src:${#BASH_REMATCH[0]}}; continue; fi
    if [ "${src:0:1}" = '(' ]; then open=$((open + 1)); else open=$((open - 1)); fi
    src=${src:1}
  done
}
# sublist: reads a list up to its ), which runs in a subshell.
sublist() {
  local saved=$cwd
  parse_list ')'
  cwd=$saved
  close
}
# dollar: reads a $ form into x_text, x_path, x_ok and x_lit. Only $'...' and a $ that
# starts nothing are literal; $(pwd) is the working folder.
dollar() {
  local rest name
  x_text="" x_path="" x_ok=1 x_lit=""
  case "${src:1:1}" in
    '(')
      if [ "${src:2:1}" = '(' ]; then src=${src:3}; arith; x_ok=""; return; fi
      if [[ $src =~ $re_pwd ]]; then src=${src:${#BASH_REMATCH[0]}}; value PWD; return; fi
      src=${src:2}; sublist; x_ok=""
      ;;
    '{')
      if [[ $src =~ $re_brace ]]; then
        src=${src:${#BASH_REMATCH[0]}}; value "${BASH_REMATCH[1]}"
      else
        x_text='$' x_path='$' x_lit=1 src=${src:1}
      fi
      ;;
    "$sq") [[ $src =~ $re_ansi ]]; x_text=${BASH_REMATCH[1]} x_path=${BASH_REMATCH[1]} x_lit=1 src=${src:${#BASH_REMATCH[0]}} ;;
    [A-Za-z_]) rest=${src:1}; [[ $rest =~ $re_name ]]; name=${BASH_REMATCH[0]}; src=${src:$((${#name} + 1))}; value "$name" ;;
    [0-9] | [?\$!#@*-]) src=${src:2}; x_ok="" ;;
    *) x_text='$' x_path='$' x_lit=1 src=${src:1} ;;
  esac
}
backtick() { [[ $src =~ $re_bq ]]; src=${src:${#BASH_REMATCH[0]}}; }
# dquote: reads the rest of a double-quoted string into d_text, d_path and d_ok. Any $ or
# backtick in it makes it not literal.
dquote() {
  local text="" path="" ok=1 t c
  d_lit=1
  while [ -n "$src" ]; do
    tick
    if [[ $src =~ $re_dq ]]; then t=${BASH_REMATCH[0]}; text+=$t path+=$t src=${src:${#t}}; continue; fi
    c=${src:0:1}
    case "$c" in
      '"') src=${src:1}; break ;;
      \\)
        c=${src:1:1}; src=${src:2}
        case "$c" in
          "$nl") ;;
          '$' | "$bq" | '"' | \\) text+=$c path+=$c ;;
          *) text+=\\$c path+=\\$c ;;
        esac
        ;;
      '$')
        d_lit=""
        # $' and $" are a plain $ inside double quotes.
        case "${src:1:1}" in "$sq" | '"') text+='$' path+='$' src=${src:1}; continue ;; esac
        dollar; text+=$x_text path+=$x_path; [ -n "$x_ok" ] || ok=""
        ;;
      *) backtick; ok="" d_lit="" ;;
    esac
  done
  d_text=$text d_path=$path d_ok=$ok
}
# word: reads one word; $wi is its index, and w_moved is set when it read any text. ~ at
# its start is the home folder as a file name, and stays ~ as text.
word() {
  local text="" path="" ok=1 lit=1 quoted="" assign="" t c
  w_moved=""
  if [[ $src =~ $re_assign ]]; then assign=1; fi
  # An assignment to a folder variable, in any command, makes it unknown from here on.
  if [[ $src =~ $re_folder ]]; then v_set+=" ${BASH_REMATCH[1]} "; fi
  if [ "${src:0:1}" = '~' ]; then
    case "${src:1:1}" in '' | / | ' ' | "$tab" | "$nl" | ';' | '&' | '|' | ')' | '<' | '>') text='~' path=$home src=${src:1} w_moved=1 ;; esac
    case "$v_set" in *" HOME "*) ok="" ;; esac
  fi
  while [ -n "$src" ]; do
    tick
    if [[ $src =~ $re_plain ]]; then t=${BASH_REMATCH[0]}; text+=$t path+=$t src=${src:${#t}} w_moved=1; continue; fi
    c=${src:0:1}
    case "$c" in \\ | "$sq" | '"' | '$' | "$bq") w_moved=1 ;; *) break ;; esac
    case "$c" in
      \\) c=${src:1:1}; src=${src:2}; quoted=1; [ "$c" = "$nl" ] || { text+=$c path+=$c; } ;;
      "$sq") src=${src:1}; [[ $src =~ $re_sq ]]; t=${BASH_REMATCH[0]}; text+=$t path+=$t src=${src:$((${#t} + 1))} quoted=1 ;;
      '"') src=${src:1}; dquote; text+=$d_text path+=$d_path quoted=1; [ -n "$d_ok" ] || ok=""; [ -n "$d_lit" ] || lit="" ;;
      '$')
        if [ "${src:1:1}" = '"' ]; then src=${src:1}; continue; fi
        dollar; text+=$x_text path+=$x_path; [ -n "$x_ok" ] || ok=""; [ -n "$x_lit" ] || lit=""
        ;;
      "$bq") backtick; ok="" lit="" ;;
    esac
  done
  wi=$nw nw=$((nw + 1))
  w_text[wi]=$text w_path[wi]=$path w_ok[wi]=$ok w_lit[wi]=$lit w_quoted[wi]=$quoted w_assign[wi]=$assign
}
new_cmd() { cur=$nc c_words[nc]="" c_outs[nc]="" nc=$((nc + 1)); }
# redirect [operator]: reads a redirect of the current command, keeping the word of a >
# or >> and the delimiter of a heredoc.
redirect() {
  local op=${1-} saved
  if [ -z "$op" ]; then [[ $src =~ $re_redir ]]; op=${BASH_REMATCH[0]}; src=${src:${#op}}; fi
  [ -n "$cur" ] || new_cmd
  case "$op" in '<(' | '>(') saved=$cwd; parse_list ')'; cwd=$saved; close; return ;; esac
  if [[ $src =~ $re_blank ]]; then src=${src:${#BASH_REMATCH[0]}}; fi
  case "${src:0:1}" in '' | "$nl" | ';' | '&' | '|' | '(' | ')' | '<' | '>') return ;; esac
  word
  case "$op" in
    '<<' | '<<-')
      h_delim[nh]=${w_text[wi]} h_strip[nh]=""
      [ "$op" = '<<' ] || h_strip[nh]=1
      pend+=" $nh" nh=$((nh + 1))
      ;;
    '>&') [[ ${w_text[wi]} =~ ^([0-9]+|-)$ ]] || c_outs[cur]+=" $wi" ;;
    '>' | '>>' | '>|') c_outs[cur]+=" $wi" ;;
  esac
}
# heredocs: skips the bodies of the heredocs started on the line just ended.
heredocs() {
  local id line
  for id in $pend; do
    while [ -n "$src" ]; do
      [[ $src =~ $re_line ]]; line=${BASH_REMATCH[0]}; src=${src:$((${#line} + 1))} h_used=$((h_used + ${#line} + 1))
      if [ -n "${h_strip[id]}" ]; then while [ "${line:0:1}" = "$tab" ]; do line=${line:1}; done; fi
      [ "$line" != "${h_delim[id]}" ] || break
    done
  done
  pend=""
}
end_cmd() { [ -z "$cur" ] || pipe+=" $cur"; cur=""; }
end_pipe() {
  end_cmd
  [ -n "$pipe" ] || return 0
  queue+=$pipe$nl pipe=""
}
# flush: runs the pipelines read so far, in order.
flush() {
  local p
  [ -n "$queue" ] || return 0
  over
  while IFS= read -r p; do
    # shellcheck disable=SC2086 # p holds command numbers.
    [ -z "$p" ] || run_pipe $p
  done <<<"$queue"
  queue=""
}
# parse_list <stop>: reads commands up to the end, or up to a ) when stop is ). It runs
# each pipeline once its line's heredocs are read.
parse_list() {
  local stop=$1 queue="" pipe="" cur="" c t saved lead="" in_test=""
  depth=$((depth + 1))
  [ "$depth" -le "$depth_max" ] || allow "the command is nested over $depth_max levels deep"
  while :; do
    tick
    if [[ $src =~ $re_blank ]]; then src=${src:${#BASH_REMATCH[0]}}; fi
    [ -n "$src" ] || break
    c=${src:0:1}
    case "$c" in
      "$nl") src=${src:1} lead="" in_test=""; end_pipe; heredocs; flush ;;
      '#') [[ $src =~ $re_comment ]]; src=${src:${#BASH_REMATCH[0]}} ;;
      ')') [ "$stop" != ')' ] || break; src=${src:1}; end_pipe; [ -n "$pend" ] || flush ;;
      '(')
        # An arithmetic command prints nothing.
        if [ -z "$cur" ] && [ "${src:1:1}" = '(' ]; then src=${src:2}; arith; continue; fi
        # A subshell, or the () of a function definition, whose body is a new command.
        src=${src:1}; t=$cur
        [ -n "$cur" ] || new_cmd
        saved=$cwd; parse_list ')'; cwd=$saved; close
        [ -z "$t" ] || end_pipe
        ;;
      ';' | '&' | '|')
        [[ $src =~ $re_op ]]; t=${BASH_REMATCH[0]}; src=${src:${#t}}
        # && and || inside [[ ]] join its tests.
        if [ -n "$in_test" ]; then
          case "$t" in '&&' | '||') continue ;; esac
        fi
        lead="" in_test=""
        case "$t" in
          '&>' | '&>>') redirect "${t#&}" ;;
          '|' | '|&') end_cmd ;;
          *) end_pipe; [ -n "$pend" ] || flush ;;
        esac
        ;;
      '<' | '>') redirect ;;
      *)
        if [[ $src =~ $re_fd ]]; then src=${src:${#BASH_REMATCH[1]}}; continue; fi
        word
        [ -n "$w_moved" ] || src=${src:1}
        [ -n "$cur" ] || { new_cmd; lead=1; }
        c_words[cur]+=" $wi"
        # A [[ that starts a command, after any keywords, opens a test up to its ]].
        t=${w_text[wi]}
        [ -z "${w_quoted[wi]}" ] || t=""
        if [ -n "$lead" ]; then
          case "$t" in
            '[[') in_test=1 lead="" ;;
            if | elif | while | until | '!' | then | do | else | '{' | time) ;;
            *) lead="" ;;
          esac
        elif [ "$t" = ']]' ]; then
          in_test=""
        fi
        ;;
    esac
  done
  end_pipe
  [ -n "$stop" ] || heredocs
  flush
  depth=$((depth - 1))
}
run_pipe() {
  local id
  for id in "$@"; do run_cmd "$id" "$#"; done
}

# full_path <path>: sets fp to the path from /, without its ./ parts. Returns 1 when the
# working folder is unknown.
full_path() {
  fp=$1
  case "$fp" in /*) ;; *) [ -n "$cwd" ] || return 1; fp=$cwd/$fp ;; esac
  while :; do
    case "$fp" in
      */./*) fp=${fp//\/.\//\/} ;;
      */.) fp=${fp%/.} ;;
      *) return 0 ;;
    esac
  done
}
# changed <path>: succeeds when a command before this one in the line writes or may write
# the file at that full path.
changed() {
  local k=$nf
  while [ "$k" -gt 0 ]; do
    k=$((k - 1))
    [ "${f_path[k]}" != "$1" ] || return 0
  done
  return 1
}
# touched <word>...: a command that may write the files it names, as a word or after an =
# (of=file, --output=file), or that a > or >> names, may change them from here on.
touched() {
  local i p
  for i in "$@"; do
    [ -n "${w_ok[i]}" ] || continue
    p=${w_path[i]}
    if full_path "$p"; then f_path[nf]=$fp nf=$((nf + 1)); fi
    case "$p" in *=*) p=${p#*=} ;; *) continue ;; esac
    if [ -n "$p" ] && full_path "$p"; then f_path[nf]=$fp nf=$((nf + 1)); fi
  done
}
# writes <command> <word>...: succeeds unless the command is one the header lists as not
# writing the files it names.
writes() {
  local name=$1 i
  shift
  case "$name" in
    cat | pwd | '[' | '[[' | test | ls | wc | grep | head | tail | stat | git | jq | diff | echo | printf | rg | chmod | chown | touch | open) return 1 ;;
    sed) for i in "$@"; do case "${w_text[i]}" in --in-place* | -[!-]*[iI]* | -[iI]*) return 0 ;; esac; done; return 1 ;;
    awk) for i in "$@"; do case "${w_text[i]}" in -i* | --include*) return 0 ;; esac; done; return 1 ;;
  esac
}
change_dir() {
  local p
  while [ $# -gt 0 ]; do case "${w_text[$1]}" in -L | -P | -e | -@) shift ;; *) break ;; esac; done
  if [ $# -eq 0 ]; then
    case "$v_set" in *" HOME "*) cwd=""; return ;; esac
    p=$home
  else
    { [ -n "${w_ok[$1]}" ] && [ "${w_text[$1]}" != - ]; } || { cwd=""; return; }
    p=${w_path[$1]}
    case "$p" in /*) ;; *) [ -n "$cwd" ] || return 0; p=$cwd/$p ;; esac
  fi
  if [ -d "$p" ]; then cwd=$p; else cwd=""; fi
}

# What gh_write gathers: why is the first reason its text cannot be read, rd the files
# it reads.
# unread <class>: notes why a gh write's text cannot be read, keeping the first reason.
unread() { [ -n "$why" ] || why=$1; }
# file <word> <value> <path> [query]: the file a flag names, or standard input for -. A
# graphql query that cannot be read is unknown.
file() {
  local q=${4-}
  if [ "$2" = - ]; then unread stdin
  elif [ -z "${w_ok[$1]}" ] || ! full_path "$3"; then unread text
  elif changed "$fp"; then unread changed; q=1
  elif [ -f "$fp" ] && [ -r "$fp" ]; then rd[nrd]=$fp nrd=$((nrd + 1)); return
  fi
  [ -z "$q" ] || q_unknown=1
}
# armed: a flag whose value came attached to it in an expansion, as -F"$f", takes no
# next word, and its value is unread.
armed() {
  case "$next" in
    file | field | raw) unread text ;;
    input) unread text; q_seen=1 q_unknown=1 ;;
    method) unsure=1 ;;
    text) unread "$a_cls" ;;
  esac
  next=""
}
# field <word> <key=value> [raw]: adds a gh api field: the file after =@, unless raw, else
# the text.
field() {
  local q=""
  case "$2" in query=*) q_seen=1 q=1 ;; esac
  if [ -z "${3-}" ]; then
    case "$2" in *=@*) file "$1" "${2#*=@}" "${w_path[$1]#*=@}" "$q"; return ;; esac
  fi
  pub+=$2$nl
  [ -n "${w_lit[$1]}" ] || { unread text; [ -z "$q" ] || q_unknown=1; }
}
# put <word> <class> [text]: publishes a word, or the text given for it; any expansion in
# it is unread text of that class.
put() {
  pub+=${3-${w_text[$1]}}$nl
  [ -n "${w_lit[$1]}" ] || unread "$2"
}
# gh_write <maybe> <word>...: denies a gh write whose text has a hit or cannot be read.
# maybe is set when the command's name is not literal, so it may be gh. A group, a pr,
# issue or release command, or a method that is not literal makes the call unsure, so
# it counts as a write.
gh_write() {
  local maybe=$1 unsure="" i t v p prev="" group="" verb="" tag="" endpoint="" next="" method="" fields="" pub="" got="" hit cls
  local q_seen="" q_unknown="" why="" over="" rd=() nrd=0 k a_lit=1 a_cls=""
  shift
  for i in "$@"; do
    t=${w_text[i]} p=$prev prev=$t
    # Body and notes text have a file form; other values do not. A word's text holds only
    # its literal part, so -b"$x" reads as -b.
    case "$p" in -b | --body | -n | --notes) cls=text ;; *) cls=value ;; esac
    case "$t" in --body=* | -b* | --notes=* | -n*) cls=text ;; esac
    [ -z "$next" ] || [ -n "$a_lit" ] || armed
    a_lit=${w_lit[i]} a_cls=$cls
    case "$next" in
      skip) next=""; continue ;;
      file) next=""; file "$i" "$t" "${w_path[i]}"; continue ;;
      input) next="" q_seen=1; file "$i" "$t" "${w_path[i]}" 1; continue ;;
      field) next=""; field "$i" "$t"; continue ;;
      raw) next=""; field "$i" "$t" raw; continue ;;
      method) next="" method=$t; [ -n "${w_lit[i]}" ] || unsure=1; continue ;;
      text) next=""; put "$i" "$cls"; continue ;;
    esac
    case "$t" in
      -R | --repo) next=skip; continue ;;
      -R?* | --repo=*) continue ;;
      --body-file | --notes-file) next="file"; continue ;;
      --body-file=* | --notes-file=*) file "$i" "${t#*=}" "${w_path[i]#*=}"; continue ;;
    esac
    if [ -z "$group" ]; then
      case "$t" in
        -*) put "$i" value ;;
        *) group=$t; [ -n "${w_lit[i]}" ] || unsure=1 ;;
      esac
      continue
    fi
    if [ "$group" = api ]; then
      case "$t" in
        -X | --method) next=method; continue ;;
        -X?* | --method=*) v=${t#--method=}; v=${v#-X}; method=${v#=}; [ -n "${w_lit[i]}" ] || unsure=1; continue ;;
        -F | --field) next=field fields=1; continue ;;
        -F?* | --field=*) v=${t#--field=}; v=${v#-F}; fields=1; field "$i" "${v#=}"; continue ;;
        -f | --raw-field) next=raw fields=1; continue ;;
        -f?* | --raw-field=*) v=${t#--raw-field=}; v=${v#-f}; fields=1; field "$i" "$v" raw; continue ;;
        --input) next=input fields=1; continue ;;
        --input=*) fields=1 q_seen=1; file "$i" "${t#*=}" "${w_path[i]#*=}" 1; continue ;;
        # --jq and --template only format the reply here.
        -q | --jq | -t | --template) next=skip; continue ;;
        -q?* | --jq=* | -t?* | --template=*) continue ;;
        -H | --header | --cache | -p | --preview | --hostname) next=text ;;
        -*) ;;
        *) if [ -z "$endpoint" ]; then endpoint=$t; continue; fi ;;
      esac
    else
      # A template and a recover file only fill in the form; a release's assets publish
      # only their names.
      case "$t" in
        -F) next="file"; continue ;;
        -F?*) v=${w_path[i]#-F}; file "$i" "${t#-F}" "${v#=}"; continue ;;
        -T | --template | --recover) next=skip; continue ;;
        -T?* | --template=* | --recover=*) continue ;;
        -t | --title | -n | --notes | --target | --discussion-category | --notes-start-tag) [ "$group" != release ] || next=text ;;
        -*) ;;
        *)
          if [ -z "$verb" ]; then
            verb=$t
            [ -n "${w_lit[i]}" ] || case "$group" in pr | issue | release) unsure=1 ;; esac
            continue
          fi
          if [ "$group" = release ]; then
            if [ -n "$tag" ]; then
              if [ -n "${w_ok[i]}" ]; then pub+=${w_path[i]##*/}$nl; else unread value; fi
              continue
            fi
            tag=1
          fi
          ;;
      esac
    fi
    put "$i" "$cls"
  done
  [ -z "$next" ] || [ -n "$a_lit" ] || armed
  if [ -n "$maybe" ]; then
    case "$group" in pr | issue | release | api) ;; *) return 0 ;; esac
  fi
  if [ -z "$unsure" ]; then
    case "$group" in
      pr) case "$verb" in create | new | edit | comment | review | close) ;; *) return 0 ;; esac ;;
      issue) case "$verb" in create | new | edit | comment | close) ;; *) return 0 ;; esac ;;
      release) case "$verb" in create | edit) ;; *) return 0 ;; esac ;;
      api)
        case "$method" in
          "") [ -n "$fields" ] || return 0 ;;
          [Pp][Oo][Ss][Tt] | [Pp][Uu][Tt] | [Pp][Aa][Tt][Cc][Hh] | [Dd][Ee][Ll][Ee][Tt][Ee]) ;;
          *) return 0 ;;
        esac
        ;;
      *) return 0 ;;
    esac
  fi
  [ -z "$unsure$maybe" ] || unread value
  # A file's text is read only once the command is known to be a write.
  k=0
  while [ "$k" -lt "$nrd" ]; do
    t=$(head -c $((file_max + 1)) "${rd[k]}")
    k=$((k + 1))
    if [ "${#t}" -gt "$file_max" ]; then over=1; continue; fi
    got+=$t$nl
  done
  # A graphql call is a write only for a mutation, so a query fully known to be
  # something else publishes nothing.
  if [ -z "$unsure" ] && [ "$group" = api ] && [ "$endpoint" = graphql ] && [ -n "$q_seen" ] &&
    [ -z "$q_unknown" ] && [ -z "$over" ] && ! [[ $pub$got =~ $re_mutation ]]; then
    return 0
  fi
  if hit=$(private_text "$pub$got"); then deny "$hit"; fi
  [ -z "$why" ] || unread_deny "$why"
  [ -z "$over" ] || note "a file over 1 MB feeds a gh write"
}
# run_cmd <command> <pipeline length>: runs what the walk follows: cd, gh, a command whose
# name is not literal, which may be gh, and writes to files. Any other command that may
# write the files it names marks them changed.
run_cmd() {
  local id=$1 n=$2 name
  # shellcheck disable=SC2086 # The list holds word numbers.
  set -- ${c_words[id]}
  while [ $# -gt 0 ]; do
    if [ -n "${w_assign[$1]}" ]; then shift; continue; fi
    case "${w_text[$1]}" in
      command | exec | nohup | time | builtin | export | '!' | '{' | '}' | if | then | elif | else | do | while | until | fi | done | 'esac') shift ;;
      env) shift; while [ $# -gt 0 ] && [ "${w_text[$1]:0:1}" = - ]; do shift; done ;;
      *) break ;;
    esac
  done
  if [ $# -eq 0 ]; then
    :
  elif [ -n "${w_ok[$1]}" ]; then
    name=${w_path[$1]}; name=${name##*/}; shift
    case "$name" in
      cd) [ "$n" -ne 1 ] || change_dir "$@" ;;
      gh) gh_write "" "$@" ;;
      *) ! writes "$name" "$@" || touched "$@" ;;
    esac
  else
    shift; gh_write 1 "$@"; touched "$@"
  fi
  # shellcheck disable=SC2086 # The list holds word numbers.
  touched ${c_outs[id]}
}

parse_list ""
printf '%s' "$notes" >&2
exit 0

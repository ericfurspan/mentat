#!/usr/bin/env bash
# mentat-review-outside: `mentat review --outside`, which bin/mentat hands over with the
# arguments after --outside. Usage and exit codes are bin/mentat's.
set -uo pipefail

module=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 1
# shellcheck disable=SC2034 # read by lib/load.sh
entry=mentat-review-outside via="mentat review --outside" core_libs="shared publish review status" module_libs="adapter outside"
# shellcheck source=/dev/null
. "$module/lib/load.sh" || exit 1

outside_review "$@"

#!/usr/bin/env bash
# mentat-review-codex: `mentat review --codex`, which bin/mentat hands over with the
# arguments after --codex. Core's review_local runs it with the Codex reviewer
# functions in lib/codex.sh. Usage and exit codes are bin/mentat's.
set -uo pipefail

module=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 1
# shellcheck disable=SC2034 # read by lib/load.sh
entry=mentat-review-codex via="mentat review --codex" core_libs="shared publish review" module_libs=codex
# shellcheck source=/dev/null
. "$module/lib/load.sh" || exit 1

review_args "" "$@"
# shellcheck disable=SC2154 # pr is set by review_args
case "$pr" in '' | *[!0-9]*) die "usage: mentat review [--local | --codex | --grok [--stop]] [--request <file>] [--require-ci] <pull request number>" 64 ;; esac
reviewers_gate
review_local codex "$pr"
